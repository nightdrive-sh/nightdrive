#!/bin/bash
# The nightdrive command (linked to ~/.local/bin by link.sh). `nightdrive help` lists the subcommands: usage() below.
# A new subcommand goes in the case at the bottom and in usage().
set -uo pipefail
repo=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
scripts="$repo/config/hypr/scripts"
cache="$HOME/.cache/nightdrive"
external="$HOME/.local/share/nightdrive/plugins"     # plugins from elsewhere (plugins add), one folder each
off="$HOME/.local/state/nightdrive/plugins-off"      # an empty file per plugin that is off (plugins off)
offered="$HOME/.local/state/nightdrive/apps-offered"  # Nightdrive's apps this install has had once, one id a line (offer_apps)

# The help: grouped, one short line per command. Colour only on a terminal (and not with NO_COLOR).
usage() {
  local b="" v="" r=""
  if [[ -t 1 && -z ${NO_COLOR:-} ]]; then b=$'\e[1m' v=$'\e[38;2;192;113;235m' r=$'\e[0m'; fi
  section() { printf '\n%s%s%s\n' "$b" "$1" "$r"; }
  row() { printf '  %s%-28s%s %s\n' "$v" "$1" "$r" "$2"; }
  printf '%sNightdrive%s\n' "$b" "$r"
  printf '\nUsage: nightdrive COMMAND [ARGS]\n'
  section "Update"
  row "update"                   "Update Nightdrive, its packages and apps, then reload the desktop"
  row "update check"             "Look for new changes (runs every 6 h and notifies)"
  row "channel [stable|dev]"     "Which branch updates follow: stable (main) or dev, the bigger changes first"
  row "version"                  "The release this desktop is at, and its channel"
  row "minimal [--dry-run]"      "An install on Fedora KDE to Fedora Minimal: KDE goes, your own apps stay"
  section "Desktop"
  row "theme COMMAND"            "The theme colour, e.g. nightdrive theme color teal"
  row "wallpaper COMMAND"        "The background: list, set, add, remove"
  row "display COMMAND"          "Screen scale: list, scale OUTPUT SCALE"
  row "bar-style COMMAND"        "The top bar's look: opacity, icons, highlight, icon-opacity"
  row "topbar adjust"            "The top bar's icon and text sizes, live"
  row "topbar date [STYLE]"      "The clock's date order: auto, dmy, mdy or iso"
  row "snippets [COMMAND]"       "Text snippets: list, set, remove, status, enable, disable"
  row "defaults [set KIND APP]"  "Default apps (browser, email, files…), e.g. nightdrive defaults set pdf org.gnome.Papers"
  row "terminal [-- COMMAND]"    "Open the terminal chosen in Default apps (--dir DIR, --class CLASS, --hold)"
  row "ask \"MESSAGE\""            "Claude Code in a new terminal, MESSAGE as its first prompt (--dir DIR, --name NAME, --effort LEVEL, --background, --workspace WS)"
  row "welcome"                  "Welcome to Nightdrive: set up Tailscale, Mail, Deck… with Claude or by hand"
  section "Apps"
  row "apps [list]"              "Nightdrive's own apps (Mail, Contacts, Deck, Garage), and which are installed"
  row "apps install NAME"        "Install one, or again after removing it, e.g. nightdrive apps install garage"
  row "apps off|on NAME"         "Hide an installed one from the desktop and stop its services, or bring it back"
  section "Plugins"
  row "plugins [list]"           "Optional parts, and which are installed, on or off"
  row "plugins install NAME"     "Install one, e.g. nightdrive plugins install home-assistant"
  row "plugins off|on NAME"      "Hide an installed one from the desktop and stop its services, or bring it back"
  row "plugins add GIT-URL [ID]" "Add one from elsewhere (an external plugin; install it afterwards)"
  row "plugins remove NAME"      "Turn an external one off and delete its folder"
  row "plugins installed"        "The installed ones' ids (those that are on)"
  row "plugins packages"         "The packages the installed ones need (plugin.conf's packages=)"
  row "plugins bump [NAME…]"     "Before a release: raise the version of every plugin that changed since its last (--dry-run lists)"
  row "plugin check [NAME]"       "Check plugins against the rules (plugins/README.md): file:line findings, exit 1"
  section "Preview"
  row "preview login"            "The login screen, without locking (Esc closes)"
  section "For developers"
  row "platform [WHAT]"          "What this runs on: arch, name, machine, gpu, keyboard, pagesize"
  row "sandbox COMMAND"          "Nightdrive in a headless container: up, check, shot, ipc, vnc, down"
  row "software-catalog"         "Rebuild Install › Software's lists from Flathub"
  row "agent-warn [\"WHAT\"]"    "For coding agents: warn before the launcher or a menu opens"
  row "release [patch|minor|major]" "Maintainers: release dev into stable, with notes (--dry-run shows what it would do)"
  printf '\n'
}

# Repos to update: Nightdrive, the repos the git-ignored local slots link into (a private overlay), external plugins,
# Deck's source
repos() {
  echo "$repo"
  local f
  for f in "$repo"/config/hypr/local.d/* "$repo"/config/hypr/*.local* "$repo"/config/quickshell/local \
           "$repo"/config/topbar/local.* "$repo"/config/topbar/status.local; do
    [[ -L $f ]] && git -C "$(dirname "$(readlink -f "$f")")" rev-parse --show-toplevel 2>/dev/null
  done | sort -u
  for f in "$external"/*/; do [[ -e $f.git ]] && echo "${f%/}"; done   # external plugins (plugins add)
  [[ -d ${DECK_SRC:-$HOME/.local/src/deck}/.git ]] && readlink -f "${DECK_SRC:-$HOME/.local/src/deck}"
}
# What a repo updates to: Nightdrive follows its channel's branch on origin (channel below), the others their upstream
upstream() {
  local b
  b=$(git -C "$1" branch --show-current 2>/dev/null)
  if [[ $1 == "$repo" && $b =~ ^(main|dev)$ ]] && git -C "$1" rev-parse -q --verify "refs/remotes/origin/$b" >/dev/null; then
    echo "origin/$b"
  else
    echo "@{upstream}"
  fi
}
behind() { git -C "$1" rev-list --count "HEAD..$(upstream "$1")" 2>/dev/null || echo 0; }
# The same for the Nightdrive repo, leaving out the commits whose every path is in the folder of a plugin that isn't on
# here (plugins/<id>/ of one that isn't installed, or is off): nothing in them reaches this desktop. A merge counts by its
# own changes (against its first parent); the merged commits count one by one.
behind_nightdrive() {
  local on
  [[ -e $cache/plugins.d/active ]] || plugins_installed >/dev/null
  on=$(cut -f1 "$cache/plugins.d/active" 2>/dev/null | tr '\n' ' ')
  git -C "$repo" log --format=tformat:@ --name-only --diff-merges=first-parent "HEAD..$(upstream "$repo")" 2>/dev/null | awk -v on=" $on" '
    function count() { if (started && (keep || !paths)) n++ }
    $0 == "@" { count(); started = 1; keep = 0; paths = 0; next }
    NF { paths++; if (!match($0, /^plugins\/[^\/]+\//) || index(on, " " substr($0, 9, RLENGTH - 9) " ")) keep = 1 }
    END { count(); print n + 0 }'
}

# whats_new COMMIT: the sections of CHANGELOG.md that weren't there at COMMIT (the releases since), newest first
whats_new() {
  SEEN=$(git -C "$repo" show "$1:CHANGELOG.md" 2>/dev/null | grep '^## ' || true) awk '
    BEGIN { n = split(ENVIRON["SEEN"], s, "\n"); for (i = 1; i <= n; i++) old[s[i]] = 1 }
    /^## / { on = !($0 in old) } on' "$repo/CHANGELOG.md"
}

# version: the release this checkout is at (its tag), how many changes past it, and the channel
version() {
  local d ch
  case $(git -C "$repo" branch --show-current) in main) ch=stable ;; dev) ch=dev ;; *) ch=custom ;; esac
  if ! d=$(git -C "$repo" describe --tags --long --match 'v[0-9]*.[0-9]*.[0-9]*' 2>/dev/null); then
    echo "Nightdrive, no release yet ($ch channel, $(git -C "$repo" rev-parse --short HEAD))"; return
  fi
  local tag=${d%-*-g*} rest=${d%-g*}; local n=${rest##*-}
  if (( n == 0 )); then echo "Nightdrive ${tag#v} ($ch channel)"
  else echo "Nightdrive ${tag#v}, and $n change$( (( n == 1 )) || echo s) since ($ch channel, ${d##*-g})"; fi
}

# The update channel is the branch the Nightdrive checkout is on: main is stable, dev gets the bigger changes before they
# are merged into main (AGENTS.md › Branches). No setting of its own, so the two can't disagree. --update (the launcher's
# Update channel) runs the update after the switch without asking.
channel() {
  local cur want name ahead rc a upd=0
  [[ ${2:-} == --update ]] && upd=1
  cur=$(git -C "$repo" branch --show-current)
  if [[ -z ${1:-} ]]; then
    case $cur in
      main) echo "stable (branch main)" ;;
      dev) echo "dev (branch dev)" ;;
      *) echo "custom (${cur:+branch }${cur:-no branch})" ;;
    esac
    return
  fi
  case $1 in
    stable|main) want=main name=stable ;;
    dev|development) want=dev name=dev ;;
    *) echo "Unknown channel: $1 (stable or dev)" >&2; return 1 ;;
  esac
  [[ $cur == "$want" ]] && { echo "Already on the $name channel (branch $want)."; return 0; }
  # Asked from origin itself: a leftover origin/dev from before the branch was removed doesn't count
  git -C "$repo" ls-remote -q --exit-code --heads origin "$want" >/dev/null 2>&1; rc=$?
  if (( rc == 2 )); then
    echo "The $name channel's branch ($want) isn't on origin yet: nothing changed." >&2; return 1
  elif (( rc != 0 )); then
    echo "Couldn't reach origin: nothing changed." >&2; return 1
  fi
  # Never switched over the user's own work: uncommitted changes, or commits that aren't on origin (they'd stay behind
  # on the old branch, out of sight)
  if [[ -n $(git -C "$repo" status --porcelain --untracked-files=no) ]]; then
    echo "Nightdrive has uncommitted changes: nothing changed (commit or stash them, then run this again)." >&2; return 1
  fi
  ahead=$(git -C "$repo" rev-list --count HEAD --not --remotes=origin)
  if (( ahead > 0 )); then
    echo "${cur:-This checkout} has $ahead commit(s) that aren't on origin: nothing changed (push or move them first)." >&2; return 1
  fi
  git -C "$repo" fetch -q origin "$want" || { echo "Couldn't fetch $want: nothing changed." >&2; return 1; }
  # A local branch from an earlier switch can be behind origin: it is moved to origin's tip below, before its link.sh runs
  # (an old one would link the old files). One with commits of its own can't be moved without losing them: not switched.
  if git -C "$repo" rev-parse -q --verify "refs/heads/$want" >/dev/null; then
    ahead=$(git -C "$repo" rev-list --count "origin/$want..refs/heads/$want")
    if (( ahead > 0 )); then
      echo "The local $want branch has $ahead commit(s) that aren't on origin/$want: nothing changed. Push them, or keep" \
        "them on a branch of their own and move $want to origin's (git -C $repo branch my-$want $want &&" \
        "git -C $repo branch -f $want origin/$want), then run this again." >&2
      return 1
    fi
    git -C "$repo" switch -q "$want" && git -C "$repo" branch -q -u "origin/$want" "$want"
  else
    git -C "$repo" switch -q -c "$want" --track "origin/$want"
  fi || { echo "Couldn't switch to $want: nothing changed." >&2; return 1; }
  if ! git -C "$repo" merge -q --ff-only "origin/$want"; then
    echo "Switched to $want, but couldn't move it to origin/$want: the links weren't updated. Run" \
      "git -C $repo merge --ff-only origin/$want, then nightdrive update." >&2
    return 1
  fi
  echo "Now on the $name channel (branch $want)."
  # The new branch's links at once, not at the next update (which relinks first thing): the old ones can point at files
  # this branch moved or removed (a plugin's units, the Files extensions). Its own link.sh and update, as this function
  # is still the old branch's.
  if (( !upd )); then
    echo "==> Links"; "$repo/link.sh" | grep -v '^ok '
    (( PIPESTATUS[0] == 0 )) || echo "    failed: run $repo/link.sh to see why"
    if [[ -t 0 ]]; then
      read -rp "Run nightdrive update now? [Y/n] " a || a=n
      [[ $a =~ ^[Nn] ]] || upd=1
    fi
  fi
  (( upd )) && exec "$repo/bin/nightdrive" update
  echo "Run nightdrive update to finish: packages, apps, a desktop reload."
}

# update check: fetch only, count the new commits; notifies once per new count, and the notification's Update button runs
# the update in a terminal (nightdrive-update-check.timer, every 6 h)
check() {
  total=0
  while read -r r; do
    timeout 30 git -C "$r" fetch -q 2>/dev/null || continue
    if [[ $r == "$repo" ]]; then total=$(( total + $(behind_nightdrive) )); else total=$(( total + $(behind "$r") )); fi
  done < <(repos | sort -u)
  mkdir -p "$cache"
  echo "$total" > "$cache/updates"
  last=$(cat "$cache/updates-notified" 2>/dev/null || echo 0)
  if (( total > 0 && total != last )); then
    echo "$total" > "$cache/updates-notified"
    (( total == 1 )) && what="1 new change" || what="$total new changes"
    action=$(notify-send -a Nightdrive -h string:x-dunst-stack-tag:update -A update=Update "Nightdrive update" "$what waiting" 2>/dev/null)
    # systemd-run: its own unit, so the terminal outlives this oneshot service (whose processes systemd ends)
    [[ $action == update ]] && systemd-run --user --collect -q "$repo/config/hypr/scripts/terminal" --class floating-tui -- bash -c \
      '"$1" update; echo; read -rp "Done. Press Enter to close…"' _ "$repo/bin/nightdrive"
  fi
}

# update: pull Nightdrive (and a private overlay and Deck's source, if any), relink, install new packages, dnf upgrade,
# Flatpak apps, reload the desktop (launcher › Update runs this). Never pulls over local changes: a repo with uncommitted
# work or its own commits is skipped with a note. Whatever was skipped or failed is listed at the end with what to run
# by hand, and the exit status is then 1: "up to date" only when every step ran.
update() {
  local missed=() can_sudo=1
  # sudo asks for the password only on a terminal. Without one (an agent, ssh with a command) it would fail or wait, so
  # the steps that need it are skipped and listed, unless sudo works without asking (a cached password, NOPASSWD).
  [[ -t 0 ]] || sudo -n true 2>/dev/null || can_sudo=0
  deck=${ND_UPDATE_DECK:-0}
  # Where the update started: kept over the restart below, for What's new at the end
  local was=${ND_UPDATE_WAS:-}; [[ -n $was ]] || was=$(git -C "$repo" rev-parse HEAD)
  # Hyprland reloads on every save, and a pull replaces hyprland.lua by deleting and writing it: a reload in between
  # showed "config has errors" (cannot open hyprland.lua) until the end. Off for the update; the reload below turns it
  # back on (a failed update leaves it off until the next reload or login).
  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && hyprctl eval 'hl.config({ misc = { disable_autoreload = true } })' >/dev/null 2>&1
  while read -r r; do
    name=$(basename "$r")
    echo "==> $name"
    git -C "$r" fetch -q || { echo "    couldn't fetch, skipping"; missed+=("$name: couldn't fetch, not updated"); continue; }
    n=$(behind "$r")
    if (( n == 0 )); then echo "    up to date"; continue; fi
    if [[ -n $(git -C "$r" status --porcelain --untracked-files=no) ]]; then
      echo "    $n new, but it has uncommitted changes: skipped (commit or stash them, then run this again)"
      missed+=("$name: $n new, not pulled over uncommitted changes (commit or stash them in $r)"); continue
    fi
    u=$(upstream "$r")
    git -C "$r" --no-pager log --format='    %s' "HEAD..$u"
    git -C "$r" merge -q --ff-only "$u" || {
      echo "    has its own commits: skipped (rebase it by hand)"; missed+=("$name: has its own commits, not pulled: git -C $r pull --rebase"); continue
    }
    [[ $r == "$(readlink -f "${DECK_SRC:-$HOME/.local/src/deck}")" ]] && deck=1
  done < <(repos | sort -u)

  # This function was read before the pull: when the pull changed this command, the rest of the update goes on in the
  # new version, or its new steps would run only next time while the files they belong with are new already (the
  # Hyprland repo step and packages-hyprland.txt, 19.10.2026). Once only; whether Deck's source came in goes along.
  if [[ -z ${ND_UPDATE_AGAIN:-} ]] && ! git -C "$repo" diff --quiet "$was" HEAD -- bin/nightdrive; then
    echo "==> nightdrive itself was updated: going on with the new version"
    ND_UPDATE_AGAIN=1 ND_UPDATE_DECK=$deck ND_UPDATE_WAS=$was exec "$repo/bin/nightdrive" update
  fi

  # Relinked even when nothing new came in: after a `git pull` by hand the new links (this command among them) would
  # otherwise never appear. Nightdrive's link.sh first, then the overlay's, as on install.
  while read -r r; do
    [[ -x $r/link.sh ]] || continue
    echo "==> Links ($(basename "$r"))"; "$r/link.sh" | grep -v '^ok '
    (( PIPESTATUS[0] == 0 )) || missed+=("Links ($(basename "$r")): $r/link.sh")
  done < <(echo "$repo"; repos | sort -u | grep -vxF "$repo" | grep -vF "$external/")   # not an external plugin's own script

  # Fonts, ble.sh, GTK settings, default apps (the same steps as install.sh): what was added since this install
  echo "==> Fonts, ble.sh, GTK, default apps"
  "$repo/setup-user.sh" >/dev/null || { echo "    failed: run $repo/setup-user.sh to see why"; missed+=("Fonts, ble.sh, GTK: $repo/setup-user.sh"); }

  # Claude Code, as install.sh puts it in: an install from before that (19.10.2026) gets it here. Not when it's there
  # some other way (npm, a package); once in, its own installer keeps it up to date.
  if [[ ! -x $HOME/.local/bin/claude ]] && ! command -v claude >/dev/null; then
    echo "==> Claude Code"
    curl -fsSL https://claude.ai/install.sh | bash \
      && echo "    run claude once and log in (⌘⌥Enter and the top bar's usage menu use that sign-in)" \
      || missed+=("Claude Code: curl -fsSL https://claude.ai/install.sh | bash")
  fi

  # The Hyprland stack's COPR (setup-hyprland-repo.sh): set up again only when it isn't as the repo wants, e.g. still
  # arcaneon/arcos (until 19.10.2026). Before New packages and the System update, which then take the packages from it.
  if ! "$repo/setup-hyprland-repo.sh" --check; then
    echo "==> Hyprland repo"
    as_root "Hyprland repo" "$repo/setup-hyprland-repo.sh"
  fi

  echo "==> New packages"
  # With the machine's own list (packages-pc.txt, packages-asahi.txt), its groups (@hardware-support) left to install.sh.
  # --skip-unavailable: one this architecture lacks (microcode_ctl is x86 only)
  want=$(cat "$repo/packages.txt" "$repo/packages-hyprland.txt" "$repo/packages-$("$scripts/platform" machine).txt" 2>/dev/null \
    | grep -vE '^\s*(#|$|@)')
  missing=$(for p in $want; do rpm -q --whatprovides "$p" >/dev/null 2>&1 || echo "$p"; done)
  if [[ -n $missing ]]; then echo "    $(echo $missing)"; as_root "New packages" sudo dnf install -y --skip-unavailable $missing; else echo "    none"; fi
  # install.sh marks the list's packages as wanted, so removing KDE doesn't take them along. One added to it since may
  # be here as KDE's dependency (pipewire-utils, 25.10.2026): marked too. -C: the installed ones only, no metadata download
  # The installed plugins' packages likewise (plugin.conf's packages=, marked by plugins install since 25.10.2026)
  deps=$(dnf -q -C repoquery --installed --qf '%{name} %{reason}\n' $want $(plugin_packages) 2>/dev/null | awk '/Dependency$/ { print $1 }' | sort -u)
  [[ -z $deps ]] || as_root "New packages" sudo dnf mark user -y $deps >/dev/null
  # nwg-panel came with Hyprland (Fedora's package supplements it) until config/system/dnf-excludes.conf, put in place
  # under System files below. One installed on purpose stays.
  if [[ $(dnf -q -C repoquery --installed --setopt=disable_excludes='*' --qf '%{reason}' nwg-panel 2>/dev/null) == *Dependency ]]; then
    echo "    removing nwg-panel (came with Hyprland; the top bar is Nightdrive's own)"
    as_root "New packages" sudo dnf remove -y --setopt=disable_excludes='*' nwg-panel
  fi

  # doubletake (Screen Mirroring, plugins/mirroring): built again when the tested commit in its install.sh changes.
  # Not installed when missing: it was left out at install time (or not added in Install › Plugins).
  if [[ -x $HOME/.local/bin/doubletake ]]; then
    echo "==> doubletake (Screen Mirroring)"
    dt_want=$(sed -nE 's/^ref=\$\{DOUBLETAKE_REF:-([0-9a-f]+)\}.*/\1/p' "$repo/plugins/mirroring/install.sh")
    dt_have=$(git -C "$HOME/.local/src/doubletake" rev-parse HEAD 2>/dev/null || true)
    if [[ -z $dt_want || $dt_have != "$dt_want"* ]]; then as_root "doubletake" "$repo/plugins/mirroring/install.sh"; else echo "    up to date"; fi
  fi

  # The system files install.sh puts in place: copied again when the repo's version differs (or is missing), so an
  # install from before a file was added gets it too (e.g. the power key, 14.10.2026)
  echo "==> System files"
  changed=0 copied=0
  while read -r src dst mode; do
    cmp -s "$repo/config/system/$src" "$dst" && continue
    echo "    $dst"; copied=1
    as_root "System files" sudo install -Dm"$mode" "$repo/config/system/$src" "$dst" \
      && [[ $dst == /etc/systemd/logind.conf.d/* ]] && changed=1
  done <<'LIST'
nightdrive-sleep /usr/lib/systemd/system-sleep/nightdrive-sleep 755
logind-ignore-sleep-key.conf /etc/systemd/logind.conf.d/50-ignore-sleep-key.conf 644
logind-power-key.conf /etc/systemd/logind.conf.d/50-power-key.conf 644
nightdrive.actions /etc/dnf/libdnf5-plugins/actions.d/nightdrive.actions 644
dnf-excludes.conf /etc/dnf/libdnf5.conf.d/90-nightdrive.conf 644
LIST
  # Asahi Macs: macOS's partitions out of the file manager's sidebar (26.10.2026); udev picks them up at once
  rules=/etc/udev/rules.d/61-nightdrive-apple-partitions.rules
  if [[ $("$scripts/platform" machine) == asahi ]] && ! cmp -s "$repo/config/system/apple-partitions.rules" $rules; then
    echo "    $rules"; copied=1
    as_root "System files" sudo install -Dm644 "$repo/config/system/apple-partitions.rules" $rules \
      && as_root "System files" sudo udevadm control --reload \
      && as_root "System files" sudo udevadm trigger --subsystem-match=block --action=change
  fi
  # Mac Keyboard Shortcuts (plugins/keyd): its /etc config follows the repo's, if the plugin is installed
  if [[ -f /etc/keyd/default.conf ]] && ! cmp -s "$repo/plugins/keyd/default.conf" /etc/keyd/default.conf; then
    echo "    /etc/keyd/default.conf"; copied=1
    as_root "System files" sudo install -Dm644 "$repo/plugins/keyd/default.conf" /etc/keyd/default.conf \
      && as_root "System files" sudo keyd reload
  fi
  # The file the dnf hook touches; Quickshell watches it only if it exists when it starts (restarted below)
  [[ -e /var/lib/nightdrive/dnf-changed ]] || as_root "System files" sudo install -Dm644 /dev/null /var/lib/nightdrive/dnf-changed
  (( changed )) && as_root "System files" sudo systemctl kill -s HUP systemd-logind
  (( copied )) || echo "    up to date"

  # Remote login: SSH only over Tailscale and on the networks trusted, once (config/hypr/scripts/remote-login, 23.10.2026).
  # In the session firewalld lets a wheel user do it (on Fedora KDE without a password); over ssh it needs sudo (exit 2)
  echo "==> Remote login"
  "$scripts/remote-login" setup | sed 's/^/    /'
  case ${PIPESTATUS[0]} in 1) echo "    up to date" ;; 2) as_root "Remote login" sudo "$scripts/remote-login" setup ;; esac

  # The login screen's and the boot splash's copies in /etc/greetd and /usr/share/plymouth: installed again when the repo's
  # differ (their version file: the git tree they came from). An install from before both were the default (18.10.2026)
  # is asked once whether to turn them on.
  echo "==> Login screen and boot splash"
  local asked=$HOME/.local/state/nightdrive/boot-asked did=0 a
  if systemctl -q is-enabled greetd.service 2>/dev/null; then
    # Not asked with the text login (switch.sh text), chosen in place of the login screen
    if ! grep -q -e '^\[initial_session\]' -e '^# Text login (switch.sh text)' /etc/greetd/config.toml 2>/dev/null &&
       [[ ! -e $asked && -t 0 ]]; then
      echo "    New: the boot splash goes straight over to the login screen, with the desktop starting behind it as its lock"
      echo "    (no black flashes at boot). Turning it on rebuilds the initramfs, which takes a minute or two."
      read -rp "    Turn it on? [Y/n] " a
      mkdir -p "${asked%/*}"; echo "${a:-y}" > "$asked"
      if [[ ! $a =~ ^[Nn] ]]; then
        "$repo/config/splash/install.sh" | grep -v '^Done'
        (( PIPESTATUS[0] == 0 )) || missed+=("Boot splash: $repo/config/splash/install.sh")
        as_root "Login screen" "$repo/config/greeter/switch.sh" autologin >/dev/null
        did=1
      fi
    fi
    if [[ $(cat /etc/greetd/greeter/version 2>/dev/null) != "$(git -C "$repo/config/greeter" rev-parse HEAD:./ 2>/dev/null)" ]]; then
      echo "    login screen"; as_root "Login screen" "$repo/config/greeter/install.sh" >/dev/null && did=1
    fi
  fi
  if [[ $(plymouth-set-default-theme 2>/dev/null) == nightdrive ]] &&
     [[ $(cat /usr/share/plymouth/themes/nightdrive/version 2>/dev/null) != "$(git -C "$repo/config/splash" rev-parse HEAD:./ HEAD:../greeter/background.jpg 2>/dev/null)" ]]; then
    echo "    boot splash (rebuilds the initramfs, a minute or two)"; as_root "Boot splash" "$repo/config/splash/install.sh" >/dev/null && did=1
  fi
  (( did )) && echo "    takes effect from the next boot" || echo "    up to date"

  echo "==> System update"
  as_root "System update" sudo dnf upgrade --refresh -y

  echo "==> Flatpak apps"
  flatpaks=$(grep -vE '^\s*(#|$)' "$repo/flatpaks.txt" 2>/dev/null)   # the core ones; optional apps are plugins
  # Added by install.sh; an install from before Flatpak support (13.10.2026) doesn't have it yet
  flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  [[ -n $flatpaks ]] && { flatpak install --user -y --noninteractive flathub $flatpaks \
    || missed+=("Flatpak apps: flatpak install --user flathub $(echo $flatpaks)"); }   # already installed ones are skipped
  flatpak update --user -y --noninteractive || missed+=("Flatpak apps: flatpak update --user")

  offer_apps     # before the Deck rebuild: a Deck installed there was just built

  # Only while Deck is installed: its source stays when the app is removed, and a rebuild would bring it back
  # No DECK_SRC of its own: install.sh builds a DECK_SRC as one's own source, which would turn a packaged Deck into a build
  (( deck )) && [[ -x $HOME/.local/bin/deck ]] && { echo "==> Deck (rebuild)"; "$repo/plugins/deck/install.sh" \
    || missed+=("Deck (rebuild): $repo/plugins/deck/install.sh"); }

  # Ferry (plugins/ferry): its own app from its own repo, which the plugin installs, and Nightdrive's update brings its
  # latest release along. A Ferry from before (the plugin's own server, until 10.2026; its state is still in Nightdrive's
  # folder) is replaced by it here, with its phones and box: its old command and unit are gone from the plugin.
  if systemctl --user -q is-enabled ferry.service 2>/dev/null || [[ -d $HOME/.local/share/nightdrive/ferry ]]; then
    echo "==> Ferry"
    as_root "Ferry" "$repo/plugins/ferry/install.sh" --update
  fi

  plugins_installed >/dev/null     # the optional parts' list, before the reload reads it (hypr/bindings.lua)
  "$repo/config/fuzzel/sync-apps" >/dev/null 2>&1 || true   # the launcher's app list, as at the end of install.sh
  if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    echo "==> Reloading the desktop"
    hyprctl reload >/dev/null
    "$repo/config/hypr/scripts/theme" apply >/dev/null 2>&1
    # Restarted: Quickshell doesn't watch a file that was missing when it started (e.g. the top bar's files before
    # this update linked them), and new QML types need a fresh start. --any-display: qs kill otherwise only sees the
    # instances started with this shell's display variables, and over SSH it missed the bar and left two
    qs kill --any-display >/dev/null 2>&1; hyprctl dispatch 'hl.dsp.exec_cmd("qs")' >/dev/null
    # hypridle reads its config only at start: restarted through hypr/scripts/idle, which writes it from the current
    # template (before 14.10.2026 Hyprland ran plain hypridle, whose screensaver closed right away)
    pkill -x hypridle || true; hyprctl dispatch "hl.dsp.exec_cmd(\"$HOME/.config/hypr/scripts/idle start\")" >/dev/null
  fi
  # The old top bar (before Quickshell drew it, 13.10.2026), also when updating over SSH. Quickshell reloads its own files.
  pkill -x waybar || true

  mkdir -p "$cache"; echo 0 > "$cache/updates"; echo 0 > "$cache/updates-notified"
  # The notes of the releases this update brought in (CHANGELOG.md): last, where they're seen when the update ends
  if ! git -C "$repo" diff --quiet "$was" HEAD -- CHANGELOG.md 2>/dev/null; then
    # A picture in the notes (![…](docs/releases/…)) is for the website and GitHub: not shown in a terminal
    echo; echo "==> What's new"; whats_new "$was" | sed -E '/^!\[[^]]*\]\([^)]*\)$/d' | cat -s | sed 's/^/    /'
  fi
  echo
  if (( ${#missed[@]} )); then
    echo "Nightdrive is updated, but these steps were skipped or failed:"
    printf '  - %s\n' "${missed[@]}"
    (( can_sudo )) || echo "Run nightdrive update in a terminal (sudo asks for the password there), or the commands above."
    return 1
  fi
  echo "Nightdrive is up to date."
}

# Nightdrive's own apps (group app in plugin.conf: Mail, Deck, Contacts) come with every install. An install that has
# never had one (from before it was an app, or before it existed) gets it here, once: each is then marked in $offered
# (install.sh marks the ones it offered, left out or not), and one marked is never installed again, so an app the user
# removed stays away. One installed already (or off) is only marked. An install from before the list (23.10.2026) has no
# record of an app removed earlier: what the app leaves behind tells (Mail's settings after `nightmail disable`, Deck's
# source, Contacts' accounts after `contacts disable`), and it is marked without installing. Without sudo (can_sudo, update) it waits, unmarked, for a run in a terminal. A
# failed install is marked too, so a build that fails doesn't run again on every update: missed has the command.
# Only the repo's plugins: an external one can't install itself by naming the group. An app with bundled=no in its
# plugin.conf (Garage) isn't offered at all: it waits in Install › Recommended for the user to pick it.
offer_apps() {
  local a id name inst dir trace apps did=0
  mkdir -p "${offered%/*}"; touch "$offered"
  mapfile -t apps < <(plugins | awk -F'\t' '$8 == "app" && $11 == "repo" { print $1 "\t" $2 "\t" $7 "\t" $9 }')
  echo "==> Nightdrive apps"
  for a in "${apps[@]}"; do
    IFS=$'\t' read -r id name inst dir <<<"$a"
    grep -qxF "$id" "$offered" && continue
    [[ $(conf_value "$dir/plugin.conf" bundled) == no ]] && continue
    case $id in
      mail) trace=$HOME/.config/nightmail ;;
      deck) trace=${DECK_SRC:-$HOME/.local/src/deck} ;;
      contacts) trace=${XDG_CONFIG_HOME:-$HOME/.config}/contacts ;;   # its accounts, kept by contacts disable
      *) trace="" ;;
    esac
    if (( inst )) || [[ -n $trace && -e $trace ]]; then echo "$id" >> "$offered"; continue; fi
    if (( ! can_sudo )); then
      echo "    $name is new: skipped, its installer needs sudo and there's no terminal to ask for the password" >&2
      missed+=("$name (new): run nightdrive update in a terminal"); did=1; continue
    fi
    echo "    $name is new here: installing it once (removed later, an update won't bring it back)"; did=1
    NIGHTDRIVE_INSTALL=1 plugin_install "$id" || missed+=("$name: nightdrive plugins install $id")
    echo "$id" >> "$offered"
    [[ $id == deck ]] && deck=0
  done
  (( did )) || echo "    up to date"
}

# as_root WHAT CMD…: an update step that needs sudo (CMD is sudo itself, or a script that runs it). Skipped without a
# way to ask for the password (can_sudo, update); skipped or failed, it goes to update's list with the command.
as_root() {
  local what=$1; shift
  if (( ! can_sudo )); then
    echo "    skipped: needs sudo, and there's no terminal to ask for the password" >&2
    missed+=("$what: $*"); return 1
  fi
  "$@" && return
  echo "    failed: $*" >&2; missed+=("$what: $*"); return 1
}

# Plugins: the lines of plugins.txt, and plugin folders with a plugin.conf (the same fields as key=value; both formats
# are explained in plugins.txt): the repo's plugins/<id>/ and the external ones in ~/.local/share/nightdrive/plugins/<id>/.
# Ids are unique: a folder with an id already taken (by plugins.txt, the repo, or an earlier external one) is skipped.
# Sorted by plugin.conf's order (default 50; a plugins.txt line has 50), and within the same order folders first, then
# the lines: install.sh installs them in this order, so Home Assistant (order=90), which asks things, stays last.
# One line each, fields separated by \x1f (none may be empty for read's sake, so a missing folder is "-"): id, name,
# icon, description, default, installer, installed test, group, folder
plugin_rows() {
  local d id k v seen order
  seen=" $(grep -vE '^\s*(#|$)' "$repo/plugins.txt" | cut -d'|' -f1 | tr '\n' ' ')"
  {
    for d in "$repo"/plugins/*/ "$external"/*/; do
      d=${d%/}; id=${d##*/}
      [[ -f $d/plugin.conf && $seen != *" $id "* ]] || continue
      seen+="$id "
      local -A c=()
      while IFS='=' read -r k v; do [[ $k =~ ^[a-z]+$ ]] && c[$k]=$v; done < "$d/plugin.conf"
      order=${c[order]:-50}; [[ $order =~ ^[0-9]+$ ]] || order=50
      printf '%s\x1f' "$order" "$id" "${c[name]:-$id}" "${c[icon]:-puzzle}" "${c[description]:-}" "${c[default]:-off}" \
        "${c[install]:-true}" "${c[installed]:-false}" "${c[group]:-plugin}"
      printf '%s\n' "$d"
    done
    grep -vE '^\s*(#|$)' "$repo/plugins.txt" | awk -F'|' -v OFS=$'\x1f' '{ NF = 8; print 50, $0, "-" }'
  } | sort -s -t $'\x1f' -k1,1n | cut -d $'\x1f' -f2-
}
# One tab-separated line each: id, name, icon, description, default (on/off), installer, installed (1/0), group, folder
# (empty for a plugins.txt line), off (1/0: plugins off), source (repo, or external: plugins add). The tests run side by
# side, in the plugin's folder (the repo for plugins.txt): `flatpak info` takes a moment.
plugins() {
  local tmp rows id name icon desc def inst test group dir i=0
  tmp=$(mktemp -d)
  rows=$(plugin_rows)
  while IFS=$'\x1f' read -r id name icon desc def inst test group dir; do
    [[ $dir == - ]] && dir=$repo
    (cd "$dir" && bash -c "$test" >/dev/null 2>&1 && touch "$tmp/$i") &
    i=$((i + 1))
  done <<<"$rows"
  wait
  i=0
  while IFS=$'\x1f' read -r id name icon desc def inst test group dir; do
    [[ $dir == - ]] && dir=
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$name" "$icon" "$desc" "$def" "$inst" "$([[ -e $tmp/$i ]] && echo 1 || echo 0)" \
      "$group" "$dir" "$([[ -e $off/$id ]] && echo 1 || echo 0)" "$([[ $dir == "$external/"* ]] && echo external || echo repo)"
    i=$((i + 1))
  done <<<"$rows"
  rm -rf "$tmp"
}
# `nightdrive plugins` on a terminal: one line each with its state (the launcher and scripts get the fields above).
# With a group (app), only that group's.
plugins_table() {
  plugins | awk -F'\t' -v g="${1:-}" 'g != "" && $8 != g { next } { st = $7 == 1 ? ($10 == 1 ? "off" : "on") : ($10 == 1 ? "not installed, off" : "not installed")
                          v = ""; if ($9 != "") { f = $9 "/plugin.conf"                # a folder: its version
                            while ((getline line < f) > 0) if (line ~ /^version=/) v = substr(line, 9); close(f) }
                          l = sprintf("%-18s %-26s %-8s %-14s %s", $1, $2, v, st, $11 == "external" ? "external: " $9 : ""); sub(/ +$/, "", l); print l }'
}
# The installed ones that are on: their ids, also to ~/.cache/nightdrive/plugins (Plugins.qml watches it,
# hypr/bindings.lua reads it). One that is off (plugins off) is left out, so the desktop treats it as not installed.
# When the list changes, Hyprland reloads: the keybindings of an added or removed part. The plugin folders' parts (bar
# module, menus, keys, shortcut lines) are gathered in ~/.cache/nightdrive/plugins.d (hypr/scripts/plugin-parts).
plugins_installed() {
  local list ids old
  list=$(plugins | awk -F'\t' '$7 == 1 && $10 == 0')
  ids=$(cut -f1 <<<"$list")
  awk -F'\t' '$9 != "" { print $1 "\t" $9 }' <<<"$list" | "$scripts/plugin-parts"
  mkdir -p "$cache"
  old=$(cat "$cache/plugins" 2>/dev/null) || old=__none__
  if [[ $ids != "$old" ]]; then
    printf '%s\n' "$ids" > "$cache/plugins.tmp" && mv "$cache/plugins.tmp" "$cache/plugins"
    [[ $old != __none__ && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && hyprctl reload >/dev/null 2>&1
  fi
  printf '%s\n' "$ids" | sed '/^$/d'
}
# `nightdrive apps`: plugins' commands for Nightdrive's own apps (group=app) only; plugins will take others' too
app_only() {
  plugin_rows | awk -F'\x1f' -v n="${1,,}" 'n != "" && (tolower($1) == n || tolower($2) == n) && $8 == "app" { f = 1 } END { exit !f }' ||
    { echo "Unknown app: ${1:-} (see: nightdrive apps)" >&2; exit 1; }
}
# Runs a plugin's installer (by id or name) in its folder (the repo for plugins.txt), then refreshes the list. One that
# is off is turned on first: installing it again means it's wanted (and its unit could not start while off).
plugin_install() {
  local id name inst dir rc pk
  IFS=$'\t' read -r id name inst dir < <(plugins | awk -F'\t' -v n="$1" 'tolower($1) == tolower(n) || tolower($2) == tolower(n) { print $1 "\t" $2 "\t" $6 "\t" ($9 == "" ? "-" : $9); exit }')
  [[ -n ${id:-} ]] || { echo "Unknown plugin: ${1:-} (see: nightdrive plugins)" >&2; exit 1; }
  [[ $dir == - ]] && dir=$repo
  [[ -e $off/$id ]] && plugin_switch on "$id" >/dev/null
  echo "==> $name"
  case $inst in
    "flatpak "*)
      flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
      flatpak install --user -y --noninteractive flathub ${inst#flatpak } && { "$repo/config/fuzzel/sync-apps" >/dev/null 2>&1 || true; } ;;
    "webapp "*)
      "$scripts/webapp-add" "$name" "${inst#webapp }" && { "$repo/config/fuzzel/sync-apps" >/dev/null 2>&1 || true; } ;;
    *)
      [[ -f $dir/${inst%% *} && ${inst%% *} != */* ]] && inst="./$inst"      # a plugin folder's script (install.sh)
      (cd "$dir" && bash -c "$inst") ;;
  esac
  rc=$?
  # Its packages= as wanted: one KDE (or another plugin) had already pulled in stays a dependency otherwise, and removing
  # KDE (nightdrive minimal) would take it along
  if (( rc == 0 )) && [[ $dir != "$repo" ]]; then
    pk=$(installed_names $(conf_value "$dir/plugin.conf" packages))
    [[ -z $pk ]] || sudo dnf mark user -y $pk >/dev/null || true
  fi
  plugins_installed >/dev/null
  qs ipc call bar refresh >/dev/null 2>&1 || true
  return $rc
}

# A plugin.conf's value (conf_value FILE KEY), empty when it has none
conf_value() { sed -n "s/^$2=//p" "$1" 2>/dev/null | tail -1; }
# The names of these packages that are installed
installed_names() { (( $# )) && rpm -q --qf '%{NAME}\n' "$@" 2>/dev/null | grep -v ' ' | sort -u | tr '\n' ' ' || true; }
# The installed plugins' packages (plugin.conf's packages=), one a line: also those that are off, which stay installed
plugin_packages() {
  local dir
  plugins | awk -F'\t' '$7 == 1 && $9 != "" { print $9 }' | while read -r dir; do
    conf_value "$dir/plugin.conf" packages | tr ' ' '\n'
  done | sed '/^$/d' | sort -u
}

# A plugin by id or name (any case): its id, name and folder ("-" for a plugins.txt line), tab-separated; nothing if unknown
plugin_find() {
  plugin_rows | awk -F'\x1f' -v n="$1" 'n != "" && (tolower($1) == tolower(n) || tolower($2) == tolower(n)) { print $1 "\t" $2 "\t" $9; exit }'
}
# A plugin folder's user units, by name: its systemd/ ones, and those its installer set up elsewhere (plugin.conf's units=,
# Ferry's ferry.service)
plugin_units() {
  local f
  for f in "$1"/systemd/*; do [[ -f $f ]] && echo "${f##*/}"; done
  sed -n 's/^units=//p' "$1/plugin.conf" 2>/dev/null | tr ' ' '\n' | sed '/^$/d'
}

# plugins off|on NAME. Off: the desktop treats it as not installed (no bar module, menu, launcher rows, keys or shortcut
# lines: plugins_installed leaves it out) and its folder's units are stopped. They stay enabled, so its installed test
# (often `is-enabled`) still holds; a drop-in keeps them from starting at login while it's off. On: the drop-in goes and
# the units that ran when it was turned off (listed in its file in $off) or are enabled start again. A plugins.txt line
# has no units of its own here: only its rows and keys go. Needs nothing from the desktop, so it works from a terminal
# when the bar is stuck.
plugin_switch() {
  local id name dir u units=() was=() stopped=""
  IFS=$'\t' read -r id name dir < <(plugin_find "${2:-}")
  [[ -n ${id:-} ]] || { echo "Unknown plugin: ${2:-} (see: nightdrive plugins)" >&2; return 1; }
  [[ $dir == - ]] || mapfile -t units < <(plugin_units "$dir")
  if [[ $1 == off ]]; then
    [[ -e $off/$id ]] && { echo "$name is already off."; return 0; }
    for u in "${units[@]}"; do systemctl --user -q is-active "$u" 2>/dev/null && was+=("$u"); done
    mkdir -p "$off" && printf '%s\n' "${was[@]}" | sed '/^$/d' > "$off/$id"
    for u in "${units[@]}"; do
      mkdir -p "$HOME/.config/systemd/user/$u.d"
      printf '%s\n' "# nightdrive plugins off $id: not started while the plugin is off (nightdrive plugins on $id removes this)" \
        "[Unit]" "ConditionPathExists=!%h/.local/state/nightdrive/plugins-off/$id" > "$HOME/.config/systemd/user/$u.d/nightdrive-off.conf"
    done
    if (( ${#units[@]} )); then
      systemctl --user daemon-reload 2>/dev/null
      if systemctl --user stop "${units[@]}" 2>/dev/null; then stopped=", ${units[*]} stopped"
      else stopped=" (couldn't stop ${units[*]}: no user systemd?)"; fi
    fi
  else
    [[ -e $off/$id ]] || { echo "$name is already on."; return 0; }
    mapfile -t was < "$off/$id"
    rm -f "$off/$id"
    for u in "${units[@]}"; do
      rm -f "$HOME/.config/systemd/user/$u.d/nightdrive-off.conf"; rmdir "$HOME/.config/systemd/user/$u.d" 2>/dev/null
    done
    if (( ${#units[@]} )); then
      systemctl --user daemon-reload 2>/dev/null
      for u in "${units[@]}"; do
        [[ " ${was[*]} " == *" $u "* || $(systemctl --user is-enabled "$u" 2>/dev/null) == enabled ]] && systemctl --user start "$u" 2>/dev/null
      done
    fi
  fi
  plugins_installed >/dev/null
  qs ipc call bar refresh >/dev/null 2>&1 || true
  if [[ $1 == off ]]; then
    echo "$name is off: hidden from the desktop$stopped. Still installed: nightdrive plugins on $id brings it back."
  else
    echo "$name is on again."
  fi
}

# Links a plugin folder's commands (bin/) and user units (systemd/) as link.sh does. A name that something else already
# has is left alone, with a note.
plugin_link() {
  local f dst
  for f in "$1"/bin/* "$1"/systemd/*; do
    [[ -f $f ]] || continue
    if [[ ${f%/*} == "$1/bin" ]]; then dst=$HOME/.local/bin/${f##*/}; else dst=$HOME/.config/systemd/user/${f##*/}; fi
    if [[ -e $dst || -L $dst ]] && [[ $(readlink -f "$dst") != "$(readlink -f "$f")" ]]; then
      echo "    $dst is already there: not linked" >&2; continue
    fi
    mkdir -p "${dst%/*}" && ln -sfn "$f" "$dst"
  done
  systemctl --user daemon-reload 2>/dev/null || true
}

# plugins add GIT-URL [ID]: clones an external plugin, a repo whose top is a plugin folder (plugin.conf at its root), into
# $external/<id>. The id is the repo's name without .git and a nightdrive-plugin- prefix, unless given. One that the
# repo's plugins or plugins.txt (or another external one) already have is refused: an external plugin can't replace them.
# Not installed here: its installer may ask things, so it runs from the launcher or `plugins install`.
plugin_add() {
  local url=${1:-} id=${2:-} tmp taken name
  [[ -n $url ]] || { echo "Usage: nightdrive plugins add GIT-URL [ID]" >&2; return 1; }
  if [[ -z $id ]]; then id=${url%/}; id=${id##*/}; id=${id##*:}; id=${id%.git}; id=${id#nightdrive-plugin-}; id=${id,,}; fi
  [[ $id =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "Not a usable id: $id (letters, digits, - and _; give one: nightdrive plugins add URL ID)" >&2; return 1; }
  IFS=$'\t' read -r taken name _ < <(plugin_rows | awk -F'\x1f' -v n="$id" '$1 == n { print $1 "\t" $2 "\t" $9; exit }')
  if [[ -n ${taken:-} ]]; then
    echo "The id $id is taken (by $name): give this one another id, nightdrive plugins add URL OTHER-ID" >&2; return 1
  fi
  [[ -e $external/$id ]] && { echo "$external/$id is already there (but has no plugin.conf): move it away first" >&2; return 1; }
  mkdir -p "$external"
  tmp=$(mktemp -d "$external/.add-XXXXXX")      # a dot folder: not read as a plugin while it's cloning
  if ! git clone -q "$url" "$tmp/$id"; then rm -rf "$tmp"; echo "Couldn't clone $url" >&2; return 1; fi
  if [[ ! -f $tmp/$id/plugin.conf ]]; then
    rm -rf "$tmp"; echo "$url has no plugin.conf at its top: not a Nightdrive plugin" >&2; return 1
  fi
  mv "$tmp/$id" "$external/$id" && rmdir "$tmp"
  plugin_link "$external/$id"
  plugins_installed >/dev/null
  qs ipc call bar refresh >/dev/null 2>&1 || true
  name=$(sed -n 's/^name=//p' "$external/$id/plugin.conf" | head -1)
  echo "Added ${name:-$id} ($id) in $external/$id."
  echo "Its code runs as you, like Nightdrive's own: add only plugins whose source you trust."
  echo "Install it: nightdrive plugins install $id (or launcher › Install). nightdrive update keeps it up to date."
}

# plugins remove NAME: an external plugin only (the repo's own are turned off instead). Turned off, its units disabled
# and its links removed, then the folder deleted. A folder with work of its own (uncommitted changes, commits that
# aren't pushed, or no git at all) needs --force. What its installer put elsewhere (packages, settings) stays.
plugin_remove() {
  local force=0 id name dir u l
  [[ ${1:-} == --force ]] && { force=1; shift; }
  [[ ${2:-} == --force ]] && force=1
  IFS=$'\t' read -r id name dir < <(plugin_find "${1:-}")
  [[ -n ${id:-} ]] || { echo "Unknown plugin: ${1:-} (see: nightdrive plugins)" >&2; return 1; }
  if [[ $dir != "$external/$id" ]]; then
    echo "$name comes with Nightdrive and can't be removed: nightdrive plugins off $id hides it." >&2; return 1
  fi
  if (( !force )); then
    if [[ ! -e $dir/.git ]]; then
      echo "$dir isn't a git clone, so it may be the only copy: nothing removed (--force removes it anyway)" >&2; return 1
    fi
    if [[ -n $(git -C "$dir" status --porcelain 2>/dev/null) || $(git -C "$dir" rev-list --count HEAD --not --remotes 2>/dev/null) != 0 ]]; then
      echo "$dir has changes or commits of its own: nothing removed (--force removes it anyway)" >&2; return 1
    fi
  fi
  plugin_switch off "$id" >/dev/null
  for u in $(plugin_units "$dir"); do
    systemctl --user disable "$u" >/dev/null 2>&1
    rm -f "$HOME/.config/systemd/user/$u.d/nightdrive-off.conf"; rmdir "$HOME/.config/systemd/user/$u.d" 2>/dev/null
  done
  for l in "$HOME"/.local/bin/* "$HOME"/.config/systemd/user/* "$HOME"/.config/systemd/user/*.wants/*; do
    [[ -L $l && $(readlink "$l") == "$dir/"* ]] && rm -f "$l"
  done
  rm -rf "${dir:?}" && rm -f "$off/$id"
  systemctl --user daemon-reload 2>/dev/null
  plugins_installed >/dev/null
  qs ipc call bar refresh >/dev/null 2>&1 || true
  echo "Removed $name ($dir). What its installer set up elsewhere (packages, settings) stays."
}

case ${1:-} in
  update) if [[ ${2:-} == check ]]; then check; else update; fi ;;
  channel) channel "${2:-}" "${3:-}" ;;
  version|--version) version ;;
  release) exec "$scripts/release" "${@:2}" ;;                          # AGENTS.md › Branches
  topbar) case ${2:-} in
            adjust) exec "$repo/config/topbar/scripts/adjust" "${@:3}" ;;
            date) exec "$repo/config/topbar/scripts/clock" style "${@:3}" ;;
            *) usage >&2; exit 1 ;;
          esac ;;
  plugins) case ${2:-list} in
             list) if [[ -t 1 ]]; then plugins_table; else plugins; fi ;;
             installed) plugins_installed ;;
             packages) plugin_packages ;;
             install) plugin_install "${3:-}" ;;
             off|on) plugin_switch "$2" "${3:-}" ;;
             add) plugin_add "${3:-}" "${4:-}" ;;
             remove) plugin_remove "${@:3}" ;;
             bump) exec "$scripts/plugin-version" bump "${@:3}" ;;      # plugins/README.md › Versions
             *) usage >&2; exit 1 ;;
           esac ;;
  apps) case ${2:-list} in
          list) if [[ -t 1 ]]; then plugins_table app; else plugins | awk -F'\t' '$8 == "app"'; fi ;;
          install) app_only "${3:-}"; plugin_install "$3" ;;
          off|on) app_only "${3:-}"; plugin_switch "$2" "$3" ;;
          *) usage >&2; exit 1 ;;
        esac ;;
  plugin) case ${2:-} in
            check) exec "$scripts/plugin-check" "${@:3}" ;;             # all of them without a name
            *) usage >&2; exit 1 ;;
          esac ;;
  # The login screen (config/greeter/lock.qml) without locking: it checks the password, then just closes
  preview) case ${2:-} in
             login) NIGHTDRIVE_LOCK_PREVIEW=1 exec qs -p "$repo/config/greeter/lock.qml" >/dev/null 2>&1 ;;
             *) usage >&2; exit 1 ;;
           esac ;;
  agent-warn) exec "$scripts/agent-warn" "${@:2}" ;;                  # AGENTS.md
  sandbox) exec "$repo/config/sandbox/sandbox" "${@:2}" ;;             # docs/sandbox.md
  minimal) exec "$repo/config/minimal/minimal" "${@:2}" ;;             # README › Install (Installed on Fedora KDE?)
  # topbar adjust: config/topbar/adjust.conf; software-catalog: config/quickshell/data/software.json
  platform|software-catalog|snippets) exec "$scripts/$1" "${@:2}" ;;
  theme|display|wallpaper|bar-style) exec "$scripts/$1" "${@:2}" ;;    # the desktop's own scripts (hypr/scripts)
  defaults) exec "$scripts/default-apps" "${@:2}" ;;                   # launcher › Settings › Apps › Default apps
  terminal) exec "$scripts/terminal" "${@:2}" ;;                       # the terminal chosen there
  ask) [[ -n ${2:-} ]] || { usage >&2; exit 1; }
       exec "$scripts/terminal-or-claude" "${@:2}" ;;                   # what the launcher's ⌘⌥Enter runs
  welcome) exec "$repo/config/welcome/welcome" "${@:2}" ;;             # Welcome to Nightdrive (launcher › System › Set up Nightdrive)
  ""|help|-h|--help) usage ;;
  *) usage >&2; exit 1 ;;
esac
