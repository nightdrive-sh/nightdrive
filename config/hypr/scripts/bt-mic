#!/bin/bash
# Bluetooth headphones' microphone, picked by hand. Headphones stay in music mode (A2DP: no microphone) on their own
# (wireplumber.conf.d/51-bt-no-headset-autoswitch.conf); the Sound menus list them as a microphone anyway, and picking
# one switches it to headset mode (HFP: a microphone, plainer sound) and makes its microphone the default. Picking
# another microphone switches it back to music mode.
#   bt-mic list         connected headphones in music mode that have a headset mode: JSON [{card, name}]
#   bt-mic state        connected headphones that have a headset mode, and theirs: JSON [{card, name, mode}], mode =
#                       music or headset (the Headphones menu's Use for)
#   bt-mic use CARD     headset mode (the best codec: highest priority) and its microphone as the default
#   bt-mic release      every headphones in headset mode back to music mode (the best codec)
#   bt-mic watch        while headphones are in headset mode (started by use): music starting to play (MPRIS) while no
#                       app records offers music mode in a notification, once per switch
# The profile is set with save: false, so WirePlumber doesn't remember it: headphones connect in music mode again.
set -uo pipefail

# Seconds to wait for the headphones' microphone to appear after a switch, and the switches tried
MIC_WAIT=2
TRIES=3
# How often the watcher checks that the headphones are still in headset mode (s)
WATCH_POLL=5

devices() {
  pw-dump 2>/dev/null | jq -c '[ .[] | select(.type == "PipeWire:Interface:Device" and .info.props["device.api"] == "bluez5")
    | { id, card: .info.props["device.name"], name: (.info.props["device.description"] // .info.props["device.name"]),
        active: ([.info.params.Profile[]? | .name] | first // ""),
        profiles: [.info.params.EnumProfile[]? | select(.available != "no") | {index, name, priority}] } ]'
}
# best DEVICE_JSON PREFIX: the index of the highest-priority profile whose name starts with PREFIX
best() { jq -r --arg p "$2" '[.profiles[] | select(.name | startswith($p))] | max_by(.priority) | .index // empty' <<<"$1"; }
# pw-cli prints harmless errors about objects that went away during the switch
set_profile() { pw-cli set-param "$1" Profile "{ index: $2, save: false }" >/dev/null 2>&1; }

case ${1:-} in
  list)
    devices | jq -c 'map(select((.active | startswith("headset-head-unit")) | not)
                         | select(any(.profiles[]; .name | startswith("headset-head-unit"))) | {card, name})' ;;
  state)
    devices | jq -c 'map(select(any(.profiles[]; .name | startswith("headset-head-unit")))
                         | {card, name, mode: (if .active | startswith("headset-head-unit") then "headset" else "music" end)})' ;;
  use)
    card=${2:?usage: bt-mic use CARD}
    dev=$(devices | jq -c --arg c "$card" '.[] | select(.card == $c)')
    [[ -n $dev ]] || { echo "not connected: $card" >&2; exit 1; }
    idx=$(best "$dev" headset-head-unit)
    [[ -n $idx ]] || { echo "no headset mode: $card" >&2; exit 1; }
    devid=$(jq -r .id <<<"$dev")
    music=$(best "$dev" a2dp-sink)
    # The microphone apps see is WirePlumber's loopback of the headset's own source (an internal one, hidden from
    # apps), created once the profile is headset: bluez_input.<address with colons>, with the device's id
    # The headphones' sink is made anew too, and meanwhile the default output falls back to the speakers: it is set
    # back to them along with the microphone.
    # WirePlumber sometimes drops the loopback while the switch tears down a playing stream ("Object activation aborted:
    # proxy destroyed" in its log) and makes none: then back to music mode and switched again. If none of the tries
    # gives a microphone, the headphones stay in music mode and this fails.
    for try in $(seq $TRIES); do
      (( try > 1 )) && { set_profile "$devid" "$music"; sleep 1; }
      set_profile "$devid" "$idx"
      for _ in $(seq $((MIC_WAIT * 10))); do
        read -r src sink < <(pw-dump 2>/dev/null | jq -r --arg d "$devid" '[.[] | select(.type == "PipeWire:Interface:Node")
               | select((.info.props["device.id"] | tostring) == $d) | .info.props] as $n
               | [($n[] | select(.["media.class"] == "Audio/Source") | .["node.name"]) // "",
                  ($n[] | select(.["media.class"] == "Audio/Sink") | .["node.name"]) // ""] | @tsv')
        if [[ -n $src && -n $sink ]]; then
          sleep 0.3   # set too soon, the default is overridden by WirePlumber's own pick for the new nodes
          pactl set-default-sink "$sink"; pactl set-default-source "$src"
          setsid -f "$0" watch >/dev/null 2>&1 </dev/null
          exit 0
        fi
        sleep 0.1
      done
    done
    set_profile "$devid" "$music"
    echo "no microphone appeared: $card" >&2; exit 1 ;;
  release)
    devices | jq -c '.[] | select(.active | startswith("headset-head-unit"))' | while read -r dev; do
      idx=$(best "$dev" a2dp-sink)
      [[ -n $idx ]] && set_profile "$(jq -r .id <<<"$dev")" "$idx"
    done ;;
  watch)
    exec 9>"${XDG_RUNTIME_DIR:-/run/user/$UID}/bt-mic-watch.lock"
    flock -n 9 || exit 0
    headset() { devices | jq -r '[.[] | select(.active | startswith("headset-head-unit")) | .name] | first // empty'; }
    # Read from a process substitution, not a pipe: the loop runs in this shell, so ending it can stop playerctl, which
    # would otherwise keep a pipeline (and this watcher) alive until it next printed something
    exec 3< <(playerctl --all-players --follow status 2>/dev/null 9>&-)
    player=$!
    while true; do
      read -r -t "$WATCH_POLL" status <&3; rc=$?
      if (( rc > 128 )); then          # timed out
        [[ -n $(headset) ]] || break   # back in music mode (here, pavucontrol, a reconnect): nothing to watch
        continue
      fi
      (( rc == 0 )) || break           # playerctl ended
      # playerctl first prints each player's status as it is: music already playing when headset mode was picked
      # doesn't count, only music started afterwards
      (( SECONDS < 2 )) && continue
      [[ $status == Playing ]] || continue
      name=$(headset); [[ -n $name ]] || break
      # In a call the headset mode is wanted: music then isn't a reason to ask
      [[ $(~/.config/topbar/scripts/privacy | jq '.mic | length') == 0 ]] || continue
      # notify-send waits for the answer in the background (without the lock: 9>&-), and is given up once the
      # headphones leave headset mode some other way, so a notification left unanswered doesn't keep this running
      answer=${XDG_RUNTIME_DIR:-/run/user/$UID}/bt-mic-answer
      notify-send -a Sound -i lucide:headphones -A music="Switch to music mode" -w "$name: headset mode" \
        "Music sounds plainer in headset mode, which is for the microphone. Music mode sounds better; the microphone goes back to this computer's." \
        >"$answer" 9>&- &
      asked=$!
      while kill -0 "$asked" 2>/dev/null; do
        sleep "$WATCH_POLL"
        [[ -n $(headset) ]] || kill "$asked" 2>/dev/null
      done
      [[ $(cat "$answer" 2>/dev/null) == music ]] && "$0" release
      rm -f "$answer"
      break   # asked once: no more notifications until the next switch to headset mode
    done
    kill "$player" 2>/dev/null ;;
  *) echo "usage: bt-mic list | state | use CARD | release | watch" >&2; exit 2 ;;
esac
