#!/usr/bin/python3 -I
"""Quick reminders: a message on screen in N minutes (Dashboard #3118). `nightdrive remind …` runs it, the
launcher's Tools › Remind (quickshell/RemindLevels.qml) and Claude's tools (config/mcp/tools/remind.json) use it.

  remind WHEN [MESSAGE…] [--from WHEN] [--json]
                                       WHEN is minutes (15, 90m, 2h, 1h30m, up to a week) or a time of day (22:45,
                                       22.45: the next one, tomorrow's once today's has passed); @UNIX: that moment
                                       (the undo of Claude's cancel); or an event (events.py): wake (the first unlock
                                       after the computer next wakes), login, arrive PLACE, leave PLACE (a place of
                                       `nightdrive places`; one not seen in a week comes anyway, "Didn't arrive at
                                       work"). --from: not before then (05:00, 8h, 2026-11-23 05:00), with an event.
                                       --json: the reminder, as list gives each
  remind list [--json]                 the waiting ones, times soonest first, then events. --json: {reminders: [{id,
                                       when, label, at, at_unix, minutes_left, clock, place, from, state, message}]},
                                       when time|wake|login|arrive|leave, at and from ISO 8601, clock HH:MM; at, clock
                                       and minutes_left null for an event, state waiting or unlock (came under the lock)
  remind show ID --json                one of them, as list gives it
  remind cancel ID|all [--json]        takes one (or every one) away before it's due
  remind restore                       at login (hypr/autostart.lua): sets the timers again, tells the missed ones and
                                       login's (remind_events.py: also woke, unlocked, event, expire)
  remind event arrive|leave PLACE [--json]
                                       `places check` saw it: its reminders come, or wait for the unlock. --json:
                                       {event, place, told, unlock}: ids
  remind fire ID                       the timer's own call: the banner (quickshell/RemindToast.qml), with a sound;
                                       a notification instead where Quickshell can't show it

Each one is a transient systemd user timer (nightdrive-remind-ID.timer) on the wall clock, so a suspend doesn't push it
later: after waking, a due one comes at once. Such a timer goes with the user's systemd at logout (no lingering) and at
a reboot, so the reminders are kept in a state file too, and `restore` arms them again at the next login; one that came
due meanwhile is told then, as missed. A plain one-shot timer, not a task: it needs no Tasks app (Jari's call in #3118).
"""
import argparse, json, os, secrets, subprocess, sys, time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import timers  # noqa: E402  the timer base shared with schedule (timers.py)
import events  # noqa: E402  the event WHENs shared with schedule: wake, login, arrive PLACE, leave PLACE (events.py)
import remind_events as event_runs  # noqa: E402  restore, woke, unlocked, event, expire: what tells one but its timer

STATE = os.path.expanduser("~/.local/state/nightdrive/reminders.json")
UNIT = "nightdrive-remind-"         # + the id: the timer and its service
MAX_MINUTES = 7 * 24 * 60           # a week: longer is a calendar event's or a task's job
APP, ICON = "Remind", "lucide:alarm-clock"
DEFAULT_MESSAGE = "Reminder"
SELF = os.path.realpath(__file__)   # the timer runs this checkout's script (a worktree's or the sandbox's own)
clock_time, clock = timers.clock_time, timers.clock


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def when(text, now):
    return timers.when(text, now, MAX_MINUTES)


def parse_minutes(text):
    return timers.parse_minutes(text, MAX_MINUTES)


def state():
    # STATE read at each call: the tests point it elsewhere
    return timers.locked_rows(STATE, "reminders")


def armed(rid):
    return timers.armed(UNIT + rid)


def timed(r):
    """It has a timer: its time, or an arrival's or a leaving's week (events.deadline), after which it comes anyway."""
    return "on" not in r or events.deadline(r) is not None


def arm(r):
    if "on" in r:
        return timers.arm(UNIT + r["id"], events.deadline(r), "Nightdrive reminder: still waiting for " + label(r),
                          [SELF, "expire", r["id"]])
    return timers.arm(UNIT + r["id"], r["at"], "Nightdrive reminder: " + r["message"][:60], [SELF, "fire", r["id"]])


def disarm(rid):
    timers.disarm(UNIT + rid)


def screen_locked():
    return events.screen_locked()   # here by name: the tests patch remind.screen_locked


def label(r):
    """When it comes, short: 14:45, wake, login, arrive work."""
    return events.label(r) if "on" in r else clock(r["at"])


def order(r):
    return (1, events.EVENTS.index(r["on"]), r.get("place", "").casefold()) if "on" in r else (0, r["at"], "")


def banner(rid, message, note, tries=1):
    """The reminder as Quickshell's banner (quickshell/RemindToast.qml); False when it isn't there to show it. At login
    Quickshell may still be starting: restore gives it a few tries."""
    for i in range(tries):
        try:
            p = subprocess.run(["qs", "ipc", "call", "remind", "ring", rid, message, note],
                               capture_output=True, text=True, timeout=10)
            if p.stdout.strip() == "ok":
                return True
        except (OSError, subprocess.TimeoutExpired):
            pass
        if i + 1 < tries:
            time.sleep(2)
    return False


def tell(rid, message, note, tries=1):
    if not banner(rid, message, note, tries):
        notify(message, note)


def notify(summary, body=""):
    # Without the banner: pinned (Notifs.qml's x-nightdrive-pin), so it stays until dismissed and gets through Do Not
    # Disturb, as an alarm would
    subprocess.run(["notify-send", "-a", APP, "-i", ICON, "-h", "boolean:x-nightdrive-pin:true",
                    "-h", "string:x-dunst-stack-tag:remind", "--", summary, body], capture_output=True)


def public(r, now=None):
    now = time.time() if now is None else now
    out = {"id": r["id"], "when": r.get("on", "time"), "label": label(r), "at": None, "at_unix": None, "clock": None,
           "minutes_left": None, **events.public(r), "state": r.get("state", "waiting"), "message": r["message"]}
    if "on" not in r:
        out.update(at=timers.iso(r["at"]), at_unix=int(r["at"]), clock=clock(r["at"]),
                   minutes_left=timers.minutes_left(r["at"], now))
    return out


def said(r, now):
    """When, as the text output says it: at 14:45 (in 20 min), on arriving at work, not before 05:00 tomorrow."""
    if "on" in r:
        text = events.describe(r, now)
        return text[:1].lower() + text[1:] + (" (came under the lock)" if r.get("state") == "unlock" else "")
    return f"at {clock(r['at'])} (in {timers.minutes_left(r['at'], now)} min)"


def cmd_add(a):
    now = int(time.time())
    try:
        ev = events.parse(a.when)
        start = events.parse_from(a.from_, now) if getattr(a, "from_", None) else None
    except events.WhenError as e:
        die(str(e), 2)
    at = None if ev else when(a.when, now)
    if not ev and at is None:
        die("Minutes up to a week (15, 90m, 2h, 1h30m), a time of day (22:45), wake, login, arrive PLACE or "
            "leave PLACE; a moment (@UNIX) not past and within a week", 2)
    if start and not ev:
        die("--from goes with an event (arrive work --from 05:00): a time is its own already", 2)
    message = " ".join(a.message).strip() or DEFAULT_MESSAGE
    r = {"id": secrets.token_hex(4), **(events.row(ev, now, start) if ev else {"at": at}), "message": message}
    with state() as rows:
        if timed(r):
            ok, err = arm(r)
            if not ok:
                die("The timer didn't start: " + (err or "systemd-run failed"))
        rows.append(r)
    if a.json:
        print(json.dumps(public(r), ensure_ascii=False))
    else:
        text = said(r, now)
        print(f"{text[:1].upper() + text[1:]}: {message}  ({r['id']})")


def cmd_list(a):
    now = time.time()
    with state() as rows:
        rows.sort(key=order)
        out = [public(r, now) for r in rows]
        text = [f"{said(r, now)}  {r['message']}  ({r['id']})" for r in rows]
    if a.json:
        print(json.dumps({"reminders": out}, ensure_ascii=False))
    else:
        print("\n".join(text) or "No reminders waiting")


def cmd_show(a):
    with state() as rows:
        r = next((r for r in rows if r["id"] == a.id), None)
    if not r:
        die(f"No reminder {a.id}: it came already, or was cancelled (remind list)")
    print(json.dumps(public(r), ensure_ascii=False) if a.json else f"{said(r, time.time())}  {r['message']}")


def cmd_cancel(a):
    with state() as rows:
        gone = [r for r in rows if a.id in ("all", r["id"])]
        if not gone and a.id != "all":
            die(f"No reminder {a.id}: it came already, or was cancelled (remind list)")
        for r in gone:
            disarm(r["id"])
            rows.remove(r)
    if a.json:
        print(json.dumps({"cancelled": [public(r) for r in gone]}, ensure_ascii=False))
    else:
        print("\n".join(f"Cancelled: {r['message']}" for r in gone) or "No reminders waiting")


def cmd_fire(a):
    with state() as rows:
        r = next((r for r in rows if r["id"] == a.id), None)
        if r:
            rows.remove(r)
    if r:   # one cancelled meanwhile has no row: nothing to say
        tell(r["id"], r["message"], "")   # the message alone: it's due now, its time needs no saying


class Host:
    """This script as remind_events sees it: each name looked up when used, so a test's patch of remind.X counts."""
    def __getattr__(self, name):
        return globals()[name]


def cmd_restore(a):
    event_runs.restore(Host())


def cmd_woke(a):
    event_runs.woke(Host())


def cmd_unlocked(a):
    event_runs.unlocked(Host())


def cmd_expire(a):
    event_runs.expire(Host(), a.id)


def cmd_event(a):
    out = event_runs.event(Host(), a.kind, a.place)
    if a.json:
        print(json.dumps(out, ensure_ascii=False))
    elif out["told"] or out["unlock"]:
        print(f"Told {len(out['told'])}" + (f", {len(out['unlock'])} at the unlock" if out["unlock"] else ""))
    else:
        print(f"Nothing waits for {a.kind} {a.place}")


def main():
    p = argparse.ArgumentParser(prog="nightdrive remind", description=__doc__.split("\n\n")[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split("\n\n")[1])
    sub = p.add_subparsers(dest="cmd")
    add = sub.add_parser("add")
    add.add_argument("when")
    add.add_argument("message", nargs="*")
    add.add_argument("--from", dest="from_", metavar="WHEN")
    add.add_argument("--json", action="store_true")
    ls = sub.add_parser("list")
    ls.add_argument("--json", action="store_true")
    show = sub.add_parser("show")
    show.add_argument("id")
    show.add_argument("--json", action="store_true")
    cancel = sub.add_parser("cancel")
    cancel.add_argument("id")
    cancel.add_argument("--json", action="store_true")
    fire = sub.add_parser("fire")
    fire.add_argument("id")
    for name in ("restore", "woke", "unlocked"):
        sub.add_parser(name)
    ev = sub.add_parser("event")
    ev.add_argument("kind", choices=events.PLACED)
    ev.add_argument("place")
    ev.add_argument("--json", action="store_true")
    sub.add_parser("expire").add_argument("id")
    argv = sys.argv[1:]
    words = [w for i, w in enumerate(argv) if not w.startswith("-") and (i == 0 or argv[i - 1] != "--from")]
    if any(w in ("-h", "--help") for w in argv[:1]):
        pass
    elif not words:
        argv = ["list", *argv]          # `remind` or `remind --json`: the list
    elif words[0] in sub.choices:
        argv.remove(words[0])
        argv = [words[0], *argv]        # `remind --json list`
    else:
        argv = ["add", *argv]           # `remind 15 Tea`, `remind --json wake Stretch`
    if argv[0] == "add":
        argv = join_place(argv)
    a = p.parse_args(argv)
    {"add": cmd_add, "list": cmd_list, "show": cmd_show, "cancel": cmd_cancel, "fire": cmd_fire, "restore": cmd_restore,
     "woke": cmd_woke, "unlocked": cmd_unlocked, "event": cmd_event, "expire": cmd_expire}[a.cmd](a)


def join_place(argv):
    """`remind arrive work Tea`, unquoted: the place is WHEN's, not the message's first word (as schedule reads it)."""
    for i, w in enumerate(argv[1:], 1):
        if w == "--from":   # its value is no WHEN
            continue
        if w.startswith("-") or i > 1 and argv[i - 1] == "--from":
            continue
        if w.lower() in events.PLACED and i + 1 < len(argv) and not argv[i + 1].startswith("-"):
            return [*argv[:i], w + " " + argv[i + 1], *argv[i + 2:]]
        return argv
    return argv


if __name__ == "__main__":
    main()
