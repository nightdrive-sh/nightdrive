#!/usr/bin/env python3
"""The games on this computer (#3530): the Launcher's Games page and Claude's games tools read them here.
  games list [--json]          every game: .desktop files with Categories=Game, and Steam's library
  games launch ID [--json]     start one (ID from list: desktop:<file id> or steam:<appid>); one already running is
                               brought forward instead (--json says running: true then)
  games steam-running          the appid of the Steam game running now, or nothing
games_library.py finds them; gamepad-home (the Xbox button) opens the Launcher's Games page."""

import json
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import games_library  # noqa: E402
import games_running  # noqa: E402

# Brings a window forward, from the background too (Settings › windows, as windows_focus does)
WINDOWS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "windows")


def detach(argv):
    """Starts a game apart from this command, so it outlives it and its output goes nowhere."""
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def notify(title, body):
    if shutil.which("notify-send"):
        detach(["notify-send", "-a", "Games", "-i", "gamepad-2", "-t", "8000", title, body])


def switch_to(game):
    """Brings the running game's window forward. False when it has none (not running, or no Hyprland)."""
    c = games_running.window_of(game, games_running.hypr_clients())
    if not c:
        return False
    subprocess.run([WINDOWS, "focus", c["address"]], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
    return True


def launch(game):
    """Starts the game, or switches to it when it runs already: a second start would be a cold start, or two of it.
    True when it switched."""
    if switch_to(game):
        return True
    if game["source"] == "desktop":
        detach(["gio", "launch", game["path"]])
        return False
    steam = shutil.which("steam")
    if not steam:
        raise RuntimeError("Steam isn't installed")
    # Steam takes the address whether it is running or not (then it starts first). On an ARM Mac Steam and the game run
    # under FEX, and the window may take a minute: the notification says it is on its way, so a wait isn't taken for an
    # error. A game still downloading opens in Steam, which goes on with the download.
    detach([steam, "steam://rungameid/" + game["id"].split(":", 1)[1]])
    notify("Starting " + game["name"], "Steam starts it; it may take a moment" if game["installed"]
           else "It is still downloading: Steam shows how far")
    return False


def usage():
    print(__doc__.split("\n", 1)[1].rsplit("games_library", 1)[0].rstrip(), file=sys.stderr)
    return 2


def main(argv):
    as_json = "--json" in argv
    args = [a for a in argv if a != "--json"]
    cmd = args[0] if args else "list"
    if cmd == "list":
        games = games_running.mark_running(games_library.all_games())
        if as_json:
            print(json.dumps({"games": games}, ensure_ascii=False))
        else:
            for g in games:
                state = "  (running)" if g["running"] else "" if g["installed"] else f"  (downloading {g['progress']} %)"
                print(f"{g['id']:<32} {g['name']}{state}")
        return 0
    if cmd == "launch" and len(args) == 2:
        game = games_library.find(args[1])
        if not game:
            print(f"No such game: {args[1]} (games list shows them)", file=sys.stderr)
            return 1
        try:
            running = launch(game)
        except (OSError, RuntimeError) as e:
            print(f"Couldn't start {game['name']}: {e}", file=sys.stderr)
            return 1
        if as_json:
            print(json.dumps({"started": game["id"], "name": game["name"], "running": running}, ensure_ascii=False))
        elif running:
            print(f"{game['name']} is running: brought it forward")
        return 0
    if cmd == "steam-running":
        appid = games_library.steam_game_running()
        if appid:
            print(appid)
        return 0
    return usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
