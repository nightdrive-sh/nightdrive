#!/bin/bash
# AirPlay speakers (PipeWire's raop_sink.*) start at most at SAFE. AirPlay 1 has no volume of its own on the sender:
# raop_sink sends the sink's volume to the speaker as dB (30·v − 30, so 60 % = −12 dB, which a Sonos takes as 70) on
# every new connection, and nothing comes back, so a volume left from last time overrode the speaker's own (a Sonos at 29
# jumped to 70). A speaker WirePlumber has no volume for could even start at 100 % = 0 dB.
# So a speaker is turned down to SAFE when it appears and when it becomes the output; raise it from there as you like.
# The speaker itself hears nothing of this until audio plays to it (raop_sink sends the volume only while it streams).
# Started by hyprland.lua; listens to PipeWire (pactl subscribe) in the background. One instance only (flock).
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/airplay-volume.lock"
flock -n 9 || exit 0
SAFE=30   # percent: −21 dB on the speaker

sink_of() { pactl list sinks short | awk -v id="$1" '$1 == id { print $2 }'; }
at_most_safe() {
  local v
  v=$(pactl get-sink-volume "$1" 2>/dev/null | grep -oP '\d+(?=%)' | sort -n | tail -1)
  [[ -n $v ]] && (( v > SAFE )) && pactl set-sink-volume "$1" "$SAFE%"
}

for s in $(pactl list sinks short | awk '$2 ~ /^raop_sink\./ { print $2 }'); do at_most_safe "$s"; done
was=$(pactl get-default-sink)
pactl subscribe | while read -r line; do
  case $line in
    "Event 'new' on sink #"*)
      name=$(sink_of "${line##*#}")
      # WirePlumber restores the remembered volume just after the sink appears: check again once it has
      [[ $name == raop_sink.* ]] && { at_most_safe "$name"; (sleep 1; at_most_safe "$name") & } ;;
    "Event 'change' on server"*)
      now=$(pactl get-default-sink)
      [[ $now == "$was" ]] && continue
      was=$now
      [[ $now == raop_sink.* ]] && at_most_safe "$now" ;;
  esac
done
