#!/usr/bin/python3 -I
"""The open windows from the command line: list them, bring one forward, take a picture of one, open an app or an
address. `nightdrive windows …` runs it; Claude's tools are config/mcp/tools/apps-files.json.

  windows [list] [--json]          the open windows, the most recently used first. --json: {focused, windows: [{address,
                                   app, class, title, workspace, monitor, focused, onScreen, hidden, private}]}.
                                   A window Send to Claude leaves out (claude-write blocked) has no title here
  windows focus WINDOW [--json] [--unless-typing]
                                   brings it forward (from the background too, as its key does). WINDOW is an address
                                   or an app (its name or window class); "" does nothing. --json: {address, app, title,
                                   previous}. --unless-typing (Claude's tools, #1832): not while the user types (a key
                                   in the last QUIET s), so what they type (a password) doesn't go to another window.
                                   It waits up to QUIET_WAIT s for the quiet (the Enter that sent the prompt), then
                                   refuses
  windows shot WINDOW [--out FILE] [--json] [--inline] [--check]
                                   a picture of a window on screen (PNG, at most MAX_EDGE px on its long side), never
                                   of one Send to Claude leaves out, nor with one of those or a layer surface (a menu,
                                   a notification: not OWN_LAYERS) over it. Default FILE:
                                   $XDG_RUNTIME_DIR/nightdrive/windows/shot.png. --inline puts it in the JSON
                                   ({image: {mimeType, data}}, base64) instead of a file. --check takes none: it says
                                   for Claude's card which window it would be ({App, Title, Window}: the run refuses
                                   when it would be another, NIGHTDRIVE_MCP_CARD), and "ask": false when
                                   the app is on the user's list of apps Claude sees without asking (Access › What's
                                   on screen; NIGHTDRIVE_MCP_OPTIONS's apps, from the MCP server), unless the window's
                                   title isn't one pictured of that app before (SEEN): a tab switched to, the card
                                   asks. The run refuses when the title isn't the card's any more
  windows open [--app|--url] APP|URL [--json] [--unless-typing]
                                   an app (its name or desktop id, as the Launcher lists it; an open one is brought
                                   forward) or an address (http, https, mailto: nothing else; a mailto: sets only
                                   to, cc, subject and body) in its default app.
                                   Without --app or --url, an address is told by its scheme
  windows open --file PATH [--json]   a file or folder in its default app (files open checks the path first)
                                   --json: {kind, opened, launched, new, address, previous}: new is the window it
                                   opened ("" when none came in WAIT s), previous the one that had the focus. New
                                   is only ever a window of the app it started (the file's type's default app), so
                                   the undo can't close another app's window that came meanwhile (#1860)
  windows close [ADDRESS] [--focus PREVIOUS] [--unless-typing]   closes a window, then focuses another: what undoes
                                   open ("" skips). --unless-typing as focus's
"""
import argparse, base64, configparser, json, os, re, subprocess, sys, time
from pathlib import Path
from urllib.parse import parse_qsl

SCRIPTS = Path(__file__).resolve().parent
WRITE = SCRIPTS / "claude-write"            # `claude-write blocked CLASS TITLE`: the windows nothing is sent from
LAUNCH = SCRIPTS / "launch-or-focus"        # brings a window back from the background (special:bg)
SHOT = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")) / "nightdrive/windows/shot.png"
SEEN = SHOT.parent / "seen.json"              # the titles of each app's windows pictured this session (#1884)
SEEN_MAX = 30                                 # titles kept for one app: the latest
MAX_EDGE = 1568        # px: a bigger picture only costs Claude more, it doesn't see more
WAIT = 8               # s an opened app or file has to show a window
POLL = 0.25
QUIET = 2              # s without a key before Claude's tools move the focus (--unless-typing)
QUIET_WAIT = 5         # s to wait for that quiet before refusing
SCHEMES = ("http://", "https://", "mailto:")
MAILTO_FIELDS = {"to", "cc", "subject", "body"}   # a mailto:'s query may set these, not attach= or bcc= (#1866)
# Layer surfaces that are always mapped, mostly empty, and hold nothing of the user's: any other over a window (a menu,
# a notification, the Wi-Fi password field, the launcher) stops a picture of it, as grim would take it along (#1866)
OWN_LAYERS = {"wallpaper", "nightdrive-bar", "nightdrive-drawer", "nightdrive-garage-resizing", "claude-confirm"}
BACKGROUND = "special:bg"


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def hypr(what):
    try:
        p = subprocess.run(["hyprctl", "-j", what], capture_output=True, text=True, timeout=5)
        return json.loads(p.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        die("Hyprland doesn't answer (hyprctl): is this a Nightdrive desktop?")


def dispatch(*calls):
    """Hyprland's Lua dispatchers, in one batch so they land in the same frame."""
    subprocess.run(["hyprctl", "--batch", ";".join(f"dispatch {c}" for c in calls)], capture_output=True, timeout=5)


def clients():
    """The mapped windows, the most recently focused first."""
    return sorted((c for c in hypr("clients") if c.get("mapped", True)), key=lambda c: c.get("focusHistoryID", 99))


def focused_address():
    return hypr("activewindow").get("address", "") or ""


def on_screen_workspaces():
    out = set()
    for m in hypr("monitors"):
        out.add(m["activeWorkspace"]["name"])
        if m["specialWorkspace"]["name"]:
            out.add(m["specialWorkspace"]["name"])
    return out


def blocked(c):
    """Whether Send to Claude leaves the window out; 1 is the only "no": an error or an older claude-write is a yes."""
    try:
        return subprocess.run([WRITE, "blocked", c.get("class", ""), c.get("title", "")],
                              capture_output=True, timeout=5).returncode != 1
    except (OSError, subprocess.TimeoutExpired):
        return True


def key_age():
    """Whole seconds since the last key, as Hyprland counts them (hypr/last-key.lua; os.time, so 2 means 1–3 s); None
    when it can't say (a config without that file, an older Hyprland): then nothing waits."""
    try:
        p = subprocess.run(["hyprctl", "repl", "return NightdriveKeyAge()"], capture_output=True, text=True, timeout=5)
        return int(p.stdout.strip())
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def not_typing():
    """Waits until the user hasn't pressed a key for more than QUIET s, up to QUIET_WAIT s; dies if they go on. More
    than QUIET whole seconds, as a key 2.9 s ago counts as 2."""
    end = time.monotonic() + QUIET_WAIT
    while True:
        age = key_age()
        if age is None or age > QUIET:
            return
        if time.monotonic() > end:
            die(f"The user is typing (a key in the last {QUIET} s), so the focus wasn't moved: what they type mustn't "
                "go to another window. Try again in a moment, or ask them.")
        time.sleep(POLL)


# --- Desktop entries: an app's name, and what opens it ------------------------------------------------------------

def entry_dirs():
    data = [os.environ.get("XDG_DATA_HOME", str(Path.home() / ".local/share"))]
    data += os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")
    return [Path(d) / "applications" for d in data if d]


def entries():
    """{id: {name, wmclass, hidden}} of the apps the Launcher lists; the first of an id wins, as in XDG."""
    out = {}
    for d in entry_dirs():
        for f in sorted(d.rglob("*.desktop")) if d.is_dir() else []:
            eid = str(f.relative_to(d))[:-8].replace("/", "-")
            if eid in out:
                continue
            cp = configparser.RawConfigParser(strict=False, interpolation=None)
            cp.optionxform = str
            try:
                cp.read(f, encoding="utf-8")
                e = cp["Desktop Entry"]
            except (configparser.Error, KeyError, UnicodeDecodeError):
                continue
            hidden = e.get("NoDisplay") == "true" or e.get("Hidden") == "true" or e.get("Type") != "Application"
            out[eid] = {"name": e.get("Name", eid), "wmclass": e.get("StartupWMClass", ""), "hidden": hidden}
    return out


def app_name(cls, apps):
    """A window class as the app's name: org.mozilla.firefox → Firefox, a web app's class by its StartupWMClass."""
    low = cls.lower()
    for eid, e in apps.items():
        if low in (eid.lower(), e["wmclass"].lower()) or eid.lower().rsplit(".", 1)[-1] == low:
            return e["name"]
    return cls


def find_app(query, apps):
    """(id, entry) of the app a name or id means; an error lists the likely ones."""
    q = query.lower().removesuffix(".desktop")
    shown = {i: e for i, e in apps.items() if not e["hidden"]}
    for test in (lambda i, e: i.lower() == q, lambda i, e: e["name"].lower() == q,
                 lambda i, e: i.lower().rsplit(".", 1)[-1] == q):
        hits = [(i, e) for i, e in shown.items() if test(i, e)]
        if len(hits) == 1:
            return hits[0]
    near = [(i, e) for i, e in shown.items() if q in e["name"].lower() or q in i.lower()]
    if len(near) == 1:
        return near[0]
    if near:
        die(f"Several apps match {query!r}: " + ", ".join(f"{e['name']} ({i})" for i, e in near[:12]))
    die(f"No app {query!r} on this computer (the Launcher's apps).")


def app_windows(eid, entry, wins):
    """The app's open windows: its class is its id, the id's last part or its StartupWMClass (any case)."""
    names = {eid.lower(), eid.lower().rsplit(".", 1)[-1]} | ({entry["wmclass"].lower()} if entry["wmclass"] else set())
    return [c for c in wins if c["class"].lower() in names or c.get("initialClass", "").lower() in names]


# --- Commands ---------------------------------------------------------------------------------------------------

def row(c, apps, focused, visible):
    private = blocked(c)
    ws = c["workspace"]["name"]
    return {"address": c["address"], "app": app_name(c["class"], apps), "class": c["class"],
            "title": "" if private else c["title"], "workspace": "background" if ws == BACKGROUND else ws,
            "monitor": c.get("monitor"), "focused": c["address"] == focused,
            "onScreen": ws in visible and not c.get("hidden"), "hidden": ws == BACKGROUND, "private": private}


def cmd_list(a):
    apps, focused, visible = entries(), focused_address(), on_screen_workspaces()
    rows = [row(c, apps, focused, visible) for c in clients()]
    if a.json:
        print(json.dumps({"focused": focused, "windows": rows}, ensure_ascii=False))
        return
    for r in rows:
        mark = "*" if r["focused"] else " "
        title = "(private)" if r["private"] else r["title"]
        print(f"{mark} {r['address']}  {r['workspace']:>10}  {r['app']}: {title}")


def find_window(spec, wins):
    """A window by its address (with or without 0x) or by app: the most recently used of its windows."""
    s = spec.lower().removeprefix("0x")
    for c in wins:
        if c["address"].lower().removeprefix("0x") == s:
            return c
    apps = entries()
    for c in wins:
        if spec.lower() in (c["class"].lower(), app_name(c["class"], apps).lower()):
            return c
    die(f"No open window {spec!r} (windows list shows them).")


def show(c):
    """Focuses a window; one in the background comes to this workspace first, as its key brings it (launch-or-focus)."""
    if c["workspace"]["name"] == BACKGROUND:
        subprocess.run([LAUNCH, "^" + re.escape(c["class"]) + "$", "true"], capture_output=True, timeout=10)
    dispatch(f'hl.dsp.focus({{ window = "address:{c["address"]}" }})')


def cmd_focus(a):
    previous = focused_address()
    if not a.window:
        return
    c = find_window(a.window, clients())
    if a.unless_typing:
        not_typing()
    show(c)
    out = {"address": c["address"], "app": app_name(c["class"], entries()),
           "title": "" if blocked(c) else c["title"], "previous": previous}
    print(json.dumps(out, ensure_ascii=False) if a.json else f"Focused {out['app']}")


def listed(c, apps):
    """Whether the window's app is on the user's list of apps Claude sees without asking (window classes, or an app's
    name typed in: any case), as the MCP server passes it; outside the server there is no list."""
    try:
        listing = json.loads(os.environ.get("NIGHTDRIVE_MCP_OPTIONS") or "{}").get("apps") or []
    except (ValueError, AttributeError):
        return False
    mine = {c.get("class", "").lower(), c.get("initialClass", "").lower(), app_name(c["class"], apps).lower()} - {""}
    return any(isinstance(v, str) and v.lower() in mine for v in listing)


def layer_over(x, y, w, h):
    """The namespace of a layer surface above windows (Top, Overlay) over the rectangle, not one of OWN_LAYERS."""
    for monitor in (hypr("layers") or {}).values():
        for level, layers in (monitor.get("levels") or {}).items():
            if str(level) not in ("2", "3"):
                continue
            for l in layers:
                lx, ly, lw, lh = (l.get(k, 0) for k in ("x", "y", "w", "h"))
                if l.get("namespace") not in OWN_LAYERS and lx < x + w and x < lx + lw and ly < y + h and y < ly + lh:
                    return l.get("namespace") or "a layer"
    return None


def card_said():
    """What Claude's card said for this call (the MCP server's NIGHTDRIVE_MCP_CARD), or {}."""
    try:
        said = json.loads(os.environ.get("NIGHTDRIVE_MCP_CARD") or "{}")
    except ValueError:
        return {}
    return said if isinstance(said, dict) else {}


def seen():
    """{app's class: [titles pictured]}: a listed app's window with a title not among them gets a card (#1884)."""
    try:
        data = json.loads(SEEN.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def remember(c):
    data = seen()
    key = c.get("class", "").lower()
    titles = [t for t in data.get(key, []) if isinstance(t, str) and t != c["title"]] + [c["title"]]
    data[key] = titles[-SEEN_MAX:]
    SEEN.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = SEEN.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False))
    tmp.replace(SEEN)


def new_title(c):
    """A window of an app pictured before, showing what wasn't pictured then: Wikipedia was, the bank tab the user
    has switched to since wasn't. The user's list of apps Claude sees without asking was for what they had seen."""
    titles = seen().get(c.get("class", "").lower())
    return isinstance(titles, list) and bool(titles) and c["title"] not in titles


def cmd_shot(a):
    wins = clients()
    c = find_window(a.window, wins)
    # By an app's name, the window is its latest: the card named one, and the user may have used another since
    said = card_said()
    shown = said.get("Window")
    if not a.check and shown and shown != c["address"]:
        die(f"The window the card showed ({shown}) isn't {a.window}'s latest any more: no picture was taken. Ask "
            "again with the window's address.")
    # …and the same window may show something else now: a browser's tab, switched after the card said Wikipedia
    if not a.check and "Title" in said and said["Title"] != (c["title"] or "(no title)"):
        die(f"The window's title changed after the card showed it ({said['Title']!r}, now another): no picture was "
            "taken. Ask again if the user wants it.")
    visible = on_screen_workspaces()
    if blocked(c):
        die("That window is left out, as Send to Claude leaves it out (a password manager, a private window, or an "
            "app in Launcher › Settings › Claude writes › Not in these apps): no picture was taken.")
    if c["workspace"]["name"] not in visible or c.get("hidden"):
        die("That window isn't on screen (its workspace isn't shown): bring it forward first (windows focus).")
    x, y = c["at"]; w, h = c["size"]
    for o in wins:  # a left-out window over it (a password manager's popup) mustn't end up in the picture
        if o is c or o["workspace"]["name"] not in visible:
            continue
        ox, oy = o["at"]; ow, oh = o["size"]
        if ox < x + w and x < ox + ow and oy < y + h and y < oy + oh and blocked(o):
            die("A window that is left out (a password manager, a private window…) is over it: no picture was taken.")
    over = layer_over(x, y, w, h)
    if over:
        die(f"Something of the desktop's is over it ({over}: a menu, a notification, the launcher): no picture was "
            "taken. Try again once it has gone.")
    if a.check:
        apps = entries()
        card = {"App": app_name(c["class"], apps), "Title": c["title"] or "(no title)", "Window": c["address"]}
        unasked = listed(c, apps) and not new_title(c)
        print(json.dumps({**card, **({"ask": False} if unasked else {})}, ensure_ascii=False))
        return
    scale = next((m["scale"] for m in hypr("monitors") if m["id"] == c.get("monitor")), 1)
    scale = min(scale, MAX_EDGE / max(w, h, 1))
    out = Path(a.out) if a.out else SHOT
    out.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    p = subprocess.run(["grim", "-g", f"{x},{y} {w}x{h}", "-s", f"{scale:.3f}", "-t", "png", str(out)],
                       capture_output=True, text=True, timeout=10)
    if p.returncode != 0:
        die("grim couldn't take the picture: " + (p.stderr.strip() or "no message"))
    if os.environ.get("NIGHTDRIVE_MCP"):
        try:
            remember(c)
        except OSError:
            pass   # the picture is taken: a title not kept only means a card next time
    info = {"address": c["address"], "app": app_name(c["class"], entries()), "class": c["class"], "title": c["title"],
            "width": round(w * scale), "height": round(h * scale)}
    if a.inline:
        info["image"] = {"mimeType": "image/png", "data": base64.b64encode(out.read_bytes()).decode()}
        out.unlink(missing_ok=True)
    else:
        info["path"] = str(out)
    print(json.dumps(info, ensure_ascii=False) if a.json else info.get("path", "(inline)"))


def wait_new(before, app):
    """The first window of app ((id, entry)) that wasn't there before, within WAIT s; None if none came, or app is
    None (what opened it isn't known). Another app's window that opens meanwhile isn't it: open's undo closes it."""
    end = time.monotonic() + WAIT
    while app and time.monotonic() < end:
        time.sleep(POLL)
        new = [c for c in app_windows(*app, clients()) if c["address"] not in before]
        if new:
            return new[0]
    return None


def handler(path):
    """(id, entry) of the app gio open opens path in: its type's default app (gio's own answer, as gio open asks it);
    None when it can't say."""
    try:
        info = subprocess.run(["gio", "info", "-a", "standard::content-type", "--", str(path)], capture_output=True,
                              text=True, timeout=10, env={**os.environ, "LC_ALL": "C"}).stdout
        mime = re.search(r"standard::content-type: (\S+)", info)
        said = subprocess.run(["gio", "mime", "--", mime.group(1)], capture_output=True, text=True, timeout=10,
                              env={**os.environ, "LC_ALL": "C"}).stdout if mime else ""
    except (OSError, subprocess.TimeoutExpired):
        return None
    default = re.search(r"^Default application for .*: (\S+)\.desktop$", said, re.M)
    apps = entries()
    return (default.group(1), apps[default.group(1)]) if default and default.group(1) in apps else None


def launch(argv):
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def cmd_open(a):
    if a.unless_typing:
        not_typing()
    previous = focused_address()
    wins = clients()
    before = {c["address"] for c in wins}
    out = {"previous": previous, "launched": False, "new": "", "address": ""}
    app = None
    if a.file:
        path = Path(a.target).expanduser()
        if not path.exists():
            die(f"{a.target} doesn't exist.")
        out.update(kind="file", opened=str(path))
        app = handler(path)
        launch(["gio", "open", str(path)])
    elif a.url or (not a.app and a.target.lower().startswith(SCHEMES)):
        if not a.target.lower().startswith(SCHEMES):  # no file://, javascript: or an app's own scheme that acts
            die(f"Only http, https and mailto addresses are opened, not {a.target!r}.")
        if a.target.lower().startswith("mailto:"):
            fields = {k.lower() for k, _ in parse_qsl(a.target.partition("?")[2], keep_blank_values=True)}
            if fields - MAILTO_FIELDS:
                die(f"A mailto: address may set {', '.join(sorted(MAILTO_FIELDS))}, not "
                    f"{', '.join(sorted(fields - MAILTO_FIELDS))}: a composer could attach a file or add a hidden "
                    "recipient by them.")
        out.update(kind="address", opened=a.target)
        launch(["gio", "open", a.target])
        print(json.dumps(out, ensure_ascii=False) if a.json else f"Opened {a.target}")
        return  # a browser's new tab is no window of its own: nothing to wait for
    else:
        eid, entry = find_app(a.target, entries())
        out.update(kind="app", opened=entry["name"])
        mine = app_windows(eid, entry, wins)
        if mine:  # open already: bring it forward, as its key does
            show(mine[0])
            out["address"] = mine[0]["address"]
            print(json.dumps(out, ensure_ascii=False) if a.json else f"Focused {entry['name']}")
            return
        launch(["gtk-launch", eid + ".desktop"])
        out["launched"] = True
        app = (eid, entry)
    new = wait_new(before, app)
    if new:
        show(new)
        out.update(new=new["address"], address=new["address"])
    print(json.dumps(out, ensure_ascii=False) if a.json else f"Opened {out['opened']}")


def cmd_close(a):
    if a.unless_typing and (a.address or a.focus):
        not_typing()
    wins = {c["address"]: c for c in clients()}
    if a.address and a.address in wins:
        dispatch(f'hl.dsp.window.close({{ window = "address:{a.address}" }})')
    if a.focus and a.focus in wins and a.focus != a.address:
        time.sleep(POLL)  # the closing window gives the focus away first: then take it
        dispatch(f'hl.dsp.focus({{ window = "address:{a.focus}" }})')


def main():
    ap = argparse.ArgumentParser(prog="nightdrive windows", description="The open windows.")
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("list"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_list)
    p = sub.add_parser("focus"); p.add_argument("window"); p.add_argument("--json", action="store_true")
    p.add_argument("--unless-typing", action="store_true"); p.set_defaults(fn=cmd_focus)
    p = sub.add_parser("shot"); p.add_argument("window"); p.add_argument("--out")
    p.add_argument("--json", action="store_true"); p.add_argument("--inline", action="store_true")
    p.add_argument("--check", action="store_true"); p.set_defaults(fn=cmd_shot)
    p = sub.add_parser("open"); p.add_argument("target")
    kind = p.add_mutually_exclusive_group()
    for k in ("--app", "--url", "--file"):
        kind.add_argument(k, action="store_true")
    p.add_argument("--json", action="store_true"); p.add_argument("--unless-typing", action="store_true")
    p.set_defaults(fn=cmd_open)
    p = sub.add_parser("close"); p.add_argument("address", nargs="?", default="")
    p.add_argument("--focus", default=""); p.add_argument("--unless-typing", action="store_true")
    p.set_defaults(fn=cmd_close)
    argv = sys.argv[1:]
    if not argv or argv[0] not in sub.choices and argv[0].startswith("-"):
        argv = ["list", *argv]
    a = ap.parse_args(argv)
    a.fn(a)


if __name__ == "__main__":
    main()
