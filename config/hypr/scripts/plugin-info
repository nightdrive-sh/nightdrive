#!/usr/bin/python3 -I
"""Details of an optional part (plugins.txt, or a plugin folder's plugin.conf) for the launcher's detail view, as JSON on
stdout: the same shape as pkg-info's, so Install › Recommended and Plugins open the same page as Install › Software.
  plugin-info <id>
Output: { name, summary, installed, off, external, icon, screenshot, paragraphs: [text | {code: [line]} | {heading}], fields: [[label, value]], setup }
(a plugin folder's fields include its Version and Author from plugin.conf, for bug reports)
(off: turned off with `nightdrive plugins off`; external: added with `nightdrive plugins add`, from Source;
setup: plugin.conf's setup as a command line, or null)
The long text is the folder's README.md, or docs/plugins/<id>.md for a plugins.txt line (GitHub shows the same file): the
# title is left out, paragraphs are split at blank lines, a "- " item is a paragraph of its own, a code block (indented or
in ``` fences) is one with its lines as they are ({code: [line]}, shown in a box), the first image ![…](file)
is the screenshot, a table's rows are items ("first cell: the rest", without the header) and lines "Homepage: …" /
"Needs: …" / "Keys: …" go to the facts. Without the file the page has the
one-line description."""
import json, os, re, subprocess, sys

REPO = os.path.realpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "../../.."))
FIELDS = ("Homepage", "Needs", "Keys")


EXTERNAL = os.path.expanduser("~/.local/share/nightdrive/plugins")
OFF = os.path.expanduser("~/.local/state/nightdrive/plugins-off")     # an empty file per plugin that is off
KEYS = ("name", "icon", "description", "default", "install", "installed", "group")


def row(pid):
    """plugins.txt's fields for the id, and the folder its installer and test run in (and its README.md is in): a
    plugins.txt line first, then the repo's plugins/<id>/, then an external one (bin/nightdrive's order)."""
    with open(os.path.join(REPO, "plugins.txt")) as f:
        for line in f:
            if line.strip() and not line.lstrip().startswith("#"):
                p = line.rstrip("\n").split("|")
                if len(p) >= 8 and p[0] == pid:
                    return p, REPO, os.path.join(REPO, "docs/plugins", pid + ".md")
    for base in (os.path.join(REPO, "plugins"), EXTERNAL):
        d = os.path.join(base, pid)
        try:
            lines = open(os.path.join(d, "plugin.conf")).read().split("\n")
        except OSError:
            continue
        c = dict(l.split("=", 1) for l in lines if re.match(r"[a-z]+=", l))
        defaults = {"name": pid, "icon": "puzzle", "default": "off", "install": "true", "installed": "false", "group": "plugin"}
        return [pid] + [c.get(k, defaults.get(k, "")) for k in KEYS] + [c.get("version", ""), c.get("author", ""), c.get("setup", "")], d, os.path.join(d, "README.md")
    return None, REPO, ""


def plain(t):
    """Markdown → plain text: links keep their text, ** and ` go."""
    t = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", t)
    return t.replace("**", "").replace("`", "").strip()


def doc(path):
    paragraphs, fields, shot, cur, code, fence, blank, table = [], [], "", [], None, "", True, False
    try:
        lines = open(path).read().split("\n")
    except OSError:
        return paragraphs, fields, shot

    def flush():
        nonlocal code
        if cur:
            paragraphs.append(plain(" ".join(cur)))
            cur.clear()
        if code is not None:
            while code and not code[-1].strip():
                code.pop()
            if code:
                paragraphs.append({"code": code})
            code = None
    for line in lines:
        s = line.strip()
        after_blank, blank = blank, not s
        # A code block keeps its lines as they are: in ``` fences, or indented by 4 spaces (or a tab) after a blank line
        # (Markdown's indented block can't go on from a paragraph or an item); a blank line inside one stays in it.
        # plugin-check finds the same lines.
        if fence:
            if s.startswith(fence):
                fence = ""
                flush()
            else:
                code.append(line.rstrip())
            continue
        opening = re.match(r"(`{3,}|~{3,})", s)
        if opening:
            flush()
            fence, code = opening.group(1), []
            continue
        if line.startswith(("    ", "\t")) and s and (code is not None or after_blank) or code is not None and not s:
            if code is None:
                code = []
            code.append(line.rstrip()[4 if line.startswith("    ") else 1:])
            continue
        if code is not None:
            flush()
        # A table (| a | b |): the header and the |---| line are left out, each row is an item "first: the rest"
        if s.startswith("|"):
            flush()
            cells = [plain(c.strip()) for c in s.strip("|").split("|")]
            if not table:
                table = True               # the header row
            elif not all(re.fullmatch(r":?-+:?", c) for c in cells):
                paragraphs.append("•  " + cells[0] + ": " + " · ".join(c for c in cells[1:] if c))
            continue
        table = False
        img = re.match(r"!\[[^\]]*\]\(([^)\s]+)", s)
        field = re.match(r"(%s): (.+)$" % "|".join(FIELDS), s)
        heading = re.match(r"#{2,4} (.+)$", s)
        if heading:                        # ## and deeper: a section title on the page (# is the name, left out)
            flush()
            paragraphs.append({"heading": plain(heading.group(1))})
        elif not s or s.startswith("#"):
            flush()
        elif img:
            flush()
            if not shot:
                f = img.group(1)
                shot = f if re.match(r"https?://", f) else "file://" + os.path.normpath(os.path.join(os.path.dirname(path), f))
        elif field:
            flush()
            fields.append([field.group(1), plain(field.group(2)) if field.group(1) != "Homepage" else field.group(2)])
        elif s.startswith(("- ", "* ")):
            flush()
            cur.append("•  " + s[2:])
            flush()
        else:
            cur.append(s)
    flush()
    return paragraphs, fields, shot


def installer(inst):
    if inst.startswith("flatpak "):
        return "Flathub: " + inst[8:]
    if inst.startswith("webapp "):
        return "Web app: " + inst[7:]
    return inst + " (in a terminal)"


if len(sys.argv) != 2:
    print(__doc__.split("\n")[2], file=sys.stderr)
    sys.exit(1)
p, folder, readme = row(sys.argv[1])
if p is None:
    print(json.dumps({ "name": sys.argv[1], "summary": "", "installed": False, "icon": "", "screenshot": "",
                       "paragraphs": [], "fields": [["Details", "not available"]] }))
    sys.exit(0)
pid, name, icon, desc, default, inst, test, group = p[:8]
installed = subprocess.run(["bash", "-c", test], cwd=folder, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
off = os.path.exists(os.path.join(OFF, pid))
external = os.path.dirname(folder) == EXTERNAL
paragraphs, extra, shot = doc(readme)
fields = [["Status", ("installed" if installed else "not installed") + (", turned off" if off else "")],
          ["Type", { "plugin": "Desktop feature", "recommended": "App Nightdrive sets up", "webapp": "Web app" }.get(group, group)]]
if len(p) > 9 and p[8]:     # a plugin folder's version and author (plugins.txt lines have none)
    fields.append(["Version", p[8]])
if len(p) > 9 and p[9]:
    fields.append(["Author", p[9]])
if external:      # where it came from: the clone's origin (plugins add), else just the folder
    origin = subprocess.run(["git", "-C", folder, "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
    # Without the URL's userinfo (https://TOKEN@host/…), as software's origin: this goes to Claude (software_info)
    origin = re.sub(r"^([A-Za-z][A-Za-z0-9+.-]*://)[^/?#]*@", r"\1", origin)
    fields.append(["Source", "external, " + (origin or folder)])
fields += extra + [["Installer", installer(inst)]]
# setup: plugin.conf's command that sets the plugin up with Claude, as the command line the page runs (in the folder)
setup = ["bash", "-c", 'cd "$1" && ' + p[10], "setup", folder] if len(p) > 10 and p[10] else None
print(json.dumps({ "name": name, "summary": desc, "installed": installed, "off": off, "external": external, "icon": "",
                   "screenshot": shot, "paragraphs": paragraphs, "fields": fields, "setup": setup }))
