#!/usr/bin/python3 -I
"""Commands run at a time or on an event (Dashboard #3121): `nightdrive schedule …` runs this.

  schedule WHEN [--run|--claude|--to SESSION] LINE… [--json]
                                       LINE at WHEN: minutes (15, 90m, 2h, 1h30m, up to a week), a time of day (14:45,
                                       14.45: the next one), wake (the first unlock after the computer next wakes from
                                       sleep) or login (the next login); @UNIX: that moment (the undo of a cancel).
                                       A LINE whose first word is a program in PATH, or nightdrive, is a command (Run):
                                       one argument is a shell line as such ("make && notify-send done"); several are
                                       words, quoted for the shell as given. Any other is a message to Claude (Ask
                                       Claude, schedule_claude.py): a new session in a window of its own gets it, or
                                       with --to that session (an id or a name, as `nightdrive sessions` shows them).
                                       --run and --claude say which instead. --json: the row, as list gives each
  schedule list [--json]               the waiting ones, by time, then wake and login. --json: {commands: [{id, when,
                                       at, at_unix, clock, minutes_left, state, kind, to, command}]}: when is time,
                                       wake or login (at, at_unix, clock, minutes_left are null for wake and login);
                                       state is waiting, unlock (its time came under the lock), missed (asks Run or
                                       Skip) or due; kind is run or claude, to the session a message is for (or null),
                                       command the line or the message
  schedule show ID --json              one of them, as list gives it
  schedule run ID                      runs one now, whatever it waits for (a missed one, say)
  schedule cancel ID|all [--json]      takes one (or every one) away before it runs
  schedule restore                     at login (hypr/autostart.lua): the timers again, login's rows run, missed ones
                                       under LATE_HOURS late run and older ones ask (Run / Skip)
  schedule woke                        after sleep (hypridle's after_sleep_cmd): wake's rows wait for the unlock
  schedule unlocked                    at each unlock but the login's (autostart.lua): what waited for it runs
  schedule fire ID [--now]             the timer's own call: runs the command, with a notification; under the lock
                                       it waits for the unlock instead (--now: runs it anyway)
  schedule send [--to SESSION] MESSAGE…   a message's run (fire runs it as a command): to that session, or a new one

Nothing runs unseen: what waits is in `schedule list`, and a run shows a notification with the command (Running…, then
Done, or Failed with the end of its output, pinned). The whole output goes to the journal:
journalctl --user -u 'nightdrive-schedule-ID*'. A command runs once, in a systemd scope of its own (a window it opens
stays open after the run), from the home folder, with the desktop's environment and ~/.local/bin in PATH.

The timers are timers.py's, as Remind's: a transient systemd user timer on the wall clock, so a time that passed while
the computer slept comes as it wakes, and waits for the unlock (Jari 19.11.: nothing runs behind the lock). Over a
logout or a restart the timer goes and the row stays: the next login runs it if it is under LATE_HOURS late, and asks
about an older one.
"""
import argparse, json, os, secrets, shlex, subprocess, sys, tempfile, time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import timers  # noqa: E402  the timer base shared with remind (timers.py)
import schedule_claude as claude  # noqa: E402  a message to Claude: how it is told apart and where it goes

STATE = os.path.expanduser("~/.local/state/nightdrive/schedule.json")
UNIT = "nightdrive-schedule-"       # + the id: the timer, its service, a run now (-now) and the command's scope (-run)
MAX_MINUTES = 7 * 24 * 60           # a week, as Remind's
LATE_HOURS = 12                     # missed over a logout: run at login under this late, else asked (Jari 19.11.)
EVENTS = ("wake", "login")
APP, ICON = "Schedule", "lucide:calendar-clock"
TAIL_LINES = 3                      # of a failed run's output, in its notification
SELF = os.path.realpath(__file__)   # the timer runs this checkout's script (a worktree's or the sandbox's own)
# Set by `woke` while the lock is up: the next unlock is the first after waking. In the runtime dir, so a logout or a
# restart drops it with the session it belongs to.
WOKE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "nightdrive-schedule-woke")
LOCKS = ("[q]s -p .*/greeter/lock\\.qml", "^hyprlock")   # the lock and its fallback (hypr/scripts/lock)


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def state():
    # STATE read at each call: the tests point it elsewhere
    return timers.locked_rows(STATE, "commands")


def arm(r):
    return timers.arm(UNIT + r["id"], r["at"], "Nightdrive schedule: " + r["command"][:60], [SELF, "fire", r["id"]])


def disarm(rid):
    timers.disarm(UNIT + rid)


def screen_locked():
    """The session's lock is up: this session's only (a container's runs as the same user), as hypr/scripts/lock asks."""
    mine = ["--ns", str(os.getpid()), "--nslist", "pid", "-u", str(os.getuid())]
    return any(subprocess.run(["pgrep", *mine, "-f", p], capture_output=True).returncode == 0 for p in LOCKS)


def start_now(rid):
    """Runs a row now as a service of its own (`fire --now`), so its output goes to the journal as a timer's would, and
    the caller (a login's restore, an unlock) doesn't wait for it. The unit's name keeps one row from running twice."""
    p = subprocess.run(["systemd-run", "--user", "--quiet", "--collect", "--unit", UNIT + rid + "-now",
                        "--description", "Nightdrive schedule: run now", "--", SELF, "fire", rid, "--now"],
                       capture_output=True, text=True)
    return p.returncode == 0


def command_line(words):
    """The words after WHEN → one shell line. A single word is a line as typed (it may hold && or a pipe); several
    are quoted one by one, so `schedule 15 notify-send "Tea is ready"` keeps its message whole."""
    words = [w for w in words if w.strip()]
    if len(words) == 1:
        return words[0].strip()
    return shlex.join(words)


def syntax_error(line):
    """sh's complaint about the line (an unclosed quote), or "" when it would parse: caught now, not at its time."""
    p = subprocess.run(["sh", "-n", "-c", line], capture_output=True, text=True)
    return "" if p.returncode == 0 else (p.stderr.strip() or "it doesn't parse")


def public(r, now=None):
    now = time.time() if now is None else now
    out = {"id": r["id"], "when": r.get("on", "time"), "at": None, "at_unix": None, "clock": None,
           "minutes_left": None, "state": r.get("state", "waiting"), "kind": r.get("kind", "run"),
           "to": r.get("to"), "command": r["command"]}
    if "on" not in r:
        out.update(at=timers.iso(r["at"]), at_unix=int(r["at"]), clock=timers.clock(r["at"]),
                   minutes_left=timers.minutes_left(r["at"], now))
    return out


def what(r):
    """What a row does, as the list and the notifications say it: the command, or Ask Claude [→ SESSION]: message."""
    if r.get("kind") != "claude":
        return r["command"]
    return "Ask Claude" + (" → " + r["to"] if r.get("to") else "") + ": " + r["command"]


def label(r):
    """When it runs, for the list and the notifications: 14:45, wake, login."""
    return r["on"] if "on" in r else timers.clock(r["at"])


def order(r):
    return (1, EVENTS.index(r["on"])) if "on" in r else (0, r["at"])


def notify(rid, summary, body="", pinned=False, actions=()):
    """One notification per run: the stack tag makes Done or Failed take Running's place (Notifs.qml), without a sound.
    With actions ([(key, label)]) it waits for the answer and returns the key, "" when it was dismissed."""
    args = ["notify-send", "-a", APP, "-i", ICON, "-h", "string:x-dunst-stack-tag:schedule-" + rid]
    if pinned:   # stays until dismissed (Notifs.qml's x-nightdrive-pin)
        args += ["-h", "boolean:x-nightdrive-pin:true"]
    if actions:
        args += ["-w", *[f"--action={k}={v}" for k, v in actions]]
    p = subprocess.run([*args, "--", summary, body], capture_output=True, text=True)
    return p.stdout.strip()


def run_command(rid, line):
    """Runs the line to its end → (exit code, its output). In a scope of its own: the timer's service is stopped when
    this returns, and with it whatever is left in its cgroup, such as a terminal the command opened."""
    env = dict(os.environ)
    local_bin = os.path.expanduser("~/.local/bin")   # `nightdrive …`: the user's PATH has it, systemd's may not
    if local_bin not in env.get("PATH", "").split(":"):
        env["PATH"] = local_bin + ":" + env.get("PATH", "/usr/bin:/bin")
    # Output to a file, not a pipe: a window the command leaves running would hold a pipe open, and this would wait
    with tempfile.TemporaryFile("w+") as out:
        try:
            code = subprocess.run(["systemd-run", "--user", "--scope", "--quiet", "--collect", "--unit",
                                   UNIT + rid + "-run", "--", "sh", "-c", line],
                                  stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                                  cwd=os.path.expanduser("~"), env=env).returncode
        except OSError as e:
            return 127, str(e)
        out.seek(0)
        return code, out.read()


def execute(r):
    """The run as such, with its notifications: Running, then Done or Failed (pinned, with its output's end)."""
    if "on" in r:
        note = {"wake": "On waking", "login": "At login"}[r["on"]]
    elif time.time() - r["at"] > 120:   # a late one says it is: the clock time alone would look wrong
        note = "Was due at " + timers.clock(r["at"])
    else:
        note = "Scheduled for " + timers.clock(r["at"])
    ask = r.get("kind") == "claude"
    notify(r["id"], ("" if ask else "Running: ") + what(r), note)
    line = claude.send_line(SELF, r.get("to"), r["command"]) if ask else r["command"]
    code, output = run_command(r["id"], line)
    if output:
        print(output, end="" if output.endswith("\n") else "\n")   # to the journal, whole
    if code == 0:   # a message's says where it went: its window, a resumed one, a new session
        notify(r["id"], "Done: " + what(r), output.strip().splitlines()[-1] if ask and output.strip() else "")
    else:
        tail = "\n".join(output.strip().splitlines()[-TAIL_LINES:])
        notify(r["id"], f"Failed (exit {code}): " + what(r),
               (tail + "\n" if tail else "") + f"journalctl --user -u '{UNIT}{r['id']}*'", pinned=True)


def due(pick):
    """The rows pick(row) chooses become due and start now, each in its own service. They are marked first, under the
    lock, so a second caller (two unlocks close together) starts none twice; one whose start failed stays due, and the
    next unlock or login starts it."""
    with state() as rows:
        ids = [r["id"] for r in rows if pick(r)]
        for r in rows:
            if r["id"] in ids:
                r["state"] = "due"
    for rid in ids:
        start_now(rid)
    return ids


def cmd_add(a):
    now = int(time.time())
    on = a.when if a.when in EVENTS else None
    at = None if on else timers.when(a.when, now, MAX_MINUTES)
    if not on and at is None:
        die("Minutes up to a week (15, 90m, 2h, 1h30m), a time of day (14:45), wake or login; "
            "a moment (@UNIX) not past and within a week", 2)
    forced = getattr(a, "run", False) or getattr(a, "claude", False) or getattr(a, "to", None)
    k = "claude" if getattr(a, "claude", False) or getattr(a, "to", None) else \
        "run" if getattr(a, "run", False) else claude.kind(a.command)
    line = command_line(a.command) if k == "run" else claude.message(a.command)
    if not line:
        die("What to run: schedule WHEN COMMAND, or a message to Claude", 2)
    err = syntax_error(line) if k == "run" else ""
    if err:
        die("The command doesn't parse: " + err, 2)
    to = None
    if getattr(a, "to", None):
        try:
            to = claude.target(a.to, claude.sessions())
        except ValueError as e:
            die(str(e), 2)
    r = {"id": secrets.token_hex(4), "command": line, **({"on": on, "added": now} if on else {"at": at}),
         **({"kind": "claude", "to": to} if k == "claude" else {})}
    with state() as rows:
        if not on:
            ok, err = arm(r)
            if not ok:
                die("The timer didn't start: " + (err or "systemd-run failed"))
        rows.append(r)
    if a.json:
        print(json.dumps(public(r), ensure_ascii=False))
    else:
        print(f"{'On ' + on if on else 'At ' + timers.clock(at)}: {'' if k == 'claude' else 'Run: '}{what(r)}  "
              f"({r['id']})")
        if not forced:   # read by its first word: how to say the other
            print("  A message to Claude: --run runs it as a command" if k == "claude" else
                  "  A command: --claude sends it to Claude as a message")


def cmd_list(a):
    with state() as rows:
        rows.sort(key=order)
        out = [public(r) for r in rows]
    if a.json:
        print(json.dumps({"commands": out}, ensure_ascii=False))
    elif not out:
        print("No commands waiting")
    for r in [] if a.json else out:
        if not r["clock"]:
            when = "on " + r["when"]
        elif r["at_unix"] <= time.time():   # waits for the unlock, or missed: when it was due
            when = "was due " + r["at"][:16].replace("T", " ")
        else:
            when = f"{r['clock']}  in {r['minutes_left']} min"
        st = "" if r["state"] == "waiting" else f"  [{r['state']}]"
        print(f"{when}  {'' if r['kind'] == 'claude' else 'Run: '}{what(r)}{st}  ({r['id']})")


def find(rows, rid):
    r = next((r for r in rows if r["id"] == rid), None)
    if not r:
        die(f"No command {rid}: it ran already, or was cancelled (schedule list)")
    return r


def cmd_show(a):
    with state() as rows:
        r = find(rows, a.id)
    print(json.dumps(public(r), ensure_ascii=False) if a.json else f"{label(r)}  {what(r)}")


def cmd_run(a):
    with state() as rows:
        find(rows, a.id)
    disarm(a.id)   # its timer, if it has one, would run it again at its time
    if not start_now(a.id):
        die("It didn't start: systemd-run failed")
    print("Running: see its notification")


def cmd_cancel(a):
    with state() as rows:
        gone = [r for r in rows if a.id in ("all", r["id"])]
        if not gone and a.id != "all":
            die(f"No command {a.id}: it ran already, or was cancelled (schedule list)")
        for r in gone:
            if "on" not in r:
                disarm(r["id"])
            rows.remove(r)
    if a.json:
        print(json.dumps({"cancelled": [public(r) for r in gone]}, ensure_ascii=False))
    else:
        print("\n".join(f"Cancelled: {r['command']}" for r in gone) or "No commands waiting")


def cmd_fire(a):
    # The row goes before the run: a command runs once, even if this is stopped halfway (a logout mid-run). Under the
    # lock (its time came while the computer slept, or while away) it stays, to run at the unlock
    with state() as rows:
        r = next((r for r in rows if r["id"] == a.id), None)
        if r and not getattr(a, "now", False) and screen_locked():
            r["state"] = "unlock"
            return
        if r:
            rows.remove(r)
    if r:   # cancelled meanwhile: nothing runs
        execute(r)


def cmd_restore(a):
    """At login: a timer that went with the last session is armed again; login's rows run; a time missed meanwhile runs
    if it is under LATE_HOURS late, an older one asks. Wake's rows wait for a wake."""
    now = time.time()
    try:
        os.remove(WOKE)   # a wake before the logout isn't this session's
    except OSError:
        pass

    def runs(r):
        if "on" in r:
            return r["on"] == "login"
        return r["at"] <= now and r.get("state") != "missed" and now - r["at"] < LATE_HOURS * 3600

    due(runs)
    ask = []
    with state() as rows:
        for r in rows:
            if "on" in r or r.get("state") == "due":
                continue
            if r["at"] <= now:
                r["state"] = "missed"
                ask.append(r["id"])
            elif not timers.armed(UNIT + r["id"]):
                r.pop("state", None)
                arm(r)
    for rid in ask:
        ask_later(rid)


def ask_later(rid):
    # Each its own question, in the background: an unanswered one mustn't hold the others, nor the login
    subprocess.Popen([SELF, "ask", rid], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_ask(a):
    """A missed one's question: Run or Skip. Dismissed, it stays in the list as missed (schedule run / cancel)."""
    with state() as rows:
        r = next((r for r in rows if r["id"] == a.id and r.get("state") == "missed"), None)
    if not r:
        return
    answer = notify(r["id"], "Missed: " + what(r),
                    f"Was due {timers.iso(r['at'])[:16].replace('T', ' at ')}, while the computer was off",
                    pinned=True, actions=[("run", "Run"), ("skip", "Skip")])
    if answer == "run":
        due(lambda x: x["id"] == r["id"] and x.get("state") == "missed")
    elif answer == "skip":
        with state() as rows:
            rows[:] = [x for x in rows if x["id"] != r["id"]]


def cmd_woke(a):
    """After sleep: wake's rows run at the first unlock. Under no lock (none came before the sleep) that is now."""
    if screen_locked():
        with open(WOKE, "w"):
            pass
    else:
        due(lambda r: r.get("on") == "wake")


def cmd_unlocked(a):
    """At an unlock: what came due under the lock runs, and wake's rows if this is the first unlock after waking."""
    woke = os.path.exists(WOKE)
    if woke:
        os.remove(WOKE)
    due(lambda r: r.get("state") in ("unlock", "due") or woke and r.get("on") == "wake")


def parse_add(argv):
    """[options] WHEN [options] [--] COMMAND…: options (--json, --run, --claude, --to SESSION) only before the command,
    so `schedule 15 ls -la` keeps its -la and a command ending in --json keeps it. None when WHEN is missing, an option
    is unknown, --to has no session, or --run comes with --claude or --to."""
    a = argparse.Namespace(cmd="add", json=False, run=False, claude=False, to=None, when=None, command=[])
    skip = False
    for i, w in enumerate(argv):
        if skip:
            skip = False
            continue
        if w in ("--json", "--run", "--claude"):
            setattr(a, w[2:], True)
        elif w == "--to" or w.startswith("--to="):
            a.to = w[5:] if w.startswith("--to=") else (argv[i + 1] if i + 1 < len(argv) else "")
            if not a.to.strip():
                return None
            skip = w == "--to"
        elif w == "--":
            a.command = argv[i + 1:]
            break
        elif a.when is None and not w.startswith("-"):
            a.when = w
        elif a.when is not None:
            a.command = argv[i:]
            break
        else:
            return None
    if a.run and (a.claude or a.to):
        return None
    return a if a.when is not None else None


def cmd_send(argv):
    """[--to SESSION] [--] MESSAGE…: a message's run, or one sent now by hand. SESSION as the row keeps it (an id or a
    name: schedule_claude.target); what happened goes to stdout, the run's notification shows its last line."""
    to = None
    if argv[:1] == ["--to"] and len(argv) > 1:
        to, argv = argv[1], argv[2:]
    if argv[:1] == ["--"]:
        argv = argv[1:]
    text = claude.message(argv)
    if not text:
        die("What to send: schedule send [--to SESSION] MESSAGE", 2)
    found = claude.sessions()
    if to and not claude.pick(to, found):   # typed by hand: a part of a name, as an add takes it
        try:
            to = claude.target(to, found)
        except claude.Ambiguous as e:
            die(str(e), 2)
        except ValueError:
            pass   # none has it: a new session of that name, as for a row whose sessions are gone
    code, said = claude.deliver(to, text, found)
    print(said)
    sys.exit(code)


def main():
    p = argparse.ArgumentParser(prog="nightdrive schedule", description=__doc__.split("\n\n")[0],
                                formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split("\n\n")[1])
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("add")   # parsed by parse_add: the command's own options aren't argparse's
    sub.add_parser("send")  # parsed by cmd_send: the message's words are its own
    ls = sub.add_parser("list")
    ls.add_argument("--json", action="store_true")
    for name in ("show", "cancel"):
        s = sub.add_parser(name)
        s.add_argument("id")
        s.add_argument("--json", action="store_true")
    for name in ("run", "ask"):
        sub.add_parser(name).add_argument("id")
    fire = sub.add_parser("fire")
    fire.add_argument("id")
    fire.add_argument("--now", action="store_true")
    for name in ("restore", "woke", "unlocked"):
        sub.add_parser(name)
    argv = sys.argv[1:]
    first = next((w for w in argv if not w.startswith("-")), None)   # past a leading --json
    if any(w in ("-h", "--help") for w in argv[:1]):
        pass
    elif first is None:
        argv = ["list", *argv]          # `schedule` or `schedule --json`: the list
    elif first in sub.choices:
        argv.remove(first)
        argv = [first, *argv]           # `schedule --json list`
    else:
        argv = ["add", *argv]           # `schedule 15 make`, `schedule --json wake make`
    if argv[0] == "send":
        return cmd_send(argv[1:])
    if argv[0] == "add":
        a = parse_add(argv[1:])
        if a is None:
            p.print_help(sys.stderr)
            sys.exit(2)
    else:
        a = p.parse_args(argv)
    {"add": cmd_add, "list": cmd_list, "show": cmd_show, "run": cmd_run, "cancel": cmd_cancel, "fire": cmd_fire,
     "restore": cmd_restore, "ask": cmd_ask, "woke": cmd_woke, "unlocked": cmd_unlocked}[a.cmd](a)


if __name__ == "__main__":
    main()
