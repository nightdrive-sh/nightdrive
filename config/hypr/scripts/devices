#!/bin/bash
# Bluetooth and the battery as JSON, for scripts and Claude's tools (config/mcp/tools/sound-display.json); the top bar's
# icons (topbar/scripts/status) show the same. Read only.
#   devices bluetooth   {available, powered, connected: [{name, mac, battery}], paired: [{name, mac}]}
#                       battery is the device's own percentage when it reports one (headphones, a mouse), else null
#   devices battery     {present, percent, state, time_left, power_w, health}: state charging, discharging,
#                       fully-charged or pending-charge; time_left as UPower says it ("2.9 hours"), to empty or to full;
#                       health the capacity left of the design's, in percent; low_power: Low Power Mode on (low-power).
#                       {present: false} on a desktop
set -euo pipefail

# The same battery the top bar shows: the machine's own, not a Bluetooth mouse's (scope Device)
battery_path() {
  local d
  for d in /sys/class/power_supply/*; do
    [[ $(cat "$d/type" 2>/dev/null) == Battery && $(cat "$d/scope" 2>/dev/null) != Device ]] || continue
    local n=${d##*/}; echo "/org/freedesktop/UPower/devices/battery_${n//-/_}"; return
  done
}

# bluetoothctl's lines without its colours: "MAC name"
bt_list() { bluetoothctl devices "$1" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk '$1 == "Device" { $1 = ""; sub(/^ /, ""); print }'; }

case ${1:-} in
  bluetooth)
    # Without an adapter (a VM, the sandbox) bluetooth.service is stopped and bluetoothctl would wait forever
    if ! systemctl is-active -q bluetooth 2>/dev/null || ! show=$(timeout 2 bluetoothctl show 2>/dev/null) || [[ -z $show ]]; then
      echo '{"available": false, "powered": false, "connected": [], "paired": []}'; exit 0
    fi
    powered=$(grep -q 'Powered: yes' <<<"$show" && echo true || echo false)
    connected=$(bt_list Connected | while read -r mac name; do
      pct=$(timeout 2 bluetoothctl info "$mac" 2>/dev/null | sed -nE 's/.*Battery Percentage: .*\(([0-9]+)\).*/\1/p' | head -n1)
      jq -nc --arg n "$name" --arg m "$mac" --arg p "$pct" '{name: $n, mac: $m, battery: ($p | tonumber? // null)}'
    done | jq -sc .)
    paired=$(bt_list Paired | while read -r mac name; do jq -nc --arg n "$name" --arg m "$mac" '{name: $n, mac: $m}'; done | jq -sc .)
    jq -nc --argjson p "$powered" --argjson c "$connected" --argjson a "$paired" \
      '{available: true, powered: $p, connected: $c, paired: $a}' ;;
  battery)
    dev=$(battery_path)
    [[ -n $dev ]] || { echo '{"present": false}'; exit 0; }
    info=$(upower -i "$dev" 2>/dev/null) || true
    grep -q 'percentage:' <<<"$info" || { echo "UPower isn't running, so the battery can't be read." >&2; exit 1; }
    low=$([[ $("${0%/*}/low-power" status) == on ]] && echo true || echo false)
    awk -F': *' -v low="$low" '
      { gsub(/^ +/, "", $1) }
      $1 == "percentage"     { pct = $2 + 0 }
      $1 == "state"          { st = $2 }
      $1 ~ /^time to /       { left = $2 }
      $1 == "energy-rate"    { rate = $2 + 0 }
      $1 == "capacity"       { cap = $2 + 0 }
      END {
        printf "{\"present\": true, \"percent\": %d, \"state\": \"%s\", \"time_left\": %s, \"power_w\": %.1f, \"health\": %d, \"low_power\": %s}\n",
          pct, st, left == "" ? "null" : "\"" left "\"", rate, cap + 0.5, low
      }' <<<"$info" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
