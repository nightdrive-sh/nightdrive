#!/bin/bash
# dictate <start|stop>: F5 (speech to text). If the mic is muted, don't start recording; show a "MIC MUTED" toast instead.
# dictate daemon: started at login (hyprland.lua) with the best Parakeet model that is installed.
# dictate <fn-down|fn-up>: Fn held. Starts only after 0.3 s so that Fn combos (Fn+arrows, Fn+Backspace …) don't trigger dictation.
# dictate claude-start, claude-fn-down: ⌘⇧ + the key (Dashboard #1908): the text goes to the launcher's Ask Claude field
#   instead of being typed, to check and send with Enter (a terminal's Claude Code when its tools aren't set up). Any
#   release of the key stops it (stop, fn-up).
vt="$HOME/.local/bin/voxtype-onnx"
run=${XDG_RUNTIME_DIR:-/run/user/$UID}
models="$HOME/.local/share/voxtype/models"
# The full model gets English names and sentence breaks clearly better than int8 (0.3 s slower), but it's an extra
# 2.4 GB download (docs/dictation.md), so config.toml keeps int8 and this picks the full one when it's there.
FULL_MODEL=parakeet-tdt-0.6b-v3
# Your own cleanup of the text before it's typed (not in the repo, docs/dictation.md): text in on stdin, out on stdout
POST_PROCESS="$HOME/.config/voxtype/post-process"
scripts=$(dirname "$(readlink -f "$0")")
claude_txt="$run/dictate-claude.txt"   # where a dictation to Claude is written, and a sign that one is going on
case $1 in
  daemon)
    # A daemon that is killed (pkill, an update) leaves its OSD running: each restart added one more Quickshell. The
    # new daemon starts its own, so close those whose daemon is gone.
    for p in $(pgrep -u "$USER" -f '[q]s -p .*/voxtype/quickshell'); do
      parent=$(ps -o ppid= -p "$p" | tr -d ' ')
      [[ $(ps -o comm= -p "${parent:-1}") == voxtype* ]] || kill "$p"
    done
    # Both go into a copy of the config: the daemon ignores --model, and Voxtype's config has no include
    conf="$HOME/.config/voxtype/config.toml"
    if [[ -d $models/$FULL_MODEL || -x $POST_PROCESS ]]; then
      {
        if [[ -d $models/$FULL_MODEL ]]; then sed "s/^model = \"$FULL_MODEL-int8\"/model = \"$FULL_MODEL\"/" "$conf"; else cat "$conf"; fi
        if [[ -x $POST_PROCESS ]]; then printf '\n[output.post_process]\ncommand = "%s"\ntimeout_ms = 2000\n' "$POST_PROCESS"; fi
      } > "$run/voxtype-config.toml"
      exec "$vt" -c "$run/voxtype-config.toml" daemon
    fi
    exec "$vt" daemon ;;
  fn-down|claude-fn-down)
    start=start; [[ $1 == claude-* ]] && start=claude-start
    touch "$run/dictate-fn"
    ( sleep 0.3; [[ -e $run/dictate-fn ]] && { touch "$run/dictate-fn-active"; "$0" "$start"; } ) & ;;
  fn-up)
    rm -f "$run/dictate-fn"
    [[ -e $run/dictate-fn-active ]] && { rm -f "$run/dictate-fn-active"; "$0" stop; } ;;
  start|claude-start)
    rm -f "$claude_txt"
    # Without Claude Code it's plain dictation: there's nothing else the text could go to
    file=(); [[ $1 == claude-start && -x $HOME/.local/bin/claude ]] && { : >"$claude_txt"; file=(--file="$claude_txt"); }
    if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | grep -q MUTED; then
      qs ipc call osd micblocked
      touch "$run/dictate-blocked"
    else
      rm -f "$run/dictate-blocked"
      "$vt" record start "${file[@]}" >/dev/null 2>&1
    fi ;;
  stop)
    # If the start was blocked, there is nothing to stop
    if [[ -e $run/dictate-blocked ]]; then rm -f "$run/dictate-blocked" "$claude_txt"
    elif [[ -e $claude_txt ]]; then
      # --wait returns once the text is in the file (or it gave up: no text, nothing asked)
      "$vt" record stop --wait --timeout 60 >/dev/null 2>&1
      text=$(<"$claude_txt"); rm -f "$claude_txt"
      text=${text#"${text%%[![:space:]]*}"}; text=${text%"${text##*[![:space:]]}"}
      [[ -n $text ]] || exit 0
      if "$scripts/ask-claude" --ready; then qs ipc call launcher askClaudeDraft "$text"
      else exec "$scripts/terminal-or-claude" -- "$text"; fi
    else "$vt" record stop >/dev/null 2>&1; fi ;;
esac
