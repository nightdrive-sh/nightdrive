#!/bin/bash
# Wi-Fi and the network as JSON, and turning them off or on (NetworkManager), for scripts and Claude's tools
# (config/mcp/tools/sound-display.json); the Wi-Fi menu (WifiMenu.qml) shows the same.
#   network                         {networking, wifi, connections: [{name, type, device}], wifi_network: {ssid,
#                                   signal}, link: {…}}: networking and wifi "on"/"off"; link is wifi-info's
#                                   (band, standard, rate, ip, ping to the router…), {} without Wi-Fi
#   network wifi|all on|off [--keep]
#                                   the Wi-Fi radio, or all networking (wired too), on or off; prints {what, was, now}.
#                                   --keep then asks on Nightdrive's card whether to keep it, and turns it back on
#                                   unless the user does (config/mcp/keep.py): the way to turn it off from Claude,
#                                   whose own connection goes with it
set -euo pipefail
here=$(dirname "$(readlink -f "$0")")
repo=$(cd "$here/../../.." && pwd)

state() {   # "on"/"off" of wifi or all
  if [[ $1 == wifi ]]; then nmcli radio wifi; else nmcli networking; fi | sed 's/enabled/on/; s/disabled/off/'
}

nmcli -t general >/dev/null 2>&1 || { echo "NetworkManager isn't running on this machine: Nightdrive can't see or set the network." >&2; exit 1; }

case ${1:-} in
  "")
    conns=$(nmcli -t -f NAME,TYPE,DEVICE connection show --active 2>/dev/null |
      awk -F: '$2 != "loopback" && $2 != "bridge" { gsub(/\\:/, ":"); print }' |
      while IFS=: read -r name type dev; do
        jq -nc --arg n "$name" --arg t "${type#802-11-}" --arg d "$dev" '{name: $n, type: (if $t == "wireless" then "wifi" elif $t == "802-3-ethernet" then "ethernet" else $t end), device: $d}'
      done | jq -sc .)
    wnet=$(nmcli -t -f IN-USE,SIGNAL,SSID device wifi list --rescan no 2>/dev/null |
      awk -F: '$1 == "*" { s = $2; sub(/^[^:]*:[^:]*:/, ""); print s "\t" $0; exit }')
    link=$("$here/wifi-info" 2>/dev/null || echo '{}')
    jq -nc --arg net "$(state all)" --arg w "$(state wifi)" --argjson c "$conns" --arg wn "$wnet" --argjson l "${link:-\{\}}" \
      '{networking: $net, wifi: $w, connections: $c,
        wifi_network: (if $wn == "" then null else ($wn | split("\t") | {ssid: .[1], signal: (.[0] | tonumber? // null)}) end),
        link: $l}' ;;
  wifi|all)
    what=$1 to=${2:-}; keep=${3:-}
    [[ $to == on || $to == off ]] || { echo "usage: network $what on|off [--keep]" >&2; exit 1; }
    was=$(state "$what")
    if [[ $what == wifi ]]; then nmcli radio wifi "$to"; else nmcli networking "$to"; fi
    out=$(jq -nc --arg w "$what" --arg was "$was" --arg now "$(state "$what")" '{what: $w, was: $was, now: $now}')
    # Asking only makes sense when something changed; going back is to what it was
    if [[ $keep == --keep && $was != "$to" ]]; then
      label=$([[ $what == wifi ]] && echo "Wi-Fi" || echo "All networking")
      exec python3 "$repo/config/mcp/keep.py" --title "Keep $label $to?" --field "$label" "$to (was $was)" \
        --with "$out" -- "$here/network" "$what" "$was"
    fi
    echo "$out" ;;
  *) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
