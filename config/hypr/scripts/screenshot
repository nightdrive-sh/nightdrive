#!/bin/bash
# screenshot region   → region: saved to ~/Pictures/Screenshots (the localised Pictures folder) and the clipboard (launcher → Screenshot)
# screenshot window   → click a window on the current workspace: saved and to the clipboard (launcher)
# screenshot full     → whole screen: saved and to the clipboard (launcher)
# screenshot clip     → region to the clipboard only, no file (⌘⇧S)
# screenshot winclip  → window to the clipboard only, no file (⌘⌥S)
# screenshot fullclip → whole screen to the clipboard only, no file (⌘⌥⇧S)
mode=${1:-full}

# A selection is already running (slurp open): a second press cancels it instead of starting a new capture
if [[ $mode != full && $mode != fullclip ]] && pgrep -x slurp >/dev/null; then pkill -x slurp; exit 0; fi

# Pick a window by clicking: the current workspace's window bounds go to slurp (-r: only these boxes are selectable)
pick_window() {
  local ws
  ws=$(hyprctl -j activeworkspace | jq .id)
  hyprctl -j clients | jq -r --argjson ws "$ws" \
    '.[] | select(.workspace.id == $ws and .mapped and (.hidden | not)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' \
    | slurp -r
}

# The notification: "Screenshot" with the launcher's glyph for the kind (Tools › Screenshot: crop, app-window, monitor),
# the picture under the text (category x-nightdrive.preview: quickshell/NotificationCard.qml). Straight over D-Bus:
# notify-send -i sets the picture, not the app's icon. The picture is a file:// URI (a bare path is taken as an icon name).
# It doesn't chime (suppress-sound): the shutter has played as the picture was taken.
# Usage: notify <picture> <text> <glyph>
notify() {
  gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
    --method org.freedesktop.Notifications.Notify Screenshot 0 "lucide:$3" \
    "$2" "" "[]" "{'category': <'x-nightdrive.preview'>, 'image-path': <'file://$1'>, 'suppress-sound': <true>}" 'int32 -1' >/dev/null   # (as text: a bare -1 would be an option)
}

# The shutter (system/screenshot.wav), as soon as grim has the picture
shutter() { "$HOME/.config/hypr/scripts/sounds" event screenshot & }

# Clipboard only: the picture for the notification's preview in the runtime dir (gone at logout)
clip=${XDG_RUNTIME_DIR:-/tmp}/screenshots
case "$mode" in
  clip|winclip|fullclip)
    case $mode in
      clip)    geom=$(slurp) || exit 0; what=Region; glyph=crop ;;
      winclip) geom=$(pick_window) || exit 0; what=Window; glyph=app-window ;;
      *)       geom=""; what=Screen; glyph=monitor ;;
    esac
    mkdir -p "$clip"; find "$clip" -name '*.png' -mmin +60 -delete 2>/dev/null
    f=$clip/$(date +%H-%M-%S-%N).png
    grim ${geom:+-g "$geom"} "$f" && shutter && wl-copy --type image/png < "$f"
    notify "$f" "$what copied to clipboard" "$glyph"; exit 0 ;;
esac

dir="$(xdg-user-dir PICTURES)/Screenshots"   # e.g. ~/Kuvat on a Finnish system
mkdir -p "$dir"
file=$dir/$(date +%Y-%m-%d_%H-%M-%S).png
case "$mode" in
  region) geom=$(slurp) || exit 0;        grim -g "$geom" "$file"; glyph=crop ;;
  window) geom=$(pick_window) || exit 0;  grim -g "$geom" "$file"; glyph=app-window ;;
  *)      grim "$file"; glyph=monitor ;;
esac
[[ -s $file ]] && shutter
wl-copy < "$file"
notify "$file" "Saved and copied to clipboard" "$glyph"
