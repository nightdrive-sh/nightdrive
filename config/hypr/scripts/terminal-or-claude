#!/bin/bash
# ⌘⌥Enter: if the launcher is open with text typed in it, send that to Claude Code; otherwise open an empty Claude.
# terminal-or-claude [--dir DIR] [--name NAME] [--effort LEVEL] [--background] [--workspace WS] [--] [PROMPT…]: start Claude Code with
# that prompt, in DIR (~/Projects unless given), the session named NAME (claude -n, as /rename), at effort LEVEL
# (claude --effort). --background opens its window without the keyboard, so typing elsewhere isn't cut off (a session
# another session starts, e.g. the project manager's): its class has a no_initial_focus rule in hyprland.lua, and a
# notification says it opened, a click on it going to the window. It opens on the workspace of the window it was called
# from (found up the process chain: the project manager's terminal), even if the user has moved to another one since;
# called from no window, on the active one. --workspace WS (a number or special:NAME) names the workspace instead.
# The launcher's askClaude, crash reports and `nightdrive ask` call this.
readonly BG_CLASS=claude-background   # hyprland.lua's rule, and TERMINAL_CLASSES in bindings.lua
readonly BG_WAIT=15                   # seconds to wait for the window before giving up on the notification
dir="$HOME/Projects"; name=; effort=; bg=0; ws=; bare=$(( $# == 0 ))
while (( $# )); do
  case $1 in
    --dir) [[ -n ${2:-} ]] || { echo "--dir needs a folder" >&2; exit 1; }; dir=$2; shift 2 ;;
    --name) [[ -n ${2:-} ]] || { echo "--name needs a name" >&2; exit 1; }; name=$2; shift 2 ;;
    # checked here: a wrong level would only show as an error in the new terminal
    --effort) [[ ${2:-} =~ ^(low|medium|high|xhigh|max)$ ]] || { echo "--effort needs low, medium, high, xhigh or max" >&2; exit 1; }
              effort=$2; shift 2 ;;
    --background) bg=1; shift ;;
    # it goes into a Lua string in hyprctl dispatch: no quotes or spaces
    --workspace) [[ ${2:-} =~ ^(-?[0-9]+|special(:[A-Za-z0-9_-]+)?)$ ]] || { echo "--workspace needs a number or special:NAME" >&2; exit 1; }
                 ws=$2; shift 2 ;;
    --) shift; break ;;
    -*) echo "Unknown option: $1 (usage: nightdrive ask [--dir DIR] [--name NAME] [--effort LEVEL] [--background] [--workspace WS] MESSAGE)" >&2; exit 1 ;;
    *) break ;;
  esac
done
# the terminal would quietly fall back to ~ in a folder that doesn't exist
[[ -d $dir ]] || { echo "No such folder: $dir" >&2; exit 1; }
dir=$(cd "$dir" && pwd)   # relative to where it was called, before the terminal starts elsewhere
# clear inherited CLAUDE* variables so the new Claude doesn't think it's a child session
for v in $(compgen -e | grep '^CLAUDE'); do unset "$v"; done
term="$HOME/.config/hypr/scripts/terminal"   # the terminal chosen in Default apps
claude=("$HOME/.local/bin/claude")
[[ -n $name ]] && claude+=(-n "$name")
[[ -n $effort ]] && claude+=(--effort "$effort")
(( $# )) && claude+=(-- "$*")
if (( bare )); then
  [ "$(qs ipc call launcher askClaude 2>/dev/null)" = "ok" ] && exit 0
  exec "$term" --dir "$dir" -- "${claude[@]}"
fi
bg_windows() {   # the addresses of the background sessions' windows (Ghostty's class has a prefix: scripts/terminal)
  hyprctl -j clients 2>/dev/null | jq -r --arg c "$BG_CLASS" '.[] | select(.class | sub("^sh\\.nightdrive\\."; "") == $c) | .address'
}
# The workspace of the first window up the process chain (own PID → parents), as hyprctl dispatch takes it; nothing when
# none is a window's (the launcher, a script started by a key)
caller_workspace() {
  local pid=$$ clients w
  clients=$(hyprctl -j clients 2>/dev/null) || return
  while [[ $pid =~ ^[0-9]+$ ]] && (( pid > 1 )); do
    w=$(jq -r --argjson p "$pid" 'first(.[] | select(.pid == $p) | .workspace
          | if .id < 0 then .name else (.id | tostring) end) // empty' <<<"$clients")
    [[ -n $w ]] && { [[ $w =~ ^(-?[0-9]+|special(:[A-Za-z0-9_-]+)?)$ ]] && echo "$w"; return; }
    pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
  done
}
targs=(--dir "$dir")
if (( bg )); then targs+=(--class "$BG_CLASS"); before=$(bg_windows); [[ -n $ws ]] || ws=$(caller_workspace); fi
if [[ -n $ws ]]; then
  # Started by Hyprland with an exec rule, which puts the window there without switching the user's view (it matches the
  # terminal's PID: the launch script and scripts/terminal exec into it). The arguments go through a script that removes
  # itself, as a prompt can hold anything, quotes and newlines too, and wouldn't survive a Lua string.
  launch=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/nightdrive-ask.XXXXXX") || exit 1
  { echo 'rm -f -- "$0"'; printf 'exec'; printf ' %q' "$term" "${targs[@]}" -- "${claude[@]}"; echo ' >/dev/null 2>&1'; } > "$launch"
  hyprctl dispatch "hl.dsp.exec_cmd(\"bash $launch\", { workspace = \"$ws silent\" })" >/dev/null
else
  # detached: `nightdrive ask` returns at once, and the terminal's own messages stay out of the shell it was run from
  setsid -f "$term" "${targs[@]}" -- "${claude[@]}" >/dev/null 2>&1
fi
(( bg )) || exit 0

# The notification, once the new window is there (the one not among the earlier ones), detached as well: it waits for
# its click, which goes to the window and its workspace. A terminal that opens its windows from a process of its own
# (Ghostty's single instance) escapes the exec rule: the window is moved there then, silently. The same icon as
# claude-notify's.
icon=lucide:bot
for f in "$HOME"/.config/nightdrive/agent-icon.{svg,png}; do [[ -f $f ]] && { icon=$f; break; }; done
prompt=$*; prompt=${prompt%%$'\n'*}; (( ${#prompt} > 120 )) && prompt="${prompt:0:120}…"
project=${dir/#$HOME/\~}
export BG_CLASS BG_WAIT before icon ws
export -f bg_windows
setsid -f bash -c '
  for (( i = 0; i < BG_WAIT * 4; i++ )); do
    addr=$(comm -13 <(sort <<<"$before") <(bg_windows | sort) | head -n1)
    [[ -n $addr ]] && break
    sleep 0.25
  done
  [[ -n $addr ]] || exit 0
  if [[ -n $ws ]]; then
    at=$(hyprctl -j clients | jq -r --arg a "$addr" ".[] | select(.address == \$a) | .workspace | if .id < 0 then .name else (.id | tostring) end")
    [[ $ws =~ ^-?[0-9]+$ ]] && target=$ws || target="\"$ws\""
    [[ -n $at && $at != "$ws" ]] && hyprctl dispatch "hl.dsp.window.move({ workspace = $target, follow = false, window = \"address:$addr\" })" >/dev/null
  fi
  action=$(notify-send -a Claude -i "$icon" -A default=Open -A show="Show session" -w "Claude session opened: $1" "$2")
  [[ $action == default || $action == show ]] && hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
' _ "${name:-${dir##*/}}" "${prompt:+$prompt · }$project" >/dev/null 2>&1 < /dev/null
