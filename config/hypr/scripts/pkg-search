#!/usr/bin/python3 -I
"""Software search for the launcher (Install › Software): Fedora's packages (dnf) and Flathub's apps in one list.
  pkg-search <query>
  pkg-search --list popular|<category>   a list from software.json (software-catalog) for Install › Software's Browse
Output (JSON): { apps: [row], tools: [row] }, row = { name, summary, src: dnf|flatpak, id, icon, installed, alt, glyph? }
- apps: what has AppStream data (a desktop app). One app is one row even when both have it, matched by its AppStream id
  (org.gnome.Calculator): Fedora's package first (it follows the GTK theme and updates with the system), Flathub's
  then in alt ({ src, id }). What only Flathub has comes from there.
- tools: Fedora packages without AppStream data (command-line tools), without libraries and development packages.
- --list: the most installed of Flathub's apps that this machine's architecture has (platform arch), in the same rows:
  Fedora's package first when Fedora has the app. The category's EXTRA rows (e.g. Asahi's Steam) come first.
Fedora's AppStream catalog (/usr/share/swcatalog) is read once into ~/.cache/nightdrive/swcatalog.json."""
import glob, gzip, json, os, re, subprocess, sys
import xml.etree.ElementTree as ET

LANG = "{http://www.w3.org/XML/1998/namespace}lang"
CACHE = os.path.expanduser("~/.cache/nightdrive/swcatalog.json")
FEDORA_ICONS = "/usr/share/swcatalog/icons/fedora/64x64"
HERE = os.path.dirname(os.path.realpath(__file__))
SOFTWARE = os.path.join(HERE, "../../quickshell/data/software.json")
MAX_APPS, MAX_TOOLS = 25, 20
DNF_TIMEOUT = 60                                  # seconds: a metadata refresh on a slow line takes a while
# Packages nobody installs by hand: libraries, development files, language modules, debug data
NOT_TOOLS = re.compile(r"(^lib|-(devel|libs?|doc|docs|static|debuginfo|debugsource|tests?|common|data|headers|javadoc)$"
                       r"|^(perl|python3|rust|golang|ghc|texlive|mingw\d*|R|php|nodejs|ocaml|lua|ruby|rubygem)-)")


def appid(i):
    return re.sub(r"\.desktop$", "", i or "").lower()


def catalog():
    """Fedora's AppStream catalog: pkgname → [appstream id, name, summary, icon file, keywords] (cached by mtime)"""
    files = sorted(glob.glob("/usr/share/swcatalog/xml/*.xml.gz"))
    stamp = [os.path.getmtime(f) for f in files]
    try:
        with open(CACHE) as fh:
            c = json.load(fh)
        if c.get("stamp") == stamp:
            return c["pkgs"]
    except (OSError, ValueError):
        pass
    pkgs = {}
    for f in files:
        try:
            for _, el in ET.iterparse(gzip.open(f)):
                if el.tag != "component":
                    continue
                pkg = el.findtext("pkgname")
                if pkg and el.get("type") in ("desktop-application", "desktop", "console-application", "web-application"):
                    own = lambda t: next((c.text or "" for c in el.findall(t) if c.get(LANG) is None), "")
                    icon = next((i.text for i in el.findall("icon") if i.get("type") == "cached" and i.text), "")
                    kw = " ".join(k.text or "" for k in el.findall("keywords/keyword") if k.get(LANG) is None)
                    pkgs.setdefault(pkg, [el.findtext("id") or "", own("name").strip(), own("summary").strip(), icon, kw])
                el.clear()
        except (OSError, ET.ParseError):
            continue
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    with open(CACHE + ".tmp", "w") as fh:
        json.dump({"stamp": stamp, "pkgs": pkgs}, fh)
    os.replace(CACHE + ".tmp", CACHE)
    return pkgs


def flathub_icon(fid):
    dirs = glob.glob(os.path.expanduser("~/.local/share/flatpak/appstream/flathub/*/active/icons/64x64"))
    return next((p for p in (os.path.join(d, fid + ".png") for d in dirs) if os.path.exists(p)), "")


def fedora_icon(icon):
    path = os.path.join(FEDORA_ICONS, icon) if icon else ""
    return path if path and os.path.exists(path) else ""


def installed():
    """What's installed: (rpm package names, the user's Flatpak app ids)"""
    rpms = subprocess.run(["rpm", "-qa", "--qf", "%{NAME}\n"], capture_output=True, text=True).stdout
    fpl = subprocess.run(["flatpak", "list", "--app", "--user", "--columns=application"], capture_output=True, text=True).stdout
    return set(rpms.split()), set(fpl.split())


def listing(key):
    with open(SOFTWARE) as fh:
        sw = json.load(fh)
    plat = subprocess.run([os.path.join(HERE, "platform")], capture_output=True, text=True).stdout.split()
    arch, name = (plat + ["", ""])[:2]
    picked = [a for a in sw["apps"] if arch in a["arches"] and (key == "popular" or a["category"] == key)]
    picked = picked[:sw["popular"] if key == "popular" else sw["perCategory"]]
    extra = [e for e in sw["extra"] if e["category"] == key and e.get("platform", name) == name and e.get("arch", arch) == arch]
    cat = catalog()
    fedora = {appid(aid): pkg for pkg, (aid, *_) in cat.items() if aid}    # AppStream id → Fedora's package
    rpms, fps = installed()
    # A Fedora package's own icon when its AppStream data has one (kitty), the glyph otherwise (foot)
    rows = [{"name": e["name"], "summary": e["summary"], "src": e["src"], "id": e["id"],
             "icon": fedora_icon(cat[e["id"]][3]) if e["src"] == "dnf" and e["id"] in cat else "", "glyph": e.get("glyph"),
             "installed": e["id"] in (rpms if e["src"] == "dnf" else fps), "alt": None} for e in extra]
    for a in picked:
        pkg = fedora.get(appid(a["id"]))
        # Already first as an EXTRA row: by package, or by name when the ids differ (Flathub's Ptyxis is app.devsuite.Ptyxis,
        # Fedora's org.gnome.Ptyxis)
        if pkg in {e["id"] for e in extra} or a["name"].lower() in {e["name"].lower() for e in extra}:
            continue
        if pkg:
            _, fname, fsum, icon, _ = cat[pkg]
            rows.append({"name": fname or a["name"], "summary": fsum or a["summary"], "src": "dnf", "id": pkg, "icon": fedora_icon(icon),
                         "installed": pkg in rpms, "alt": {"src": "flatpak", "id": a["id"]}})
        else:
            rows.append({"name": a["name"], "summary": a["summary"], "src": "flatpak", "id": a["id"], "icon": flathub_icon(a["id"]),
                         "installed": a["id"] in fps, "alt": None})
    return {"apps": rows, "tools": []}


def main(q):
    # The slow ones in parallel: dnf's and Flathub's search, and what's installed. No stdin: dnf asks on it whether to
    # import a new repo's signing key ("Is this ok [y/N]") and would wait for an answer that never comes (the launcher
    # stays at "Searching…"); with none it gets a no, and still searches the other repos.
    dnf = subprocess.Popen(["dnf", "repoquery", "--available", "-q", "--latest-limit=1",
                            "--queryformat", "%{name}|%{summary}\n", f"*{q}*"], stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    # -- : a search for "--columns=…" or "-h" is a word to look for, not an option (Claude's software_search too)
    fp = subprocess.Popen(["flatpak", "search", "--columns=application,name,description,remotes", "--", q],
                          stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    rpms = subprocess.Popen(["rpm", "-qa", "--qf", "%{NAME}\n"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    fpl = subprocess.Popen(["flatpak", "list", "--app", "--user", "--columns=application"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    cat = catalog()

    found = {}                                    # dnf: name → summary
    try:
        out = dnf.communicate(timeout=DNF_TIMEOUT)[0]
    except subprocess.TimeoutExpired:             # e.g. a slow mirror: Flathub's and the catalog's matches still show
        dnf.kill()
        out = ""
    for line in out.splitlines():
        name, _, summary = line.partition("|")
        if name:
            found.setdefault(name, summary)
    # Apps whose name or keywords match but whose package name doesn't ("image" → loupe)
    for pkg, (_, name, summary, _, kw) in cat.items():
        if pkg not in found and (q in name.lower() or q in kw.lower()):
            found[pkg] = summary
    installed_rpm = set(rpms.communicate()[0].split())
    installed_fp = set(fpl.communicate()[0].split())

    apps, tools = {}, []
    for pkg, summary in found.items():
        if pkg in cat:
            aid, name, asum, icon, _ = cat[pkg]
            key = appid(aid) or pkg
            if key in apps:
                continue
            apps[key] = {"name": name or pkg, "summary": asum or summary, "src": "dnf", "id": pkg,
                         "icon": fedora_icon(icon), "installed": pkg in installed_rpm, "alt": None}
        elif not NOT_TOOLS.search(pkg):
            tools.append({"name": pkg, "summary": summary, "src": "dnf", "id": pkg, "icon": "",
                          "installed": pkg in installed_rpm, "alt": None})

    # Flathub has runtimes and extensions too; only apps are installable on their own, and their ids don't look like these
    skip = re.compile(r"^\S*\.(Platform|Sdk|BaseApp|Extension|Plugin|Plugins|Codecs|GL|Gtk3theme)(\.|$)")
    for line in fp.communicate()[0].splitlines():
        f = line.split("\t")
        if len(f) < 4 or "flathub" not in f[3].split(",") or skip.search(f[0]):
            continue
        fid, name, desc = f[0], f[1], f[2]
        key = appid(fid)
        if key in apps:                           # Fedora has it too: Flathub's is the alternative
            if apps[key]["src"] == "dnf" and not apps[key]["alt"]:
                apps[key]["alt"] = {"src": "flatpak", "id": fid}
            continue
        apps[key] = {"name": name, "summary": desc, "src": "flatpak", "id": fid, "icon": flathub_icon(fid),
                     "installed": fid in installed_fp, "alt": None}

    # An exact name first, then what has the words in its name or summary, the most installed first (Flathub's last month,
    # software.json's top 1000: "browser" → Firefox, not GdaBrowser), then what Flathub matched elsewhere (its long
    # description: "email" → a VPN), in the same order
    with open(SOFTWARE) as fh:
        installs = {appid(a["id"]): a["installs"] for a in json.load(fh)["apps"]}

    def popularity(r):
        return max(installs.get(appid(r["id"]), 0), installs.get(appid((r["alt"] or {}).get("id")), 0),
                   installs.get(next((k for k, v in apps.items() if v is r), ""), 0))

    def rank(r):
        n = r["name"].lower()
        return (n != q, q not in n and q not in r["summary"].lower(), -popularity(r), not n.startswith(q), q not in n, len(n), n)
    return {"apps": sorted(apps.values(), key=rank)[:MAX_APPS], "tools": sorted(tools, key=rank)[:MAX_TOOLS]}


if len(sys.argv) == 3 and sys.argv[1] == "--list":
    print(json.dumps(listing(sys.argv[2])))
elif len(sys.argv) == 2:
    print(json.dumps(main(sys.argv[1].strip().lower())))
else:
    print("\n".join(__doc__.split("\n")[1:3]), file=sys.stderr)
    sys.exit(2)
