#!/usr/bin/python3 -I
"""Gathers the parts of the plugin folders that are on (installed) where the desktop reads them. `nightdrive plugins
installed` runs this with one line per such folder on stdin: id<TAB>folder.
  plugin-parts
Writes, in ~/.local/state/nightdrive/plugins.d (only when the content changes, so the file watches don't fire for nothing):
  active    the same id<TAB>folder lines: hypr/bindings.lua runs each folder's bindings.lua, hypr/scripts/shortcuts adds
            its SHORTCUTS.md
  bar.json  {modules, menus, sizes, levels} for Quickshell (TopBar.qml, shell.qml, Launcher.qml): module.jsonc's modules,
            with their commands run in the plugin's folder; the folder's <Name>Menu.qml files by menu name; the modules'
            icon sizes; the folder's <Name>Levels.qml files (the launcher's levels)
  icons/    links to the folders' own bar icons (icons/<name>.svg), which topbar/scripts/icon looks up after the core's:
            a plugin's icon can't replace a Lucide one or the bar's own
Outside the repo, so a read-only checkout (nightdrive sandbox) works too. Folders that aren't on aren't in any of them,
so their module, menu, icons, keys and shortcut lines don't show anywhere.
State, not cache: what is listed here runs (Hyprland loads each folder's Lua, the bar its commands and menus, the MCP
server its tools), so a cache cleaner or a rule that lets Claude write in ~/.cache mustn't change it (#1950). Until
11.2026 it was ~/.cache/nightdrive/plugins.d: the first run here removes that one."""
import glob, json, os, shlex, shutil, sys

OUT = os.path.expanduser("~/.local/state/nightdrive/plugins.d")
OLD = os.path.expanduser("~/.cache/nightdrive/plugins.d")    # before #1950
COMMANDS = ("status", "right", "middle", "drop")   # module.jsonc keys holding shell commands


def jsonc(path):
    """modules.jsonc's format: JSON with whole-line // comments."""
    with open(path) as f:
        return json.loads("\n".join(l for l in f.read().split("\n") if not l.lstrip().startswith("//")))


def write(name, text):
    path = os.path.join(OUT, name)
    try:
        if open(path).read() == text:
            return
    except OSError:
        pass
    with open(path + ".tmp", "w") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def icons(folders):
    """plugins.d/icons: a link per SVG in the folders' icons/, the first folder winning a name; stale links go."""
    out = os.path.join(OUT, "icons")
    want = {}
    for _pid, d in folders:
        for f in sorted(glob.glob(os.path.join(d, "icons", "*.svg"))):
            want.setdefault(os.path.basename(f), f)
    os.makedirs(out, exist_ok=True)
    for name in os.listdir(out):
        path = os.path.join(out, name)
        if not (os.path.islink(path) and os.readlink(path) == want.get(name)):
            os.remove(path)
    for name, f in want.items():
        if not os.path.lexists(os.path.join(out, name)):
            os.symlink(f, os.path.join(out, name))


def main():
    folders = [l.rstrip("\n").split("\t", 1) for l in sys.stdin if "\t" in l]
    modules, menus, sizes, levels = [], {}, {}, []
    for pid, d in folders:
        here = "cd " + shlex.quote(d) + " && "
        path = os.path.join(d, "module.jsonc")
        if os.path.exists(path):
            try:
                defs = jsonc(path)
            except (OSError, ValueError) as e:
                print(f"plugin-parts: {path}: {e}", file=sys.stderr)
                defs = []
            for m in defs if isinstance(defs, list) else [defs]:
                if not isinstance(m, dict):
                    continue
                m = dict(m)
                m.setdefault("name", pid)
                m["needs"] = pid             # implied: Plugins.has(id) hides it like a core module's "needs"
                if "status" not in m and os.access(os.path.join(d, "status"), os.X_OK):
                    m["status"] = "./status"
                for k in COMMANDS:
                    if isinstance(m.get(k), str) and m[k]:
                        m[k] = here + m[k]
                if isinstance(m.get("size"), (int, float)):
                    sizes[m["name"]] = m["size"]
                modules.append(m)
        for f in sorted(glob.glob(os.path.join(d, "[A-Z]*Menu.qml"))):
            base = os.path.basename(f)[:-len("Menu.qml")]
            menus[base[0].lower() + base[1:]] = f
        levels += sorted(glob.glob(os.path.join(d, "[A-Z]*Levels.qml")))
    os.makedirs(OUT, exist_ok=True)
    icons(folders)
    write("active", "".join(f"{pid}\t{d}\n" for pid, d in folders))
    write("bar.json", json.dumps({"modules": modules, "menus": menus, "sizes": sizes, "levels": levels}, indent=1) + "\n")
    shutil.rmtree(OLD, ignore_errors=True)   # once the new one is there: an old list nothing reads any more


if __name__ == "__main__":
    main()
