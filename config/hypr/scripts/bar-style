#!/bin/bash
# Top bar appearance (launcher Settings › Top bar opacity / Top bar icons). Values: ~/.local/state/bar-{opacity,icons}.
#   bar-style opacity [0-100]     prints / sets the background opacity (default 100)
#   bar-style icons [light|dark]  prints / sets the icon and text colour (default light = white)
#   bar-style highlight [theme|white|black]  prints / sets the highlight colour (active workspace, Deck playing, Claude waiting;
#                          default theme = theme colour, Settings › Theme › Color / hypr/scripts/theme)
#   bar-style icon-opacity [0-100] prints / sets the icon and text opacity (default 85; dimmed states are relative to this)
#   bar-style show --json         all four as {opacity, icons, highlight, icon_opacity}
#   bar-style set [--opacity N] [--icons X] [--highlight X] [--icon-opacity N] [--json]  several at once, applied once
#   bar-style apply               writes the bar colours and the shader copy (the theme script runs it too)
# ~/.cache/nightdrive/bar.json: background + named colours (fg, dim, off, hlBg, hlFg, actBg, wsBg); the bar (quickshell/TopBar.qml)
# watches the file, so changes show at once.
# In the shader copy (~/.cache/hypr/corners-<value>.frag) the top corners under the bar are as transparent as the bar.
set -euo pipefail
st="$HOME/.local/state"
cfg="$HOME/.config"
out="$HOME/.cache/nightdrive/bar.json"

opacity() { local v; v=$(cat "$st/bar-opacity" 2>/dev/null || true); [[ $v =~ ^[0-9]+$ && $v -le 100 ]] && echo "$v" || echo 100; }
iconop()  { local v; v=$(cat "$st/bar-icon-opacity" 2>/dev/null || true); [[ $v =~ ^[0-9]+$ && $v -le 100 ]] && echo "$v" || echo 85; }
highlight() { local v; v=$(cat "$st/bar-highlight" 2>/dev/null || true); [[ $v == white || $v == black ]] && echo "$v" || echo theme; }
# Theme colour: a role from theme.json (hypr/scripts/theme), defaulting to the original violet
tc() { jq -r --arg k "$1" '.[$k] // empty' "$HOME/.cache/nightdrive/theme.json" 2>/dev/null | grep . || echo "$2"; }
scheme()  { local v; v=$(cat "$st/bar-icons" 2>/dev/null || true); [[ $v == dark ]] && echo dark || echo light; }

apply() {
  local v a c ia ws act
  v=$(opacity); a=$(awk -v v="$v" 'BEGIN { printf "%.2f", v / 100 }')
  ia=$(awk -v v="$(iconop)" 'BEGIN { printf "%.2f", v / 100 }')     # icons and text
  if [[ $(scheme) == dark ]]; then c="#000000"; else c="#ffffff"; fi
  # ws = active workspace highlight, act = active state (Deck playing, Claude waiting); icons stay in the fg colour.
  # Theme colour with white icons (violet) = the original #35253d against black.
  case $(highlight) in
    white) ws="#ffffff 0.25"; act="#ffffff 0.18" ;;
    black) ws="#000000 0.30"; act="#000000 0.22" ;;
    *) if [[ $c == "#000000" ]]; then ws="$(tc deep "#5c247b") 0.30"; act="$(tc deep "#5c247b") 0.25"
       else ws="$(tc soft "#b17bcb") 0.30"; act="$(tc primary "#c071eb") 0.25"; fi ;;
  esac
  # Colours as #AARRGGBB (Qt). dim = empty workspaces, off = off / no data (relative to the icon opacity); the open
  # menu's highlight = the active workspace's, with the icon at full opacity.
  argb() { awk -v c="$1" -v a="$2" 'BEGIN { printf "#%02x%s", int(a * 255 + 0.5), substr(c, 2) }'; }
  mkdir -p "$(dirname "$out")"
  cat > "$out.tmp" <<JSON
{
 "bg": "$(argb "#000000" "$a")",
 "fg": "$(argb "$c" "$ia")",
 "dim": "$(argb "$c" "$(awk -v v="$ia" 'BEGIN { print v * 0.65 }')")",
 "off": "$(argb "$c" "$(awk -v v="$ia" 'BEGIN { print v * 0.4 }')")",
 "hlBg": "$(argb $ws)",
 "hlFg": "$c",
 "actBg": "$(argb $act)",
 "wsBg": "$(argb $ws)"
}
JSON
  mv "$out.tmp" "$out"
  # Written to a temp file and moved into place, only when it changed: at startup the theme script runs this while
  # Hyprland is compiling the shader, and a half-written file gave "error compiling shader 0:1(1): syntax error".
  if (( v < 100 )); then
    local frag="$HOME/.cache/hypr/corners-$v.frag"
    mkdir -p "$HOME/.cache/hypr"
    sed -E "s/^const float BAR = [0-9.]+;/const float BAR = $a;/" "$cfg/hypr/shaders/rounded-corners.frag" > "$frag.tmp"
    if cmp -s "$frag.tmp" "$frag"; then rm -f "$frag.tmp"; else mv "$frag.tmp" "$frag"; fi
  fi
}

show() {
  jq -n --argjson o "$(opacity)" --arg i "$(scheme)" --arg h "$(highlight)" --argjson io "$(iconop)" \
    '{opacity: $o, icons: $i, highlight: $h, icon_opacity: $io}'
}

case ${1:-} in
  apply) apply ;;
  show) show ;;
  set)
    # Every value is checked before any is written, so a wrong one changes nothing
    shift; declare -A new=(); json=0
    while (( $# )); do
      case $1 in
        --opacity|--icon-opacity) [[ ${2:-} =~ ^[0-9]+$ && $2 -le 100 ]] || { echo "$1: 0–100" >&2; exit 2; } ;;&
        --icons) [[ ${2:-} == light || ${2:-} == dark ]] || { echo "--icons: light|dark" >&2; exit 2; } ;;&
        --highlight) [[ ${2:-} =~ ^(theme|white|black)$ ]] || { echo "--highlight: theme|white|black" >&2; exit 2; } ;;&
        --opacity|--icon-opacity|--icons|--highlight) new[bar-${1#--}]=$2; shift 2 ;;
        --json) json=1; shift ;;
        *) echo "unknown: $1" >&2; exit 2 ;;
      esac
    done
    mkdir -p "$st"
    for k in "${!new[@]}"; do echo "${new[$k]}" > "$st/$k"; done
    apply
    [[ -n ${new[bar-opacity]:-} ]] && hyprctl reload >/dev/null   # the shader, as opacity below
    (( json )) && show
    exit 0 ;;
  opacity)
    [[ -z ${2:-} ]] && { opacity; exit 0; }
    [[ $2 =~ ^[0-9]+$ && $2 -le 100 ]] || { echo "0–100" >&2; exit 2; }
    mkdir -p "$st"; echo "$2" > "$st/bar-opacity"
    apply
    hyprctl reload >/dev/null ;;          # reloads the shader (hyprland.lua picks the copy)
  icons)
    [[ -z ${2:-} ]] && { scheme; exit 0; }
    [[ $2 == light || $2 == dark ]] || { echo "light|dark" >&2; exit 2; }
    mkdir -p "$st"; echo "$2" > "$st/bar-icons"
    apply ;;
  highlight)
    [[ -z ${2:-} ]] && { highlight; exit 0; }
    [[ $2 == theme || $2 == white || $2 == black ]] || { echo "theme|white|black" >&2; exit 2; }
    mkdir -p "$st"; echo "$2" > "$st/bar-highlight"
    apply ;;
  icon-opacity)
    [[ -z ${2:-} ]] && { iconop; exit 0; }
    [[ $2 =~ ^[0-9]+$ && $2 -le 100 ]] || { echo "0–100" >&2; exit 2; }
    mkdir -p "$st"; echo "$2" > "$st/bar-icon-opacity"
    apply ;;
  *) sed -n '2,7p' "$0" >&2; exit 2 ;;
esac
