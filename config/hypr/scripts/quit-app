#!/bin/bash
# ⌘Q: quits the active app for real, like on a Mac (⌘W only closes the window, or hides a background app).
# Safely, step by step:
#  1. An app with its own quit command (hypr/quit-commands, and a plugin's own quit-commands while it is on) is asked
#     to quit with that.
#  2. Otherwise all the app's windows (same process and class, also ones hidden to special:bg) are closed the normal
#     way, so the app can still ask about unsaved work.
#  3. If the process is still running a moment later but has no window left (it went to the tray), it gets SIGTERM:
#     a polite quit request it can clean up after. Never SIGKILL.
# The process is left alone when it still has a window (a save dialog, a cancelled quit, another app's window in a
# shared process), when the window is XWayland (its pid comes from the app and can't be trusted: muvm's Steam reports
# a pid from inside its VM) and when the pid isn't an ordinary process of this user.
d=$HOME/.config/hypr
note() { notify-send -a Nightdrive "$@"; }
# A field of /proc/<pid>/stat after "pid (comm)" (comm may contain spaces): 2 = ppid, 20 = start time
stat_field() { sed 's/.*) //' "/proc/$1/stat" 2>/dev/null | awk -v f="$2" '{print $f}'; }

# quit-app --class <regex>: quits an app by its window class instead of the active window (the launcher's ⌘Q: Apps list).
# Every process with a matching window is quit the same way, each in the background (--window <address>).
# The title last: it may hold spaces
fields='"\(.address // "") \(.class // "") \(.pid // 0) \(.xwayland // false) \(.title // "")"'
case $1 in
  --class)
    hyprctl -j clients | jq -r --arg re "$2" '[.[] | select(.class | test($re; "i"))] | unique_by(.pid) | .[].address' \
      | while read -r a; do "$0" --window "$a" & done
    exit 0 ;;
  --window) read -r addr class pid xw title < <(hyprctl -j clients | jq -r --arg a "$2" ".[] | select(.address == \$a) | $fields") ;;
  *)
    # The launcher open: ⌘Q is its own (the selected app in the list, or nothing), never the window under it
    [[ $(qs ipc call launcher quitSelected 2>/dev/null) == ok ]] && exit 0
    read -r addr class pid xw title < <(hyprctl -j activewindow | jq -r "$fields") ;;
esac
[[ -n $addr ]] || exit 0

# 1. Own quit command: "class regex = command", or "class regex @ title regex = command" for apps that share a class
# (Quickshell's windows: Deck, Mail). The core's, yours (.local) and those of the plugins that are on.
plugin_commands() {
  local id dir
  while IFS=$'\t' read -r id dir; do cat "$dir/quit-commands" 2>/dev/null; done < "$HOME/.local/state/nightdrive/plugins.d/active"
}
while IFS= read -r line; do
  [[ $line =~ ^[[:space:]]*(#|$) ]] && continue
  re=${line%%=*}; cmd=${line#*=}
  title_re=""
  [[ $re == *" @ "* ]] && { title_re=${re#* @ }; re=${re%% @ *}; }
  re=$(sed 's/^ *//; s/ *$//' <<<"$re"); title_re=$(sed 's/^ *//; s/ *$//' <<<"$title_re"); cmd=$(sed 's/^ *//' <<<"$cmd")
  if [[ -n $re && -n $cmd && $class =~ $re ]] && { [[ -z $title_re ]] || [[ $title =~ $title_re ]]; }; then
    setsid bash -c "$cmd" >/dev/null 2>&1 &
    exit 0
  fi
done < <(cat "$d/quit-commands" "$d/quit-commands.local" 2>/dev/null; plugin_commands 2>/dev/null)

# 2. Close the app's windows. A pid shared with other apps' windows (one Chromium for several webapps) only loses
# the windows of this class.
wins() { hyprctl -j clients | jq -r --argjson p "$pid" '.[] | select(.pid == $p) | "\(.address) \(.class)"'; }
while read -r a c; do
  [[ $c == "$class" ]] && hyprctl dispatch "hl.dsp.window.close({ window = \"address:$a\" })" >/dev/null
done < <(wins)

# 3. A process left running without windows gets SIGTERM
(( pid > 1 )) || exit 0
start=$(stat_field "$pid" 20); [[ -n $start ]] || exit 0
for _ in $(seq 12); do
  sleep 0.25
  [[ -d /proc/$pid ]] || exit 0                       # quit by itself
done
[[ -n $(wins) ]] && exit 0                            # still has a window: a dialog, a cancelled quit, a shared process
name=$(cat "/proc/$pid/comm" 2>/dev/null)
if [[ $xw == true ]]; then
  note "$class is still running" "Quit it from its own menu (in the tray)."
  exit 0
fi
# Only an ordinary process of this user, the same one (pid not reused), and not Hyprland, the shell or this script's parents
[[ $(stat -c %u "/proc/$pid") == "$UID" ]] || exit 0
[[ $(stat_field "$pid" 20) == "$start" ]] || exit 0
case $name in Hyprland|start-hyprland|qs|quickshell|systemd|dbus-daemon|dbus-broker) exit 0 ;; esac
p=$$
while (( p > 1 )); do
  (( p == pid )) && exit 0
  p=$(stat_field "$p" 2); [[ -n $p ]] || break
done
kill -TERM "$pid" 2>/dev/null
