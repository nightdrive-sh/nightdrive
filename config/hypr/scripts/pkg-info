#!/usr/bin/python3 -I
"""Details of a package for the launcher's Install / Remove detail view, as JSON on stdout.
  pkg-info dnf <name>        a package from the repos (dnf info; installed → the installed one)
  pkg-info flatpak <app id>  an app from Flathub (flatpak remote-info, or flatpak info when installed)
Output: { name, summary, installed, icon, screenshot, paragraphs: [text], fields: [[label, value]] }
AppStream data (Fedora's swcatalog for packages, Flathub's appstream for apps) adds the icon, a screenshot, the long
description and the developer, when the package is an app that has them."""
import glob, gzip, json, os, re, subprocess, sys
import xml.etree.ElementTree as ET

LANG = "{http://www.w3.org/XML/1998/namespace}lang"
# A package's name and an app's id, as software-apply takes them (#1862): no option, path, URL or .rpm in their place
NAMES = {"dnf": re.compile(r"[A-Za-z0-9][A-Za-z0-9._+-]*"), "flatpak": re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]*")}


def run(*cmd):
    try:
        return subprocess.run(cmd, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def component(data, tag, value):
    """The <component> element whose <tag> is value, cut out of the catalog text (parsing all of it is slow)."""
    i = data.find(f"<{tag}>{value}</{tag}>")
    if i < 0:
        return None
    start, end = data.rfind("<component", 0, i), data.find("</component>", i)
    if start < 0 or end < 0:
        return None
    try:
        return ET.fromstring(data[start:end + len("</component>")])
    except ET.ParseError:
        return None


def own(el, tag):
    """Child elements without a translation (the English text)."""
    return [c for c in el.findall(tag) if c.get(LANG) is None]


def text(el):
    return re.sub(r"\s+", " ", "".join(el.itertext())).strip()


def appstream(comp, icon_dirs):
    """icon, screenshot, paragraphs and developer from an AppStream component"""
    out = {"icon": "", "screenshot": "", "paragraphs": [], "developer": "", "homepage": ""}
    if comp is None:
        return out
    for d in own(comp, "description"):
        for c in d:
            if c.get(LANG) is not None:
                continue
            if c.tag == "p":
                out["paragraphs"].append(text(c))
            elif c.tag in ("ul", "ol"):
                out["paragraphs"].append("\n".join("•  " + text(li) for li in c if li.get(LANG) is None))
    out["paragraphs"] = [p for p in out["paragraphs"] if p]
    dev = comp.find("developer/name")
    out["developer"] = text(dev) if dev is not None else (comp.findtext("developer_name") or "").strip()
    for u in comp.findall("url"):
        if u.get("type") == "homepage":
            out["homepage"] = (u.text or "").strip()
    for ic in comp.findall("icon"):
        if ic.get("type") == "cached" and ic.text:
            for d in icon_dirs:
                p = os.path.join(d, ic.text.strip())
                if os.path.exists(p):
                    out["icon"] = p
                    break
        if out["icon"]:
            break
    # The default screenshot, the thumbnail closest to 752 px wide (the detail view is about that size at scale 2)
    shots = comp.findall("screenshots/screenshot")
    shot = next((s for s in shots if s.get("type") == "default"), shots[0] if shots else None)
    if shot is not None:
        imgs = [(int(i.get("width") or 0), (i.text or "").strip()) for i in shot.findall("image") if (i.text or "").strip()]
        if imgs:
            out["screenshot"] = re.sub(r"^http://", "https://", min(imgs, key=lambda w: abs(w[0] - 752) if w[0] else 10**6)[1])
    return out


def keyvalues(output):
    """'Key : value' lines (continuation lines start with ':') → dict, Description kept as paragraphs"""
    fields, key = {}, None
    for line in output.splitlines():
        m = re.match(r"^(\S[^:]*?)\s*:\s?(.*)$", line)
        if m and not line.startswith(" "):
            key = m.group(1).strip()
            if key in fields:          # a second package (another architecture): keep the first
                break
            fields[key] = m.group(2)
        elif key and re.match(r"^\s+:", line):
            fields[key] += "\n" + line.split(":", 1)[1].strip()
    return fields


def source(repo):
    """Where a package comes from, in words: Fedora's own repos are just "Fedora" """
    return "Fedora" if repo in ("fedora", "updates", "updates-testing", "@System", "anaconda") else repo


def dnf(name):
    installed = subprocess.run(["rpm", "-q", "--", name], capture_output=True).returncode == 0
    f = keyvalues(run("dnf", "info", "-q", "--installed" if installed else "--available", "--", name))
    paras = [re.sub(r"\s+", " ", p).strip() for p in re.split(r"\n\s*\n", f.get("Description", ""))]
    cat = sorted(glob.glob("/usr/share/swcatalog/xml/*.xml.gz"))
    comp = None
    for c in cat:
        try:
            comp = component(gzip.open(c).read().decode("utf-8", "replace"), "pkgname", name)
        except OSError:
            continue
        if comp is not None:
            break
    a = appstream(comp, ["/usr/share/swcatalog/icons/fedora/128x128", "/usr/share/swcatalog/icons/fedora/64x64"])
    version = f.get("Version", "") + ("-" + f["Release"] if f.get("Release") else "")
    rows = [
        ("Version", version + ("  (installed)" if installed else "")),
        ("Size", f.get("Installed size", "") + (f"  ·  download {f['Download size']}" if f.get("Download size") else "")),
        ("Source", source(f.get("Repository") or f.get("From repository", ""))),
        ("License", f.get("License", "")),
        ("Developer", a["developer"]),
        ("Homepage", f.get("URL") or a["homepage"]),
    ]
    return {
        # An app by its own name ("Calculator", not gnome-calculator), as in the search results
        "name": (own(comp, "name")[0].text or "").strip() if comp is not None and own(comp, "name") else f.get("Name", name),
        "summary": (own(comp, "summary")[0].text or "").strip() if comp is not None and own(comp, "summary") else f.get("Summary", ""),
        "installed": installed,
        "icon": a["icon"], "screenshot": a["screenshot"],
        "paragraphs": a["paragraphs"] or [p for p in paras if p],
        "fields": [[k, v] for k, v in rows if v.strip()],
    }


def flatpak(app):
    installed = subprocess.run(["flatpak", "info", "--user", "--", app], capture_output=True).returncode == 0
    out = run("flatpak", "info", "--user", "--", app) if installed else run("flatpak", "remote-info", "--user", "--", "flathub", app)
    lines = out.splitlines()
    title = next((l.strip() for l in lines if l.strip()), "")     # "Name - summary"
    f = {}
    for l in lines:
        m = re.match(r"^\s*([A-Z][\w ]*?):\s+(.*)$", l)
        if m:
            f.setdefault(m.group(1), m.group(2).strip())
    comp, icon_dirs = None, []
    for d in glob.glob(os.path.expanduser("~/.local/share/flatpak/appstream/flathub/*/active")):
        icon_dirs += [d + "/icons/128x128", d + "/icons/64x64"]
        try:
            with open(d + "/appstream.xml", encoding="utf-8", errors="replace") as fh:
                comp = component(fh.read(), "id", app)
        except OSError:
            continue
        if comp is not None:
            break
    a = appstream(comp, icon_dirs)
    name = (own(comp, "name")[0].text if comp is not None and own(comp, "name") else "") or title.split(" - ")[0] or app
    summary = (own(comp, "summary")[0].text if comp is not None and own(comp, "summary") else "") or title.partition(" - ")[2]
    size = f.get("Installed Size") or f.get("Installed", "")
    rows = [
        ("Version", f.get("Version", "") + ("  (installed)" if installed else "")),
        ("Size", size + (f"  ·  download {f['Download Size']}" if f.get("Download Size") and not installed else "")),
        ("Source", "Flathub"),
        ("Developer", a["developer"]),
        ("License", f.get("License", "")),
        ("Runtime", f.get("Runtime", "")),
        ("Homepage", a["homepage"]),
        ("ID", app),
    ]
    return {
        "name": name.strip(), "summary": summary.strip(), "installed": installed,
        "icon": a["icon"], "screenshot": a["screenshot"], "paragraphs": a["paragraphs"],
        "fields": [[k, v] for k, v in rows if v.strip()],
    }


if len(sys.argv) != 3 or sys.argv[1] not in ("dnf", "flatpak"):
    print("\n".join(__doc__.split("\n")[1:3]), file=sys.stderr)
    sys.exit(2)
if not NAMES[sys.argv[1]].fullmatch(sys.argv[2]) or sys.argv[1] == "dnf" and sys.argv[2].lower().endswith(".rpm"):
    sys.exit(f"{sys.argv[2]!r} isn't a {'package name' if sys.argv[1] == 'dnf' else 'Flatpak app id'}")
print(json.dumps(dnf(sys.argv[2]) if sys.argv[1] == "dnf" else flatpak(sys.argv[2])))
