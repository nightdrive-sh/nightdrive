{
  "manifest_version": 3,
  "name": "Nightdrive web app links",
  "description": "Opens links to other sites in the default browser (hypr/scripts/webapp-links)",
  "version": "1.0",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "webNavigation"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start" }]
}
