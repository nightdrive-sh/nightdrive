#!/usr/bin/python3 -I
"""A plugin's steps to set it up by hand, for the Welcome window's manual path: its steps.md, read for the window.
  steps ID [VALUES]                 the steps as JSON on stdout, their Done when tests run with VALUES
  steps edit ID N VALUES            step N's template written to its Edit: file if that is missing, then opened in the editor, over the window
  steps run ID N VALUES             step N's code block in a terminal, which stays open afterwards
  steps action ID N I VALUES        step N's I-th Run: or Open: button
VALUES is a JSON object of the Ask: fields filled so far ({"email": "you@example.com"}): {key} in a command or a
template becomes its value. The window keeps them only while it is open.

steps.md (plugins/README.md › steps.md): `Help: README.md#section` before the first step names what the window shows
beside a step (more Help: lines: the first file that is there; a step's own Help: lines go before them); each
`## Title` is a step, its paragraphs in plain words, at most one fenced code block (a command, or the template of its
`Edit:` file), and lines of their own:
  Ask: key | Label | placeholder     a field the window asks for
  Edit: ~/path                       the code block is the file's template
  Run: Label | command               a button: the command, in the plugin's folder
  Open: Label | https://…            a button: a page in the browser
  Done when: test                    a quick shell test, in the folder: the step shows as done while it succeeds"""
import json, os, re, subprocess, sys, time

REPO = os.path.realpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "../.."))
HOME = os.path.expanduser("~")
EXTERNAL = os.path.join(HOME, ".local/share/nightdrive/plugins")
TERMINAL = os.path.join(HOME, ".config/hypr/scripts/terminal")
TERMINAL_CLASS = "nightdrive-welcome"   # hyprland.lua's float-welcome-terminal: over the window, not tiled behind it
FRONT_WAIT = 10                         # seconds to wait for the editor's window, to bring it over the Welcome window
TEST_TIMEOUT = 5                    # seconds for a Done when test: the window reads the steps again every few seconds
DIRECTIVE = re.compile(r"(Ask|Edit|Run|Open|Help|Done when):\s*(.*)$")


def folder(pid):
    for base in (os.path.join(REPO, "plugins"), EXTERNAL):
        f = os.path.join(base, pid)
        if os.path.isfile(os.path.join(f, "steps.md")):
            return f
    sys.exit(f"steps: {pid} has no steps.md")


def conf(f):
    try:
        lines = open(os.path.join(f, "plugin.conf")).read().split("\n")
    except OSError:
        return {}
    return dict(l.split("=", 1) for l in lines if re.match(r"[a-z]+=", l))


def parse(text):
    """([help], [step]): the file's Help: lines and its ## steps, each with its parts sorted out of the text"""
    helps, steps, step, prose, code, fence = [], [], None, [], None, False
    def close():
        if step is not None:
            step["text"] = "\n".join(prose).strip()
            steps.append(step)
    for line in text.split("\n"):
        if fence:
            if line.startswith("```"):
                fence = False
                if step is not None and step["code"] == "":
                    step["code"] = "\n".join(code)
            else:
                code.append(line)
            continue
        if line.startswith("```"):
            fence, code = True, []
            continue
        if line.startswith("## "):
            close()
            step, prose = {"title": line[3:].strip(), "asks": [], "code": "", "edit": "", "actions": [], "test": "",
                           "help": []}, []
            continue
        if step is None:
            if line.startswith("Help:"):
                helps.append(line[5:].strip())
            continue
        m = DIRECTIVE.match(line)
        if not m:
            prose.append(line)
            continue
        kind, rest = m.group(1), [p.strip() for p in m.group(2).split("|")]
        if kind == "Ask":
            step["asks"].append({"key": rest[0], "label": rest[1] if len(rest) > 1 else rest[0],
                                 "placeholder": rest[2] if len(rest) > 2 else ""})
        elif kind == "Edit":
            step["edit"] = rest[0]
        elif kind == "Help":
            step["help"].append(rest[0])
        elif kind == "Done when":
            step["test"] = m.group(2).strip()
        elif len(rest) > 1:
            step["actions"].append({"kind": kind.lower(), "label": rest[0], "arg": "|".join(rest[1:]).strip()})
    close()
    return helps, steps


def slug(heading):
    """GitHub's anchor for a heading: lower case, no punctuation, spaces as dashes"""
    return re.sub(r"[^\w\- ]", "", heading.strip().lower()).replace(" ", "-")


def section(f, refs):
    """{title, markdown}: the first of refs (FILE#anchor, relative to the plugin's folder) whose file is there, cut to the
    section by its anchor, down to the next heading as high as its own (the whole file without an anchor). Pictures are
    left out: the pane shows text."""
    for ref in refs:
        path, _, anchor = ref.partition("#")
        path = os.path.join(f, os.path.expanduser(path or "README.md"))
        if os.path.isfile(path):
            break
    else:
        return {"title": "", "markdown": ""}
    lines = open(path, errors="replace").read().split("\n")
    start, level, title = 0, 0, ""
    if anchor:
        for i, l in enumerate(lines):
            m = re.match(r"(#+)\s+(.*)", l)
            if m and slug(m.group(2)) == anchor:
                start, level, title = i + 1, len(m.group(1)), m.group(2).strip()
                break
    end, fence = len(lines), False
    for i in range(start, len(lines)):
        if lines[i].startswith("```"):
            fence = not fence
        m = None if fence else re.match(r"(#+)\s", lines[i])
        if level and m and len(m.group(1)) <= level:
            end = i
            break
    return {"title": title, "markdown": readable(lines[start:end])}


def readable(lines):
    """The section as the pane's Markdown shows it well: Qt draws a link in the palette's dark blue whatever the pane's
    colours, and a code block's long lines past its edge. So links are their words (an address stays as text, an @ or
    :// no longer one), pictures are left out, and a code block's lines are a quote of code spans, which wrap."""
    out, fence = [], False
    for l in lines:
        if l.lstrip().startswith("```"):
            fence = not fence
            continue
        if fence:
            out.append("> `" + l.replace("`", "'") + "`  " if l.strip() else ">")
            continue
        if re.match(r"\s*!\[", l):
            continue
        l = re.sub(r"\[([^\]]+)\]\((https?://[^)]+)\)", r"\1 (\2)", l)
        l = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", l)
        # Outside code spans only: inside one, an entity would show as it is
        parts = l.split("`")
        for i in range(0, len(parts), 2):
            parts[i] = parts[i].replace("@", "&#64;").replace("://", "&#58;//").replace("www.", "www&#46;")
        out.append("`".join(parts))
    return "\n".join(out).strip()


def passes(test, cwd):
    try:
        return subprocess.run(["bash", "-c", test], cwd=cwd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=TEST_TIMEOUT).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def fill(text, values):
    return re.sub(r"\{(\w+)\}", lambda m: values.get(m.group(1)) or m.group(0), text)


def show(pid, vals):
    f = folder(pid)
    c = conf(f)
    helps, steps = parse(open(os.path.join(f, "steps.md")).read())
    sections = {}       # the same section once, however many steps show it
    for s in steps:
        s["done"] = passes(fill(s["test"], vals), f) if s["test"] else None
        refs = tuple(s["help"] + (helps or ["README.md"]))
        if refs not in sections:
            sections[refs] = section(f, refs)
        s["help"] = sections[refs]
        del s["test"]
    print(json.dumps({"id": pid, "name": c.get("name", pid), "icon": c.get("icon", "puzzle"), "steps": steps}))


def step(pid, n):
    f = folder(pid)
    steps = parse(open(os.path.join(f, "steps.md")).read())[1]
    if not 0 <= n < len(steps):
        sys.exit(f"steps: {pid} has no step {n}")
    return f, steps[n]


def values(arg):
    try:
        v = json.loads(arg)
        return {k: str(x) for k, x in v.items()} if isinstance(v, dict) else {}
    except ValueError:
        return {}


def detach(argv, cwd):
    subprocess.Popen(argv, cwd=cwd, start_new_session=True, stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def clients():
    try:
        out = subprocess.run(["hyprctl", "-j", "clients"], capture_output=True, text=True, timeout=2).stdout
        return {c["address"] for c in json.loads(out)}
    except (OSError, ValueError, KeyError, subprocess.TimeoutExpired):
        return set()


def to_front(before):
    """The editor's new window, floating and centred over the Welcome window: a tiled one would open behind it. An
    editor that was already open (no new window) is left where it is."""
    for _ in range(FRONT_WAIT * 4):
        time.sleep(0.25)
        new = clients() - before
        if new:
            w = f'window = "address:{new.pop()}"'
            subprocess.run(["hyprctl", "--batch",
                            f'dispatch hl.dsp.window.float({{ action = "enable", {w} }}); '
                            f'dispatch hl.dsp.window.resize({{ x = 900, y = 560, exact = true, {w} }}); '
                            f'dispatch hl.dsp.window.center({{ {w} }}); dispatch hl.dsp.focus({{ {w} }})'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return


def edit(pid, n, vals):
    """The file is written only when it isn't there yet: one the user already has is opened as it is, never replaced"""
    f, s = step(pid, n)
    path = os.path.expanduser(s["edit"])
    if not os.path.exists(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as out:
            out.write(fill(s["code"], vals).rstrip("\n") + "\n")
    before = clients()
    detach(["xdg-open", path], f)
    to_front(before)


def run(pid, n, vals):
    f, s = step(pid, n)
    detach([TERMINAL, "--hold", "--dir", HOME, "--class", TERMINAL_CLASS, "--", "bash", "-c", fill(s["code"], vals)], f)


def action(pid, n, i, vals):
    f, s = step(pid, n)
    a = s["actions"][i]
    if a["kind"] == "open":
        detach(["xdg-open", fill(a["arg"], vals)], f)
    else:
        detach(["bash", "-c", fill(a["arg"], vals)], f)


def main(argv):
    if len(argv) in (1, 2) and argv[0] not in ("edit", "run", "action"):
        show(argv[0], values(argv[1]) if len(argv) == 2 else {})
    elif len(argv) == 4 and argv[0] in ("edit", "run"):
        (edit if argv[0] == "edit" else run)(argv[1], int(argv[2]), values(argv[3]))
    elif len(argv) == 5 and argv[0] == "action":
        action(argv[1], int(argv[2]), int(argv[3]), values(argv[4]))
    else:
        sys.exit("usage: steps ID [VALUES] | edit ID N VALUES | run ID N VALUES | action ID N I VALUES")


main(sys.argv[1:])
