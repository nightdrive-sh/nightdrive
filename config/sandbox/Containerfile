# The image of `nightdrive sandbox` (config/sandbox/sandbox builds it). Its build context is the repo root, so it installs
# the repo's own package lists. The config itself isn't in the image: the repo is mounted read-only at run time.
FROM registry.fedoraproject.org/fedora:44

# The same Hyprland COPR as install.sh (setup-hyprland-repo.sh: includepkgs keeps it from replacing Fedora's packages)
COPY setup-hyprland-repo.sh /tmp/nd/
RUN /tmp/nd/setup-hyprland-repo.sh

COPY packages-hyprland.txt packages.txt /tmp/nd/
RUN pkgs() { grep -vE '^\s*(#|$)' "$1" | tr '\n' ' '; } \
 && dnf -y install $(pkgs /tmp/nd/packages-hyprland.txt) \
 && dnf -y install --skip-unavailable $(pkgs /tmp/nd/packages.txt) \
 && dnf clean all

# What the container needs on top: KWin (its virtual screen hosts the nested Hyprland, see config/sandbox/inside), software rendering, process tools, a VNC server, D-Bus for the session.
# wayvnc is 0.10 from the COPR (setup-hyprland-repo.sh): Fedora 44's 0.9.1 exits when Hyprland fails a cursor capture
# frame, which it does whenever the cursor changes shape (a click), and the viewer drops.
RUN dnf -y install kwin mesa-dri-drivers mesa-vulkan-drivers procps-ng psmisc strace dbus-daemon dbus-tools wayvnc \
     which findutils python3 unzip curl git sudo xorg-x11-server-Xwayland \
     xdg-user-dirs \
 && dnf clean all \
 && setcap -r /usr/bin/kwin_wayland   # cap_sys_nice: a rootless container can't exec it; --cap-add instead breaks bwrap (glycin image loaders)

# Nerd Fonts symbols, as install.sh does (system-wide here so the image is self-contained)
RUN mkdir -p /usr/share/fonts/nerd /tmp/nf \
 && curl -fsSL -o /tmp/nf.zip https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/NerdFontsSymbolsOnly.zip \
 && unzip -o -q /tmp/nf.zip -d /tmp/nf && cp /tmp/nf/*.ttf /usr/share/fonts/nerd/ && rm -rf /tmp/nf /tmp/nf.zip && fc-cache -f

# luac: nightdrive plugin check reads a plugin's bindings.lua with it (a layer of its own, so adding it rebuilt only this)
RUN dnf -y install lua && dnf clean all

# A regular user (Hyprland refuses to run as root); podman run --userns=keep-id maps it to the host user, so the
# read-only repo is readable and the screenshots it writes belong to the host user
RUN useradd -m -u 1000 nd && echo 'nd ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/nd
USER nd
WORKDIR /home/nd
