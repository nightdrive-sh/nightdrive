#!/usr/bin/python3 -I
"""System meters. `sysinfo bar` -> TEXT<TAB>TOOLTIP<TAB>CLASS (for the top bar's status script),
`sysinfo menu` -> JSON for Quickshell's SystemMenu, `sysinfo battery` -> JSON for BatteryMenu's details (null on a desktop).
CPU load is measured since the previous call (state: $XDG_RUNTIME_DIR/sysinfo-<mode>.json); the first call measures over 0.3 s."""
import glob, json, os, sys, time

# The temperature sensors shown in the menu, as (substring of "<hwmon name> <sensor label>", title); the ones a machine
# doesn't have are left out. MacBook (Apple Silicon), then a PC's CPU (Intel: coretemp, AMD: k10temp) and AMD graphics.
# Others: see /sys/class/hwmon/hwmon*/{name,temp*_label}. NVIDIA's own driver has no hwmon sensor.
# The battery's own temperature is in the battery menu (from power_supply), not here.
SENSORS = [("nvme", "SSD"), ("WiFi/BT", "Wi-Fi/BT"),
           ("Charge Regulator", "Charger"), ("tas2764", "Speakers"),
           ("coretemp Package", "CPU"), ("k10temp Tctl", "CPU"), ("amdgpu edge", "GPU")]

mode = sys.argv[1] if len(sys.argv) > 1 else "menu"
state_path = os.path.join((os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"), f"sysinfo-{mode}.json")
HZ = os.sysconf("SC_CLK_TCK")

def rd(p, default=""):
    try:
        with open(p) as f: return f.read().strip()
    except OSError: return default

# The machine's own battery (MacBook: macsmc-battery), not a Bluetooth mouse's (scope Device); "" on a desktop
BATTERY = next((d for d in sorted(glob.glob("/sys/class/power_supply/*"))
                if rd(d + "/type") == "Battery" and rd(d + "/scope") != "Device"), "")

def cpu_times():
    v = list(map(int, rd("/proc/stat").split("\n")[0].split()[1:]))
    return sum(v), v[3] + v[4]            # total, idle+iowait

def procs():
    out = {}
    for d in glob.glob("/proc/[0-9]*"):
        try:
            s = open(d + "/stat").read()
            name = s[s.index("(") + 1:s.rindex(")")]
            f = s[s.rindex(")") + 2:].split()
            out[int(d[6:])] = (name, int(f[11]) + int(f[12]), int(f[21]) * os.sysconf("SC_PAGE_SIZE"))
        except (OSError, ValueError): pass
    return out

bat = lambda f: rd(f"{BATTERY}/{f}") if BATTERY else ""
num = lambda f: int(bat(f)) if bat(f).lstrip("-").isdigit() else None
def battery():
    if not BATTERY: return None
    full, design = num("energy_full"), num("energy_full_design")   # µWh
    made = (num("manufacture_year"), num("manufacture_month"))
    return {
        "pct": num("capacity"), "status": bat("status"),
        "watts": round(abs(num("power_now") or 0) / 1e6, 1),            # negative while discharging
        "temp": round(num("temp") / 10, 1) if num("temp") is not None else None,   # tenths of a °C
        "health": round(100 * full / design) if full and design else None,
        "fullWh": round(full / 1e6, 1) if full else None, "designWh": round(design / 1e6, 1) if design else None,
        "cycles": num("cycle_count"),
        "volts": round(num("voltage_now") / 1e6, 2) if num("voltage_now") else None,
        "made": f"{made[1]:02d}/{made[0]}" if all(made) else "",
    }
if mode == "battery":
    print(json.dumps(battery()))
    sys.exit()

def snap():
    return {"t": time.time(), "cpu": cpu_times(), "p": {str(k): v for k, v in procs().items()} if mode == "menu" else {}}

prev = None
try: prev = json.load(open(state_path))
except (OSError, ValueError): pass
if prev is None:
    prev = snap(); time.sleep(0.3)
now = snap()
try: json.dump(now, open(state_path, "w"))
except OSError: pass

dt = max(0.05, now["t"] - prev["t"])
dtot, didle = now["cpu"][0] - prev["cpu"][0], now["cpu"][1] - prev["cpu"][1]
cpu = round(100 * (dtot - didle) / dtot) if dtot > 0 else 0

mi = {l.split(":")[0]: int(l.split()[1]) for l in rd("/proc/meminfo").splitlines()}   # kB
mem_total, mem_used = mi["MemTotal"] * 1024, (mi["MemTotal"] - mi["MemAvailable"]) * 1024
swap_total, swap_used = mi["SwapTotal"] * 1024, (mi["SwapTotal"] - mi["SwapFree"]) * 1024

temps = []
for h in sorted(glob.glob("/sys/class/hwmon/hwmon*")):
    name = rd(h + "/name")
    for t in sorted(glob.glob(h + "/temp*_input")):
        try: c = int(rd(t)) / 1000
        except ValueError: continue
        label = rd(t.replace("_input", "_label")) or name
        temps.append((name, label, c))
def pick(match, title):
    v = [c for n, l, c in temps if match in (n + " " + l)]
    return (title, max(v)) if v else None
wanted = [pick(match, title) for match, title in SENSORS]
temps = [{"label": t, "c": round(c)} for t, c in filter(None, wanted)]
hottest = max((t["c"] for t in temps), default=None)   # None: no sensors (a VM)

freqs = [int(rd(f)) for f in glob.glob("/sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq") if rd(f).isdigit()]
freq = round(sum(freqs) / len(freqs) / 1000) if freqs else 0   # 0: no cpufreq (a VM), left out of the texts
load = rd("/proc/loadavg").split()[:3]

gb = lambda b: f"{b / 2**30:.1f}"
if mode == "bar":
    cls = "high" if cpu > 90 else ""
    tip = f"CPU {cpu}%" + (f" · {freq} MHz" if freq else "") + f" · load {load[0]}\\nRAM {gb(mem_used)} / {gb(mem_total)} GB"
    if hottest is not None: tip += f"\\nHottest sensor {hottest} °C"
    print(f'{cpu}%\t{tip}\t{cls}')
    sys.exit()

# processes grouped by name (process%: share of one core; chromium etc. are summed)
agg = {}
for pid, (name, ticks, rss) in now["p"].items():
    old = prev["p"].get(pid)
    if not old or old[0] != name: continue
    a = agg.setdefault(name, [0.0, 0])
    a[0] += 100 * (ticks - old[1]) / HZ / dt
    a[1] += rss
top = sorted(({"name": n, "cpu": round(v[0], 1), "rss": v[1]} for n, v in agg.items()), key=lambda x: -x["cpu"])[:6]

print(json.dumps({"cpu": cpu, "freq": freq, "load": load, "memUsed": mem_used, "memTotal": mem_total,
                  "swapUsed": swap_used, "swapTotal": swap_total, "temps": temps, "top": top,
                  "cores": os.cpu_count()}))
