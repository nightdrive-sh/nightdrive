#!/bin/bash
# The bar's Claude module (scripts/status runs it). Right click cycles what it shows, remembered across restarts:
#   0  gauge + 5-hour usage %    1  gauge + weekly usage %    2  gauge, 5-hour    3  gauge, weekly
#   4  spark + number of Claude Code sessions                 5  spark alone
# With more than one Claude Code account (claude-accounts), a gauge each, in their order: the first as the module's own
# icon and text, the others as its "more" parts (BarModule.qml); each warns in its own colour.
# The spark (icons/spark.svg) is our own, not Anthropic's logo: Nightdrive is a third-party project.
# Usage: claude-bar [status|next]
state=${XDG_STATE_HOME:-$HOME/.local/state}/nightdrive
mode=$(cat "$state/claude-bar-mode" 2>/dev/null); [[ $mode =~ ^[0-5]$ ]] || mode=0
dir=$(dirname "$0")

case ${1:-status} in
  next)
    mkdir -p "$state" && echo $(( (mode + 1) % 6 )) > "$state/claude-bar-mode" ;;
  status)
    . "$dir/emit"
    if (( mode >= 4 )); then
      text=; (( mode == 4 )) && text=$("$dir/claude-sessions" | jq length)
      emit spark "$text"; exit
    fi
    key=$( (( mode % 2 )) && echo weekly || echo session )
    # A part per account: gauge@N (the needle points at the usage: TopBar.qml draws it), the colour by the window shown;
    # an account without numbers (signed out) is a dimmed gauge. Over 95 % critical, over 90 % warning.
    "$dir/claude-usage" --all | jq -c --arg k "$key" --argjson withText "$(( mode < 2 ))" '
      [.[] | ((.windows // []) | map(select(.key == $k)) | first // {}).percent // -1
           | if . < 0 then {icon: "gauge", text: "", class: "off"}
             else {icon: "gauge@\(.)", text: (if $withText == 1 then "\(.)%" else "" end),
                   class: (if . > 95 then "critical" elif . > 90 then "warning" else "" end)} end]
      | if length == 0 then {icon: "gauge", text: "", class: "off"}
        else .[0] + (if length > 1 then {more: .[1:]} else {} end) end' ;;
esac
