#!/bin/bash
# The top bar clock (the calendar module). Right click cycles its format, from long to short (here in Finland's way):
#   0  Tue 3.11. 13:48     1  Tue 3. 13:48     2  3.11. 13:48     3  13:48
# The day, the month and the time are the region's (Settings › Region, `nightdrive region`: regions.json's day and time,
# as the apps' Regional writes them: 3.11. 13:48, 11/3 1:48 PM in the US), or the date in one of the styles set with
# `clock style`: dmy (3.11.), mdy (11/3), iso (11-03); auto is the region's.
# Weekdays are always in English.
# Usage: clock [text|next]   the clock's text now | the next format
#        clock style [auto|dmy|mdy|iso]   shows or sets the date style (`nightdrive topbar date …`)
state=${XDG_STATE_HOME:-$HOME/.local/state}/nightdrive
mode=$(cat "$state/clock-mode" 2>/dev/null); [[ $mode =~ ^[0-3]$ ]] || mode=0
style=$(cat "$state/date-style" 2>/dev/null); [[ $style =~ ^(dmy|mdy|iso)$ ]] || style=auto

# The region's day and time as date(1) formats, one a line: "%-d.%-m." and "%-H:%M" in Finland, "%-m/%-d" and
# "%-I:%M %p" in the US. hypr/scripts/region reads locale.conf each time, so a change shows at the next tick (the bar
# was started before it, with the LC_TIME of then). Without it, ISO's
region_fmt() {
  local out
  out=$(~/.config/hypr/scripts/region --json 2>/dev/null | jq -r '
    def strf: gsub("(?<t>dd|d|MM|M|HH|H|hh|h|mm|AP|ap)"; {dd: "%d", d: "%-d", MM: "%m", M: "%-m", HH: "%H", H: "%-H",
                                                         hh: "%I", h: "%-I", mm: "%M", AP: "%p", ap: "%P"}[.t]);
    (.day | strf), (.time | strf)' 2>/dev/null)
  if [[ $out == ?*$'\n'?* ]]; then echo "$out"; else printf '%s\n' '%m-%d' '%H:%M'; fi
}

case ${1:-text} in
  next)
    mkdir -p "$state" && echo $(( (mode + 1) % 4 )) > "$state/clock-mode" ;;
  style)
    if [[ -z ${2:-} ]]; then echo "$style"; exit; fi
    [[ $2 =~ ^(auto|dmy|mdy|iso)$ ]] || { echo "usage: clock style [auto|dmy|mdy|iso]" >&2; exit 1; }
    mkdir -p "$state" && echo "$2" > "$state/date-style"
    command -v qs >/dev/null && qs ipc call bar refresh >/dev/null 2>&1 || true ;;
  text)
    { read -r full; read -r tm; } < <(region_fmt)
    case $style in
      dmy) full="%-d.%-m." ;;
      mdy) full="%-m/%-d" ;;
      iso) full="%m-%d" ;;
    esac
    # The day alone: "3." where the date has dots, else "3"
    if [[ $full == *.* ]]; then day="%-d."; else day="%-d"; fi
    fmt=("%a $full $tm" "%a $day $tm" "$full $tm" "$tm")
    LC_TIME=C date "+${fmt[mode]}" ;;
esac
