// The top bar's right-hand modules, left to right. Quickshell draws the bar (quickshell/Bar.qml) and reloads this on save.
// A private overlay adds its own modules at the left end in local.modules.jsonc (same format).
//
//   name      the module's name: `scripts/status <name>` gives its state, quickshell/<Name>Menu.qml (if it exists) opens
//             on a click, adjust.conf has its icon size / position (`nightdrive topbar adjust`)
//   interval  seconds between status updates (default 5); `qs ipc call bar refresh` updates every module at once
//   status    optional: another command printing the state (default ~/.config/topbar/scripts/status <name>)
//   menu      optional: the menu to open on a left click, if not <Name>Menu.qml ("" = none)
//   right, middle  optional: shell commands for a right / middle click (the module updates right after)
//   spacing   optional: letter spacing of its text in px (- = tighter)
//   needs     optional: an optional part's id (plugins.txt); without it installed the module isn't run or listed
//             (a plugin folder's module, plugins/<id>/module.jsonc, has its own id as needs, and these keys too:
//             after / before = the module it goes right / left of (or a list: the first one in the bar), size = its icon
//             size, label and glyph for Settings › Top bar › Items; plugins/README.md)
//   first     optional: true = always at the left end of the modules, whatever the order (for one that comes and goes:
//             appearing there doesn't shift the others)
//   drop      optional: a shell command that takes files dropped on the icon as arguments; dragging files over the icon
//             also opens its menu, so they can be dropped there
//
// A status command prints one line of JSON:  {"icon": "wifi", "text": "95%", "class": "off"}
//   icon   a Lucide name (lucide.dev/icons), or pack:name from any Iconify set (mdi:wifi, tabler:cpu…); see scripts/icon.
//          Several separated by | are an animation (wifi-zero|wifi-low|wifi-high|wifi); gauge@<0-100> is a gauge whose
//          needle points at the value
//   text   optional text after the icon (always the same font and size: the `text` row in adjust.conf)
//   class  optional: off (dimmed), warning (orange), critical (red), active (highlighted background), stale (faded)
// No icon and no text hides the module.
[
  { "name": "camera",        "interval": 2,  "first": true },
  { "name": "microphone",    "interval": 2,  "first": true },
  { "name": "claude",        "interval": 15, "right": "~/.config/topbar/scripts/claude-bar next", "middle": "xdg-open https://claude.ai/settings/usage" },
  { "name": "system",        "interval": 3 },
  { "name": "bluetooth",     "interval": 5,  "right": "blueman-manager" },
  { "name": "wifi",          "interval": 5,  "right": "nm-connection-editor" },
  { "name": "volume",        "interval": 2,  "right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle", "middle": "pavucontrol" },
  { "name": "headphones",    "interval": 3,  "right": "~/.config/topbar/scripts/eq disconnect", "middle": "easyeffects" },
  { "name": "display",       "interval": 30 },
  { "name": "battery",       "interval": 10 },
  { "name": "calendar",      "interval": 5,  "right": "~/.config/topbar/scripts/clock next", "spacing": -0.4 },
  { "name": "notifications", "interval": 60 }
]
