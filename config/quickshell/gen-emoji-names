#!/usr/bin/env python3
# Writes EmojiNames.js: emoji shortcodes (Slack's names: +1, thumbsup, slightly_smiling_face…) → the emoji.
# The data is iamcal/emoji-data (MIT, Copyright (c) 2013 Cal Henderson), the set Slack itself names its emoji by.
# Run it again with a newer TAG when Unicode adds emoji.
import json
import os
import urllib.request

TAG = "v16.0.0"
URL = f"https://raw.githubusercontent.com/iamcal/emoji-data/{TAG}/emoji.json"
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "EmojiNames.js")

with urllib.request.urlopen(URL) as r:
    data = json.load(r)

names = {}
for e in data:
    char = "".join(chr(int(c, 16)) for c in e["unified"].split("-"))
    for n in e["short_names"]:
        names[n] = char

with open(OUT, "w", encoding="utf-8") as f:
    f.write(".pragma library\n")
    f.write(f"// Generated by gen-emoji-names from iamcal/emoji-data {TAG} (MIT, Copyright (c) 2013 Cal Henderson). Don't edit.\n")
    f.write("var names = {\n")
    for n in sorted(names):
        f.write(f"{json.dumps(n)}:{json.dumps(names[n], ensure_ascii=False)},\n")
    f.write("}\n")
print(f"{len(names)} names → {OUT}")
