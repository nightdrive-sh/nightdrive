[Desktop Entry]
# `recorder install` copies this to ~/.local/share/applications with Exec's full path filled in (the compositor's PATH
# may not have ~/.local/bin), and the icon to ~/.local/share/icons/hicolor/scalable/apps.
Type=Application
Name=Recorder
GenericName=Nightdrive Recorder
Comment=Record from a microphone into ~/Recordings, and turn it into text
Keywords=record;recorder;sound;audio;voice;microphone;memo;transcribe;
Icon=nightdrive-recorder
Exec=recorder
Terminal=false
Categories=AudioVideo;Audio;Recorder;
StartupNotify=false
