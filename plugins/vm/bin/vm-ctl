#!/usr/bin/env bash
# A rough prototype (task #1528): qemu/KVM VMs for the VM window, one folder each under ~/.local/share/nightdrive/vm/NAME:
#   vm.conf      MEM (MB), CPUS, ISO (booted first while set)
#   disk.qcow2   the disk; snapshots are internal to it (qemu-img snapshot, only while the VM is stopped)
#   vars.raw     the UEFI variables
#   qmp.sock, pid, serial.log while it runs
# The qemu command line is the one #1527 got Fedora booting with on Asahi (an M2 Max).
#
#   vm-ctl list                          JSON: [{ name, mem, cpus, disk, iso, running, snapshots: [{ tag, date }] }]
#   vm-ctl create NAME ISO MEM_GB DISK_GB [CPUS]
#   vm-ctl start|stop|kill|display|eject|delete NAME
#   vm-ctl snapshot|restore|unsnap NAME TAG     take, go back to, delete one
#   vm-ctl isos                          .iso files in ~/Downloads and ~/vm, newest first
set -euo pipefail

ROOT=${VM_ROOT:-$HOME/.local/share/nightdrive/vm}
FW=/usr/share/edk2/aarch64
# The M2 Max's performance cluster: a vCPU must not move to an E-core (another MIDR, and KVM stops it)
PCORES=4-11
MAX_CPUS=8

die() { echo "$*" >&2; exit 1; }
dir() { [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || die "Bad name: $1"; echo "$ROOT/$1"; }
need() { [[ -f $(dir "$1")/vm.conf ]] || die "No VM called $1"; }
running() { local p; p=$(cat "$(dir "$1")/pid" 2>/dev/null) && kill -0 "$p" 2>/dev/null; }
stopped() { running "$1" && die "$1 is running: shut it down first"; return 0; }
# A snapshot command's checks: the VM, stopped (qemu-img writes the disk), and a tag
snap() { [[ -n ${3:-} ]] || die "$1 NAME TAG"; need "$2"; stopped "$2"; }

# One QMP command: the greeting, capabilities, then the command. From the VM's folder, as a socket's path is short (108)
qmp() {
  cd "$(dir "$1")"
  python3 -I - qmp.sock "$2" <<'EOF'
import json, socket, sys
s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); f = s.makefile("rw")
f.readline()
for cmd in ({"execute": "qmp_capabilities"}, {"execute": sys.argv[2]}):
    f.write(json.dumps(cmd) + "\n"); f.flush()
    while "return" not in (r := json.loads(f.readline())) and "error" not in r: pass
    if "error" in r: sys.exit(r["error"]["desc"])
EOF
}

list() {
  local first=1
  echo -n "["
  for d in "$ROOT"/*/; do
    [[ -f $d/vm.conf ]] || continue
    local name MEM CPUS ISO run=false
    name=$(basename "$d"); MEM=0; CPUS=0; ISO=""
    # shellcheck disable=SC1091
    source "$d/vm.conf"
    running "$name" && run=true
    # -U reads the disk while qemu holds its lock
    local info; info=$(qemu-img info -U --output=json "$d/disk.qcow2")
    ((first)) || echo -n ","; first=0
    jq -nc --arg name "$name" --argjson mem "$MEM" --argjson cpus "$CPUS" --arg iso "$ISO" --argjson run "$run" \
       --argjson info "$info" '{ name: $name, mem: $mem, cpus: $cpus, iso: $iso, running: $run,
         disk: ($info["virtual-size"] / 1073741824 | floor),
         snapshots: [($info.snapshots // [])[] | { tag: .name, date: (.["date-sec"] | strflocaltime("%d.%m. %H:%M")) }] }'
  done
  echo "]"
}

create() {
  local name=$1 iso=$2 mem=$3 disk=$4 cpus=${5:-4} d; d=$(dir "$1")
  [[ -e $d ]] && die "$name exists already"
  [[ -f $iso ]] || die "No such ISO: $iso"
  [[ $mem =~ ^[0-9]+$ && $disk =~ ^[0-9]+$ && $cpus =~ ^[0-9]+$ ]] || die "Memory, disk and CPUs are numbers"
  ((cpus >= 1 && cpus <= MAX_CPUS)) || die "CPUs: 1 to $MAX_CPUS"
  mkdir -p "$d"
  cp "$FW/vars-template-pflash.raw" "$d/vars.raw"
  qemu-img create -q -f qcow2 "$d/disk.qcow2" "${disk}G"
  printf 'MEM=%s\nCPUS=%s\nISO=%q\n' $((mem * 1024)) "$cpus" "$(realpath "$iso")" > "$d/vm.conf"
}

start() {
  need "$1"; running "$1" && return 0
  local name=$1 d MEM CPUS ISO; d=$(dir "$1")
  # shellcheck disable=SC1091
  source "$d/vm.conf"
  local cd=()
  [[ -n $ISO ]] && cd=(-device virtio-scsi-pci -device scsi-cd,drive=cd,bootindex=0
                       -drive "if=none,id=cd,media=cdrom,readonly=on,file=$ISO")
  rm -f "$d/qmp.sock"
  cd "$d"     # the socket by a short path (qmp)
  # GTK on Wayland gives a black window (eglMakeCurrent failed); under XWayland qemu's own EGL works
  GDK_BACKEND=x11 setsid -f taskset -c $PCORES qemu-system-aarch64 \
    -name "$name" \
    -machine virt,gic-version=3 -accel kvm -cpu host -smp "$CPUS" -m "${MEM}M" \
    -drive "if=pflash,format=raw,unit=0,readonly=on,file=$FW/QEMU_EFI-silent-pflash.raw" \
    -drive "if=pflash,format=raw,unit=1,file=$d/vars.raw" \
    -drive "if=virtio,format=qcow2,file=$d/disk.qcow2,discard=unmap,cache=writeback" \
    -device virtio-gpu-gl-pci,xres=1600,yres=1000 -display gtk,gl=on,zoom-to-fit=on \
    -device qemu-xhci -device usb-kbd -device usb-tablet \
    "${cd[@]}" \
    -nic user,model=virtio-net-pci \
    -qmp unix:qmp.sock,server,nowait \
    -pidfile "$d/pid" \
    -serial "file:$d/serial.log" > "$d/qemu.log" 2>&1
  for _ in $(seq 50); do running "$name" && return 0; sleep 0.1; done
  die "qemu didn't start: $(tail -3 "$d/qemu.log")"
}

# Its GTK window, found by qemu's pid
display() {
  need "$1"; running "$1" || die "$1 isn't running"
  local addr; addr=$(hyprctl -j clients | jq -r --argjson pid "$(cat "$(dir "$1")/pid")" \
                      '[.[] | select(.pid == $pid)] | first | .address // empty')
  [[ -n $addr ]] || die "No window for $1"
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null
}

case ${1:-} in
  list)     list ;;
  isos)     ls -t "$HOME"/Downloads/*.iso "$HOME"/vm/*.iso 2>/dev/null || true ;;
  create)   (($# >= 5)) || die "create NAME ISO MEM_GB DISK_GB [CPUS]"; create "${@:2}" ;;
  start)    start "$2" ;;
  stop)     need "$2"; running "$2" || exit 0; qmp "$2" system_powerdown ;;
  kill)     need "$2"; running "$2" || exit 0; qmp "$2" quit ;;
  display)  display "$2" ;;
  eject)    need "$2"; stopped "$2"; sed -i 's/^ISO=.*/ISO=""/' "$(dir "$2")/vm.conf" ;;
  delete)   need "$2"; stopped "$2"; rm -rf "$(dir "$2")" ;;
  snapshot) snap "$@"; qemu-img snapshot -c "$3" "$(dir "$2")/disk.qcow2" ;;
  restore)  snap "$@"; qemu-img snapshot -a "$3" "$(dir "$2")/disk.qcow2" ;;
  unsnap)   snap "$@"; qemu-img snapshot -d "$3" "$(dir "$2")/disk.qcow2" ;;
  *)        sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
