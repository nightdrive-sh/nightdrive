# Contacts' sync (plugins/contacts): fetches every account in ~/.config/contacts/accounts.conf into
# ~/.local/share/contacts with vdirsyncer. Run by nightdrive-contacts-sync.timer and `contacts sync`.
[Unit]
Description=Nightdrive Contacts: fetch contacts (vdirsyncer)
After=network-online.target
# Contacts is installed before its account is set up: nothing to fetch until then
ConditionPathExists=%h/.config/contacts/accounts.conf

[Service]
Type=oneshot
# Skip the round while the login keyring is locked: a password-cmd's secret-tool would otherwise pop up gnome-keyring's
# own password prompt (Mail's sync does the same, lib/keyring.py says why it's not a bare busctl)
ExecCondition=/bin/sh -c '! %h/.local/bin/contacts keyring-locked'
ExecStart=%h/.local/bin/contacts sync
