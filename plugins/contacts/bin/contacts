#!/bin/bash
# contacts: Nightdrive Contacts' sync and accounts (plugins/contacts, README.md). The window comes later.
set -u

APP_DIR=$(dirname "$(dirname "$(readlink -f "$0")")")   # the plugin's folder
CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/contacts
ACCOUNTS=$CONFIG_DIR/accounts.conf                      # the user's accounts (README.md › Setting up an account)
VDIRSYNCER_CONFIG=$CONFIG_DIR/vdirsyncer                # written from accounts.conf by lib/config.py
DATA_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/contacts  # the vCards, a folder per account
SYNC_UNIT=nightdrive-contacts-sync.service              # systemd/, `contacts enable`
SYNC_LOCK=${XDG_RUNTIME_DIR:-/tmp}/nightdrive/contacts-sync.lock

vds() { vdirsyncer -c "$VDIRSYNCER_CONFIG" "$@"; }

# sync [NAME…]: the accounts' address books down to DATA_DIR, one sync at a time (the timer's and yours wait for each other)
sync_now() {
  [[ -f $ACCOUNTS ]] || { echo "No accounts yet: contacts setup, or README.md › Setting up an account." >&2; return 1; }
  mkdir -p "$(dirname "$SYNC_LOCK")"
  exec 9>"$SYNC_LOCK"
  flock 9
  local out
  local -a names
  out=$(python3 "$APP_DIR/lib/config.py" write) || return 1
  mapfile -t names <<<"$out"
  [[ -n $out ]] || names=()
  (($#)) && names=("$@")
  ((${#names[@]})) || { echo "No accounts in $ACCOUNTS." >&2; return 1; }
  # discover finds an account's address books (and new ones later); it asks before making their folders, so say yes
  yes | vds discover "${names[@]}" >/dev/null || return 1
  vds sync "${names[@]}"
}

# accounts: each one with its number of contacts here
list_accounts() {
  local name n
  [[ -f $ACCOUNTS ]] || { echo "No accounts yet."; return 0; }
  while read -r name; do
    n=$(find "$DATA_DIR/$name" -name '*.vcf' 2>/dev/null | wc -l)
    printf '%-16s %s contacts\n' "$name" "$n"
  done < <(python3 "$APP_DIR/lib/config.py" names)
}

# The sync's units in the plugin's folder, enabled by their path (as Mail's: that links them again after a disable)
enable() {
  systemctl --user link "$APP_DIR/systemd/$SYNC_UNIT" >/dev/null
  systemctl --user enable --now "$APP_DIR/systemd/${SYNC_UNIT%.service}.timer"
}
disable() {
  systemctl --user disable --now "${SYNC_UNIT%.service}.timer" 2>/dev/null
  echo "The sync is off. Your contacts stay in $DATA_DIR and your accounts in $ACCOUNTS."
}

# Setting up an account with Claude: Claude Code in a terminal goes through README.md › Setting up an account with you.
# The password goes in by a command you run yourself (! secret-tool …), so it never passes through Claude.
setup() {
  local claude=$HOME/.local/bin/claude
  [[ -x $claude ]] || claude=$(command -v claude) || { echo "Claude Code is not installed: README.md › Setting up an account has the steps." >&2; return 1; }
  # Clear inherited CLAUDE* variables, so the new Claude doesn't think it's a child session (as terminal-or-claude does)
  for v in $(compgen -e | grep '^CLAUDE'); do unset "$v"; done
  local prompt="Set up my contacts for Nightdrive Contacts, by the steps in $APP_DIR/README.md, section \"Setting up an account\". \
Read it first, then go through it with me one step at a time, saying in plain words what each step is for. Contacts' plugin \
is installed. Start by asking where my contacts are (iCloud, Google or another CardDAV server) and the account's address. \
Never ask me to type a password into this chat: give me the secret-tool command to run myself with ! in front of it, which \
asks for the password in the terminal. If I already use Nightdrive Mail with the same account, its keyring entry may do \
(the README says when). If $ACCOUNTS is already there, add to it instead of replacing it. Finish with \`contacts sync\` and \
\`contacts accounts\`, then \`contacts enable\`. Once that account works, ask whether I want to add another one."
  setsid -f "$HOME/.config/hypr/scripts/terminal" --dir "$HOME" -- "$claude" -- "$prompt" >/dev/null 2>&1
}

usage() {
  cat <<USAGE
Usage: contacts [command]

  setup          set up an account with Claude, in a terminal
  sync [NAME…]   fetch the contacts of every account (or these) now
  accounts       the accounts and how many contacts each has here
  enable         sync every 30 minutes (the installer)
  disable        stop the sync (your contacts and accounts stay)
  keyring-locked exit 0 if the login keyring is locked (the sync skips its round then)
  vdirsyncer …   vdirsyncer with Contacts' config, for a closer look
  help           this text
USAGE
}

case ${1:-help} in
  sync)      sync_now "${@:2}" ;;
  accounts)  list_accounts ;;
  setup)     setup ;;
  enable)    enable ;;
  disable)   disable ;;
  keyring-locked) python3 "$APP_DIR/lib/keyring.py" ;;
  vdirsyncer) python3 "$APP_DIR/lib/config.py" write >/dev/null && vds "${@:2}" ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
