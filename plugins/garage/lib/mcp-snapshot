#!/bin/bash
# Claude's garage_snapshot (mcp.json): a snapshot of a stopped VM as the window takes one (SnapshotList.qml's take):
# the tag is the time, unique and without spaces, and the label what shows. Prints {vm, tag, label}: the tool's undo
# deletes it by that tag. garage-ctl checks the name and that the VM is stopped.
#   mcp-snapshot NAME [-- LABEL]     (the -- as the tool's argv has it: a label may begin with -)
set -euo pipefail
name=$1
[[ ${2:-} == -- ]] && set -- "$1" "${@:3}"
label=${2:-"Snapshot $(date '+%-d.%-m. %H:%M')"}
tag=s$(date +%s)
garage-ctl snapshot "$name" "$tag" "$label"
jq -nc --arg vm "$name" --arg tag "$tag" --arg label "$label" '{vm: $vm, tag: $tag, label: $label}'
