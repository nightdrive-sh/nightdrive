#!/usr/bin/python3 -I
"""Home Assistant for the launcher (Home), the top bar's Home menu and the bar icon (plugins/home-assistant; linked to
~/.local/bin, where Home.qml runs it). Set up with the plugin's install.sh.

  home-assistant configured        exit status 0 when set up (the launcher and the bar show Home only then)
  home-assistant states            the controllable devices as JSON: [{id, name, domain, state, on, area, fav, detail,
                                   dimmable, bright}] (bright 0..1, 0 when off; dimmable: a light with brightness)
      --search TEXT                only those whose name, area or id has TEXT (any case)
      --sensors                    sensors and binary sensors too (temperature, a door's contact), after the devices;
                                   for Claude without presence, occupancy and motion, nor a phone's whereabouts,
                                   unless Access allows them
      --brief                      only {id, name, state} and area and detail when they say something (for Claude:
                                   a home's whole list is long)
  home-assistant toggle ID         turns a device on/off, runs a scene / script / automation, presses a button
  home-assistant set ID STATE      puts a device in a state, whatever it is now, and prints it then as JSON {id, name,
                                   state, detail}: on|off (lights, switches, fans, climate, media players, automations),
                                   open|close (covers), lock|unlock (locks), run (scenes, scripts, buttons; triggers an
                                   automation). Claude's home_assistant_set (mcp.json), after the user allows it
      --check                      changes nothing: checks the call and prints what the card shows of the device,
                                   {Device, Room, Now} from Home Assistant (mcp.json's card)
  home-assistant brightness ID PCT sets a light's brightness, 0–100 (0 turns it off)
  home-assistant fav ID [on|off]   pins a device to the top bar's Home menu (no on/off: flips it)
  home-assistant bar               the top bar module's state line (modules.jsonc format)
  home-assistant open              opens the Home Assistant webapp (focuses it if already open)
  home-assistant test URL < TOKEN  checks an address and a token, read from stdin to keep it out of argv (install.sh)

Config: ~/.config/nightdrive/home-assistant (KEY=value, mode 600):
  HA_URLS="http://homeassistant.local:8123 http://ha:8123 https://xxxx.ui.nabu.casa"   tried in order, like the
          official apps' internal / external URL: the first that answers is used and remembered for a while
  HA_TOKEN=…               a long-lived access token (HA › Profile › Security), or
  HA_TOKEN_CMD="op read op://Private/Home Assistant/token"   a command that prints it
Pinned devices: ~/.local/state/nightdrive/home-favorites, one entity id per line.

Claude's calls (NIGHTDRIVE_MCP=1, from Nightdrive's MCP server) keep to Settings › Claude › Access › Home Assistant,
which the server gives in NIGHTDRIVE_MCP_OPTIONS (#1830): unlock (unlock locks, open covers), automations (turn one on
or off), presence (presence, occupancy and motion sensors, and a phone's whereabouts from the companion app). One that
isn't there is off. The launcher and the bar don't
set it, so the user's own controls are as they were.
"""
import json, os, re, shlex, subprocess, sys, time, urllib.error, urllib.request

HOME = os.environ["HOME"]
CONFIG = f"{HOME}/.config/nightdrive/home-assistant"
FAVS = f"{HOME}/.local/state/nightdrive/home-favorites"
CACHE = f"{HOME}/.cache/nightdrive/home-assistant-url"
# HA_TOKEN_CMD's answer, until logout. Never in /tmp: a file another user made there first would get the token.
TOKEN_CACHE = f"{os.environ.get('XDG_RUNTIME_DIR') or f'/run/user/{os.getuid()}'}/nightdrive-ha-token"
PROBE_TIMEOUT = 1.5      # s per address while looking for one that answers
TIMEOUT = 8              # s for a request to the chosen address
RECHECK = 300            # s: a fallback address is used this long before the preferred ones are tried again
WEBAPP = "home-assistant"   # webapp-add's slug: ~/.local/share/applications/webapp-home-assistant.desktop

# What the launcher can control, in this order (its sections). Sensors and the like are left out: nothing to press.
DOMAINS = ["light", "switch", "fan", "cover", "climate", "media_player", "lock", "input_boolean", "scene", "script",
           "automation", "button", "input_button"]
# Entities with these states have no on/off to show
ONE_SHOT = {"scene", "script", "button", "input_button"}
# Read only: with --sensors, so Claude can answer "is it cold outside" or "is the door open"
SENSORS = ["sensor", "binary_sensor"]
# A binary sensor's on/off in words, by its device class: "off" for a door means it's closed
BINARY = {"door": ("open", "closed"), "window": ("open", "closed"), "opening": ("open", "closed"),
          "garage_door": ("open", "closed"), "motion": ("detected", "clear"), "occupancy": ("detected", "clear"),
          "presence": ("home", "away"), "moisture": ("wet", "dry"), "lock": ("unlocked", "locked"),
          "battery": ("low", "normal"), "smoke": ("smoke", "clear"), "problem": ("problem", "ok")}

# set's states, by domain: (domain, service) for each. Explicit, unlike toggle: Claude says which state it wants, and
# the confirmation card shows that, so the result doesn't depend on a state read a moment earlier.
SWITCHED = ("light", "switch", "fan", "climate", "media_player", "input_boolean", "automation")
SET = {**{d: {"on": (d, "turn_on"), "off": (d, "turn_off")} for d in SWITCHED},
       "cover": {"open": ("cover", "open_cover"), "close": ("cover", "close_cover")},
       "lock": {"lock": ("lock", "lock"), "unlock": ("lock", "unlock")},
       "scene": {"run": ("scene", "turn_on")}, "script": {"run": ("script", "turn_on")},
       "button": {"run": ("button", "press")}, "input_button": {"run": ("input_button", "press")}}
SET["automation"]["run"] = ("automation", "trigger")
# automation.trigger skips the automation's conditions unless told not to: run as it would run by itself, so "only
# when someone is home" or "only at night" still hold (#1866)
SERVICE_DATA = {("automation", "trigger"): {"skip_condition": False}}

# What each of Access's Home Assistant choices allows Claude (config/mcp/areas.py): (domain, state) → option
NEEDS = {("lock", "unlock"): "unlock", ("cover", "open"): "unlock",
         ("automation", "on"): "automations", ("automation", "off"): "automations"}
# What tells whether anyone is home, which Claude gets only with the presence choice: binary sensors of these classes,
# and the sensors of Home Assistant's phone app that say where a phone is (its street address, its distance from
# home, the Wi-Fi it's on, whether its owner walks or drives), by the ids the app gives them
PRESENCE = {"presence", "occupancy", "motion"}
WHEREABOUTS = re.compile(r"_(geocoded_location|distance|ssid|bssid|activity|direction_of_travel)(_\d+)?$")
# …and those that say it by their name, without a class: a template binary_sensor.jari_home, "Someone home" (#1866).
# A word of the id or the name; a sensor's "home" is a place's (sensor.home_temperature), so not counted there
PRESENCE_WORDS = {"presence", "occupancy", "occupied", "motion", "away", "location", "whereabouts", "someone",
                  "anyone", "nobody", "läsnä", "läsnäolo", "kotona", "poissa", "liike", "paikalla", "sijainti"}
ENTITY = re.compile(r"[a-z_]+\.[a-z0-9_]+")


def claude_options():
    """Access's choices for Claude's call, {option: on}; None when this isn't Claude's (no limits). What can't be read
    is {}: every choice off, as they only ever allow more."""
    if os.environ.get("NIGHTDRIVE_MCP") != "1":
        return None
    try:
        options = json.loads(os.environ.get("NIGHTDRIVE_MCP_OPTIONS", ""))
    except ValueError:
        return {}
    return options if isinstance(options, dict) else {}


def allowed(option):
    options = claude_options()
    return options is None or options.get(option) is True


def presence(domain, eid, attrs):
    name = attrs.get("friendly_name") if isinstance(attrs.get("friendly_name"), str) else ""
    words = set(re.split(r"[\W_]+", f"{eid.partition('.')[2]} {name}".lower())) - {""}
    if domain == "binary_sensor":
        return attrs.get("device_class") in PRESENCE or bool(words & (PRESENCE_WORDS | {"home"}))
    return domain == "sensor" and (bool(WHEREABOUTS.search(eid)) or bool(words & PRESENCE_WORDS))


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def load_config():
    cfg = {}
    try:
        for line in open(CONFIG):
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            v = v.strip()
            cfg[k.strip()] = " ".join(shlex.split(v)) if v else ""
    except FileNotFoundError:
        pass
    return cfg


def token(cfg):
    if cfg.get("HA_TOKEN"):
        return cfg["HA_TOKEN"]
    if not cfg.get("HA_TOKEN_CMD"):
        return ""
    # Asking 1Password every few seconds would be slow (and may prompt): keep the answer in the runtime dir
    try:
        return open(TOKEN_CACHE).read().strip()
    except FileNotFoundError:
        pass
    t = subprocess.run(["bash", "-c", cfg["HA_TOKEN_CMD"]], capture_output=True, text=True).stdout.strip()
    if t:
        try:
            fd = os.open(TOKEN_CACHE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            os.write(fd, t.encode())
            os.close(fd)
        except OSError:   # no runtime dir (outside a login session): asked again next time
            pass
    return t


def request(base, tok, method, path, body=None, timeout=TIMEOUT):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(base.rstrip("/") + path, data=data, method=method,
                                 headers={"Authorization": "Bearer " + tok, "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        raw = r.read().decode()
    return json.loads(raw) if raw.strip().startswith(("{", "[")) else raw


def reachable(base, tok):
    try:
        request(base, tok, "GET", "/api/", timeout=PROBE_TIMEOUT)
        return True
    except urllib.error.HTTPError as e:
        if e.code == 401:
            die("Home Assistant refused the token (401): make a new one in HA › Profile › Security")
        return False
    except Exception:
        return False


class Client:
    """The first address in HA_URLS that answers. The choice is remembered; a fallback (say Tailscale while away) is
    re-checked after RECHECK seconds, so the local address comes back when you're home."""

    def __init__(self):
        cfg = load_config()
        self.urls = cfg.get("HA_URLS", "").split()
        self.tok = token(cfg)
        if not self.urls or not self.tok:
            die("Home Assistant isn't set up: nightdrive plugins install home-assistant", 3)
        self.base = None

    def pick(self):
        try:
            cached = open(CACHE).read().strip()
            age = time.time() - os.path.getmtime(CACHE)
        except FileNotFoundError:
            cached, age = "", 0
        if cached in self.urls and (cached == self.urls[0] or age < RECHECK):
            return cached
        for u in self.urls:
            if reachable(u, self.tok):
                os.makedirs(os.path.dirname(CACHE), exist_ok=True)
                with open(CACHE, "w") as f:
                    f.write(u)
                return u
        die("Home Assistant doesn't answer at " + ", ".join(self.urls), 4)

    def call(self, method, path, body=None):
        self.base = self.base or self.pick()
        try:
            return request(self.base, self.tok, method, path, body)
        except urllib.error.HTTPError as e:
            if e.code == 401:
                die("Home Assistant refused the token (401): make a new one in HA › Profile › Security")
            raise
        except (urllib.error.URLError, TimeoutError, OSError):
            # The remembered address stopped answering (left home, Wi-Fi changed): look again once
            try:
                os.remove(CACHE)
            except FileNotFoundError:
                pass
            self.base = self.pick()
            return request(self.base, self.tok, method, path, body)


def favorites():
    try:
        return [l.strip() for l in open(FAVS) if l.strip()]
    except FileNotFoundError:
        return []


# Area names in one request (the REST API's states don't have them); empty if the template fails
AREAS_TEMPLATE = ("{% set ns = namespace(o={}) %}{% for s in states %}{% set a = area_name(s.entity_id) %}"
                  "{% if a %}{% set ns.o = dict(ns.o, **{s.entity_id: a}) %}{% endif %}{% endfor %}{{ ns.o | tojson }}")


def detail(domain, s):
    a = s.get("attributes", {})
    st = s.get("state", "")
    if st in ("unavailable", "unknown"):
        return st
    if domain == "light" and st == "on" and a.get("brightness") is not None:
        return f"{round(a['brightness'] / 2.55)}%"
    if domain == "climate":
        cur = a.get("current_temperature")
        return f"{st} · {cur}°" if cur is not None else st
    if domain == "cover" and a.get("current_position") is not None:
        return f"{st} · {a['current_position']}%"
    if domain == "media_player" and st == "playing" and a.get("media_title"):
        return a["media_title"]
    if domain in ONE_SHOT:
        return ""
    if domain == "binary_sensor" and a.get("device_class") in BINARY and st in ("on", "off"):
        return BINARY[a["device_class"]][st == "off"]
    if a.get("unit_of_measurement"):
        return f"{st} {a['unit_of_measurement']}"
    return st


def dimmable(domain, a):
    if domain != "light":
        return False
    modes = a.get("supported_color_modes")
    if modes:
        return any(m != "onoff" for m in modes)
    return a.get("brightness") is not None   # older integrations: no color modes, brightness only while on


def is_on(domain, st):
    if domain == "cover":
        return st in ("open", "opening")
    if domain == "lock":
        return st == "unlocked"
    if domain == "climate":
        return st not in ("off", "unavailable", "unknown")
    if domain == "media_player":
        return st in ("playing", "on", "idle", "paused", "buffering")
    return st == "on"


def states(c, search="", sensors=False):
    domains = DOMAINS + (SENSORS if sensors else [])
    raw = c.call("GET", "/api/states")
    try:
        areas = c.call("POST", "/api/template", {"template": AREAS_TEMPLATE})   # rendered text, which request() parses
        areas = json.loads(areas) if isinstance(areas, str) else areas
    except Exception:
        areas = {}
    favs = favorites()
    out = []
    for s in raw:
        eid = s["entity_id"]
        domain = eid.split(".", 1)[0]
        if domain not in domains:
            continue
        if domain in SENSORS and presence(domain, eid, s.get("attributes", {})) and not allowed("presence"):
            continue
        name = s.get("attributes", {}).get("friendly_name") or eid
        area = areas.get(eid, "") if isinstance(areas, dict) else ""
        # "Olohuone Olohuoneen valo" reads badly: drop the area from the name's start when it's there
        if area and name.lower().startswith(area.lower() + " "):
            name = name[len(area) + 1:]
        attrs = s.get("attributes", {})
        on = is_on(domain, s.get("state", ""))
        out.append({"id": eid, "name": name, "domain": domain, "state": s.get("state", ""),
                    "on": on, "area": area, "fav": eid in favs, "detail": detail(domain, s),
                    "dimmable": dimmable(domain, attrs),
                    "bright": round((attrs.get("brightness") or 0) / 255, 3) if on and domain == "light" else 0})
    if search:
        out = [e for e in out if any(search.casefold() in e[k].casefold() for k in ("name", "area", "id"))]
    out.sort(key=lambda e: (domains.index(e["domain"]), e["area"].lower(), e["name"].lower()))
    return out


def toggle(c, eid):
    domain = eid.split(".", 1)[0]
    if domain in ("scene", "script"):
        svc = (domain, "turn_on")
    elif domain == "automation":
        svc = ("automation", "trigger")   # run it now; turning one on/off stays in HA (a stray Enter shouldn't disable it)
    elif domain in ("button", "input_button"):
        svc = (domain, "press")
    elif domain == "lock":
        st = c.call("GET", "/api/states/" + eid).get("state")
        svc = ("lock", "lock" if st == "unlocked" else "unlock")
    elif domain == "media_player":
        svc = ("media_player", "media_play_pause")
    else:
        svc = ("homeassistant", "toggle")
    c.call("POST", f"/api/services/{svc[0]}/{svc[1]}", {"entity_id": eid})


def refusal(domain, eid, state):
    """Why Access doesn't let Claude put this device in this state, in words for Claude; None when it does."""
    option = NEEDS.get((domain, state))
    if not option or allowed(option):
        return None
    why = {"unlock": "lets Claude only lock locks and close covers",
           "automations": "lets Claude run an automation but not turn one on or off"}[option]
    return (f"{eid} wasn't set to {state}: the user's Access (Settings › Claude › Access › Home Assistant) {why}. "
            "That is theirs to do; don't try it another way.")


def area_of(c, eid):
    """The device's area in Home Assistant, "" if none. The id goes in as a template variable, never into the
    template's text."""
    try:
        area = c.call("POST", "/api/template", {"template": "{{ area_name(eid) or '' }}", "variables": {"eid": eid}})
    except Exception:
        return ""
    return area.strip() if isinstance(area, str) else ""


def card(c, eid, now):
    """The confirmation card's rows for this device, from Home Assistant: its name, room and state now. They stand
    beside the id Claude gave, so the user sees that switch.sonoff_1000a is the oven."""
    domain = eid.split(".", 1)[0]
    name = now.get("attributes", {}).get("friendly_name") or eid
    room = area_of(c, eid)
    if room and name.lower().startswith(room.lower() + " "):
        name = name[len(room) + 1:]
    out = {"Device": name}
    if room:
        out["Room"] = room
    state, said = now.get("state", ""), detail(domain, now)
    if domain not in ONE_SHOT:   # a scene's state is when it last ran
        out["Now"] = state if said in ("", state) else said if said.startswith(state) else f"{state} · {said}"
    print(json.dumps(out, ensure_ascii=False))


def set_state(c, eid, state, check=False):
    domain = eid.split(".", 1)[0]
    choices = SET.get(domain)
    if not ENTITY.fullmatch(eid):
        die(f"{eid!r} isn't a Home Assistant id (light.kitchen): `home-assistant states` lists them")
    if not choices:
        die(f"{eid}: set handles {', '.join(SET)}; a {domain} has no state to set")
    if state not in choices:
        die(f"{eid} is a {domain}: its states are {' and '.join(choices)}, not {state}")
    no = refusal(domain, eid, state)
    if no:
        die(no)
    try:
        before = c.call("GET", "/api/states/" + eid)
    except urllib.error.HTTPError as e:
        if e.code == 404:
            die(f"Home Assistant has no {eid}: `home-assistant states` lists the devices")
        raise
    if check:
        card(c, eid, before)
        return
    svc = choices[state]
    changed = c.call("POST", f"/api/services/{svc[0]}/{svc[1]}", {"entity_id": eid, **SERVICE_DATA.get(svc, {})})
    # The service answers with the states it changed; one that changes later (a cover moving) isn't there yet
    now = next((s for s in changed if s.get("entity_id") == eid), None) if isinstance(changed, list) else None
    now = now or c.call("GET", "/api/states/" + eid) or before
    out = {"id": eid, "name": now.get("attributes", {}).get("friendly_name") or eid, "state": now.get("state", "")}
    if detail(domain, now) not in ("", out["state"]):
        out["detail"] = detail(domain, now)
    print(json.dumps(out, ensure_ascii=False))


def brightness(c, eid, pct):
    pct = max(0, min(100, round(float(pct))))
    if pct == 0:
        c.call("POST", "/api/services/light/turn_off", {"entity_id": eid})
    else:
        c.call("POST", "/api/services/light/turn_on", {"entity_id": eid, "brightness_pct": pct})


def set_fav(eid, on):
    favs = favorites()
    if on is None:
        on = eid not in favs
    favs = [f for f in favs if f != eid] + ([eid] if on else [])
    os.makedirs(os.path.dirname(FAVS), exist_ok=True)
    with open(FAVS, "w") as f:
        f.write("".join(x + "\n" for x in favs))
    print("on" if on else "off")


def bar():
    cfg = load_config()
    if not cfg.get("HA_URLS"):
        print(json.dumps({"icon": "", "text": ""}))   # not set up: the module stays hidden
        return
    try:
        Client().call("GET", "/api/")
        print(json.dumps({"icon": "house", "text": ""}))
    except (SystemExit, Exception):
        print(json.dumps({"icon": "house", "text": "", "class": "stale"}))   # doesn't answer: faded


def open_webapp():
    desktop = f"{HOME}/.local/share/applications/webapp-{WEBAPP}.desktop"
    if not os.path.exists(desktop):
        die("No Home Assistant webapp: nightdrive plugins install home-assistant")
    wmclass = next((l.split("=", 1)[1].strip() for l in open(desktop) if l.startswith("StartupWMClass=")), "")
    os.execv(f"{HOME}/.config/hypr/scripts/launch-or-focus", ["launch-or-focus", "^" + wmclass + "$", "gtk-launch", f"webapp-{WEBAPP}"])


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else ""
    if cmd == "configured":
        cfg = load_config()
        sys.exit(0 if cfg.get("HA_URLS") and (cfg.get("HA_TOKEN") or cfg.get("HA_TOKEN_CMD")) else 1)
    elif cmd == "states":
        opts, search = a[1:], ""
        if "--search" in opts:
            i = opts.index("--search")
            if i + 1 >= len(opts):
                die("--search needs a text", 2)
            search = opts.pop(i + 1)
            opts.pop(i)
        sensors, brief = "--sensors" in opts, "--brief" in opts
        if [o for o in opts if o not in ("--sensors", "--brief")]:
            die(__doc__.split("\n\n")[1], 2)
        out = states(Client(), search, sensors)
        if brief:
            out = [{"id": e["id"], "name": e["name"], "state": e["state"],
                    **{k: e[k] for k in ("area", "detail") if e[k] and e[k] != e["state"]}} for e in out]
        print(json.dumps(out, ensure_ascii=False))
    elif cmd == "toggle" and len(a) == 2:
        toggle(Client(), a[1])
    elif cmd == "set" and len(a) in (3, 4) and a[3:] in ([], ["--check"]):
        set_state(Client(), a[1], a[2], check=len(a) == 4)
    elif cmd == "brightness" and len(a) == 3:
        brightness(Client(), a[1], a[2])
    elif cmd == "fav" and len(a) in (2, 3):
        set_fav(a[1], None if len(a) == 2 else a[2] == "on")
    elif cmd == "bar":
        bar()
    elif cmd == "open":
        open_webapp()
    elif cmd == "test" and len(a) == 2:
        # The token comes on stdin: as an argument any user could read it in /proc
        tok = sys.stdin.readline().strip()
        try:
            r = request(a[1], tok, "GET", "/api/config", timeout=5)
            print(r.get("location_name", "Home Assistant"), r.get("version", ""))
        except urllib.error.HTTPError as e:
            die(f"{a[1]}: HTTP {e.code}" + (" (the token was refused)" if e.code == 401 else ""))
        except Exception as e:
            die(f"{a[1]}: no answer ({getattr(e, 'reason', e)})")
    else:
        die(__doc__.split("\n\n")[1], 2)


if __name__ == "__main__":
    main()
