#!/bin/bash
# Deck's top bar module (module.jsonc): dimmed when Deck isn't running or has nothing loaded, highlighted while playing
. ~/.config/topbar/scripts/emit
f="${XDG_RUNTIME_DIR:-/run/user/$UID}/deck/state.json"
pid=$(jq -r '.pid // empty' "$f" 2>/dev/null)
if [[ -z $pid || ! -d /proc/$pid ]] || [[ $(jq -c '.info' "$f") == null ]]; then emit music "" off; exit; fi
if [[ $(jq -r .info.playing "$f") == true ]]; then emit music "" active; else emit music ""; fi
