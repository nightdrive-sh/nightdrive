#!/bin/bash
# deck-window [search QUERY | player | setup | configured | restart | quit | log]: Deck's window (app/, a Quickshell config of its own) over
# the player, `deck serve`, which is started first if no Deck runs. The window only talks to the player, so closing it
# leaves the music playing. `deck` opens it (Deck hands over to a deck-window on PATH; `deck tui` is Deck's own screen in
# the terminal), and so do the launcher, the bar, Hyper+M and F8 (hypr/scripts/media), as ~/.local/bin/deck-window.
set -u

APP_DIR=$(dirname "$(dirname "$(readlink -f "$0")")")   # the plugin's folder
QS_DIR=$APP_DIR/app
DECK=$HOME/.local/bin/deck
RUNTIME=${XDG_RUNTIME_DIR:-/tmp}/deck
DECK_CONFIG=$HOME/.config/deck/config.toml
SERVE_LOG=$HOME/.cache/deck/serve.log                   # what `deck serve` says before its own log (deck.log) opens
START_WAIT=50                                           # × 0.2 s for the player to answer
DECK_README=${DECK_SRC:-$HOME/.local/src/deck}/README.md  # a source build's clone (install.sh)
DECK_README_PKG=/usr/share/doc/deck/README.md            # the deck package's
DECK_README_URL=https://github.com/nightdrive-sh/deck/blob/main/README.md

# The window: started, brought forward, waited for and stopped by the apps' kit (app/kit/app.sh)
APP_TITLE=Deck
APP_IPC=deck
. "$QS_DIR/kit/app.sh"

# A Deck answers `deck ctl`: its state file's pid (its Now Playing helper's, which serves the control socket) lives.
# A killed one leaves the file behind.
player_ready() {
  local pid
  pid=$(jq -r '.pid // empty' "$RUNTIME/state.json" 2>/dev/null)
  [[ -n $pid && -d /proc/$pid ]]
}

# A Deck runs: it holds its lock from its very start, before it has signed in (Deck's src/instance.rs). The state file
# alone let a second Deck start beside one that was still signing in or had lost its helper, and both played (#1680).
# A Deck built before the lock shows only by its state file.
player_running() {
  { [[ -e $RUNTIME/deck.lock ]] && ! flock -n "$RUNTIME/deck.lock" true; } || player_ready
}

# Starts the player if none runs, then waits until it answers, so a command right after (deck-ctl) reaches it
start_player() {
  if ! player_running; then
    mkdir -p "$(dirname "$SERVE_LOG")"
    setsid -f "$DECK" serve >"$SERVE_LOG" 2>&1 </dev/null
  fi
  for _ in $(seq "$START_WAIT"); do
    player_ready && return 0
    sleep 0.2
  done
  # Still signing in (the first sign-in waits for the browser), or it stopped: then its last words say why. A Deck
  # built before the lock shows only as a process.
  player_running && return 0
  pgrep -xf "$DECK serve" >/dev/null && return 0
  notify-send -a Deck "Deck didn't start" "$(tail -n 1 "$SERVE_LOG" 2>/dev/null)"
  return 1
}

# What Deck's config has, as the window reads it (app/shell.qml): your own Spotify app, and Curated's taste (Last.fm, or a
# few lines of your own in taste.md). Both there is Deck set up: `configured`, plugin.conf's test for Welcome.
has_app() { grep -qE '^\s*client_id\s*=\s*"[^"]+"' "$DECK_CONFIG" 2>/dev/null; }
has_taste() {
  { grep -qE '^\s*lastfm_api_key\s*=\s*"[^"]+"' "$DECK_CONFIG" && grep -qE '^\s*lastfm_user\s*=\s*"[^"]+"' "$DECK_CONFIG"; } 2>/dev/null \
    || grep -q '[^[:space:]]' "$HOME/.config/deck/taste.md" 2>/dev/null
}

# Setting up Deck with Claude (the window's first start offers it, and so does Curated until it is done): Claude Code
# in a terminal goes through what Deck's config still lacks, by Deck's README: your own Spotify app (its Client ID, for
# likes, search and Curated) and Curated's taste (Last.fm, or a few lines of your own in taste.md). The first list is then made by Curated's New list button, which the
# window follows. Sign-ins happen in the browser only. claude-setup holds the session to this (Welcome to Nightdrive runs
# it too), and its start tells the window not to offer it again.
setup() {
  local readme=$DECK_README steps="" n=1
  [[ -f $readme ]] || readme=$DECK_README_PKG
  [[ -f $readme ]] || readme=$DECK_README_URL
  if ! has_app; then
    steps+="$n) My own Spotify app, by the README's \"2. Create your own Spotify app\" and \"3. Write the config file\": \
guide me through the developer dashboard (it needs the same Spotify account I play with, with Premium). I paste the Client \
ID here and you add client_id to ~/.config/deck/config.toml, keeping the lines already there. Then restart the player so it \
signs in to the app: \`deck ctl quit\`, then \`deck-window player\`; my browser opens \"Sign in to the Deck Spotify app\", \
and I accept it there. "
    n=$((n + 1))
  fi
  if ! has_taste; then
    steps+="$n) Curated's taste, by the README's \"Setting up Curated (optional, recommended)\". First ask whether I have a \
Last.fm account that has been recording my listening for a while (Spotify can scrobble there: Settings › Applications). If \
so, the API key: I paste it here, and you add lastfm_api_key and lastfm_user to the config, keeping the lines already there. \
If not, don't send me to make one (a new account has no history yet; I can add it later): talk with me about the music I \
like instead (artists and albums I love, eras, moods, what I want more of, what I don't), a few questions at a time, and \
write it in my words to ~/.config/deck/taste.md; tell me that putting favourite albums on Deck's shelf (Search, then a) \
helps too, and that the list gets better as I play in Deck. Either way, check it with \`deck taste\` and fix what its \
error names. Skip that section's steps 2 and 3: don't run \`deck curate\` and don't install the weekly job (it is macOS's \
launchd). "
  fi
  [[ -n $steps ]] || steps="Everything is in the config already: check it with \`deck taste\` and tell me what is wrong if it fails. "
  local prompt="Set up Deck, my Spotify player, with me by its README ($readme). Read it first, then go through these one \
step at a time, saying in plain words what each is for: I may not know Spotify's developer dashboard or Last.fm. Deck is \
installed (its player signs in to Spotify in my browser the first time it starts), and Claude Code is this session. Never ask for a password: sign-ins \
happen in my browser. $steps
Finish by telling me to press New list in Deck's window, under Curated (⌘2): it makes the first list in a few minutes, on \
my Claude plan."
  "$HOME/.config/hypr/scripts/claude-setup" deck Deck <<<"$prompt"
}

usage() { echo "usage: deck-window [search QUERY | player | setup | configured | restart | quit | log]" >&2; }

case ${1:-open} in
  open)
    start_player || exit 1
    # Autostart's background apps start hidden: the player, not the window
    [[ -n ${LAUNCH_HIDDEN:-} ]] || open_window
    ;;
  player)   start_player ;;
  setup)    setup ;;
  configured) has_app && has_taste ;;
  search)   start_player || exit 1; open_ready; ipc search "${*:2}" ;;
  quit)     stop; "$DECK" ctl quit 2>/dev/null ;;
  # The window anew, over a player started first if none runs, as open does
  restart)  start_player || exit 1; app_command restart ;;
  settings) usage; exit 2 ;;      # none yet
  *)
    app_command "$@"; status=$?    # restart, log
    ((status == 2)) && { usage; exit 2; }
    exit $status
    ;;
esac
