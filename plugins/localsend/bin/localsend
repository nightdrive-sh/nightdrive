#!/usr/bin/python3
"""LocalSend: receives files and text from phones and other computers running LocalSend (https://localsend.org).

    localsend status                   on, or off and why (turned off as a plugin, the receiver not running)
    localsend enable | disable         the receiver on/off (nightdrive-localsend.service, starts with the session)
    localsend run                      the receiver itself (the service)
    localsend devices                  the devices on the network (JSON), after asking them to answer
    localsend send FILE…               sends files or folders (Files › Send with LocalSend)
    localsend send-clipboard           sends the clipboard's text (launcher › Tools › LocalSend)
    localsend send-pick                picks files in a file chooser and sends them (launcher › Tools › LocalSend)
    localsend forget                   forgets the trusted devices: the next send to each asks again

The LocalSend app's own window isn't needed: this speaks its protocol (github.com/localsend/protocol, v2). It answers
the multicast discovery on the local network, so the computer shows up in the phone's LocalSend under its host name.
A send needs a code: it shows in the middle of the screen, the phone's LocalSend asks for it, and typing it there is the
Accept (lib/codes.py). Files go to the Downloads folder; a text (LocalSend's "Text" or a shared link) is shown in a
notification with a Copy button. The connection is HTTPS with a self-signed certificate made on the first run, as
LocalSend does (lib/server.py, lib/receiver.py).

Sending goes the other way (lib/sender.py): the devices that announced themselves to the receiver are remembered, a
send asks them to answer again, one device is used as it is and several are picked from a list. The first send to a
device asks, and pins its certificate: a later one goes only to the device with that certificate. The phone asks its
user, so the LocalSend app has to be open there (iOS doesn't let it listen in the background).
"""
import json
import os
import shutil
import subprocess
import sys

# The modules beside this command's folder (it is linked to ~/.local/bin)
sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
import common  # noqa: E402
import sender  # noqa: E402
import server  # noqa: E402

SERVICE = "nightdrive-localsend.service"
# The unit in the plugin's folder: enabled by its path, which links it again after a disable (systemctl disable removes
# a linked unit's link too)
UNIT = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "systemd", SERVICE)
OFF = os.path.expanduser("~/.local/state/nightdrive/plugins-off/localsend")   # nightdrive plugins off localsend


def systemctl(*a):
    return subprocess.run(["systemctl", "--user", *a], capture_output=True, text=True)


def status():
    """on, or off and why. `nightdrive plugins off localsend` stops the unit but leaves it enabled (its installed test), so
    enabled alone isn't on: the server has to be running too."""
    if os.path.exists(OFF):
        return "off (turned off: nightdrive plugins on localsend)"
    if systemctl("is-enabled", "-q", SERVICE).returncode:
        return "off"
    if systemctl("is-active", "-q", SERVICE).returncode:
        return "off (not running: localsend enable starts it)"
    return "on"


def main():
    a = sys.argv[1:]
    cmd = a[0] if a else "status"
    if cmd == "status":
        print(status())
    elif cmd == "enable":
        if not shutil.which("openssl"):
            print("openssl is needed for the certificate", file=sys.stderr)
            return 1
        common.certificate()
        systemctl("daemon-reload")
        res = systemctl("enable", "--now", UNIT)
        if res.returncode:
            print(res.stderr.strip(), file=sys.stderr)
            return 1
    elif cmd == "disable":
        systemctl("disable", "--now", SERVICE)
    elif cmd == "run":
        server.run()
    elif cmd == "devices":
        print(json.dumps(sender.discover(), ensure_ascii=False))
    elif cmd == "forget":
        sender.forget()
    elif cmd == "send" and len(a) > 1:
        return sender.send_files(a[1:], status())
    elif cmd == "send-clipboard":
        return sender.send_clipboard(status())
    elif cmd == "send-pick":
        return sender.send_pick(status())
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
