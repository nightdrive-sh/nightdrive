#!/bin/bash
# nightmail: open Nightdrive Mail and look after it (plugins/mail, README.md).
set -u

APP_DIR=$(dirname "$(dirname "$(readlink -f "$0")")")   # the plugin's folder
QS_DIR=$APP_DIR/app                                     # Mail's own Quickshell config, apart from the desktop's shell
SYNC_UNIT=nightdrive-mail-sync.service                  # fetches and indexes mail (systemd/, `nightmail enable`)
PUSH_UNIT=nightdrive-mail-push.service                  # runs the sync as soon as mail comes (IMAP IDLE)
FETCH_LOCK=${XDG_RUNTIME_DIR:-/run/user/$UID}/nightdrive/mail-fetch.lock

# `qs list` and `qs ipc` only find a Quickshell with the same QT_QPA_PLATFORM as theirs (Hyprland sets it, hyprland.lua).
# A notification's buttons (lib/notify.py, run by systemd-run) and the sync's service get the user manager's environment,
# which lacks it: without it they didn't see the open Mail, so a notification's Delete left the row until Mail's own
# 30 s reload, and Open would start a second Mail.
export QT_QPA_PLATFORM=${QT_QPA_PLATFORM:-wayland;xcb}

# The window: started, brought forward, waited for and stopped by the apps' kit (app/kit/app.sh)
APP_TITLE=Mail
APP_IPC=mail
. "$QS_DIR/kit/app.sh"

# Puts Mail among the desktop's apps (share/nightmail.desktop); link.sh has put `nightmail` in ~/.local/bin.
install_app() {
  local data=${XDG_DATA_HOME:-$HOME/.local/share}
  local bin=$HOME/.local/bin apps=$data/applications icons=$data/icons/hicolor/scalable/apps
  mkdir -p "$apps" "$icons"
  cp "$APP_DIR/share/nightmail.svg" "$icons/nightmail.svg"
  sed "s|^Exec=nightmail|Exec=$bin/nightmail|" "$APP_DIR/share/nightmail.desktop" > "$apps/nightmail.desktop"
  install_hook
  command -v update-desktop-database >/dev/null && update-desktop-database "$apps" 2>/dev/null
  echo "Installed: $apps/nightmail.desktop"
}

# Notifications of new mail come from notmuch's post-new hook, so they arrive with Mail closed too. A hook of
# your own stays: then it is up to you to run `nightmail notify` from it.
HOOK_MARK="# nightmail: notifications of new mail"
hook_path() {
  local dir
  dir=$(notmuch config get database.hook_dir 2>/dev/null)
  [[ -n $dir ]] || return 1
  echo "$dir/post-new"
}
install_hook() {
  local hook
  hook=$(hook_path) || { echo "No notmuch database: no notifications of new mail." >&2; return 0; }
  if [[ -e $hook ]] && ! grep -qF "$HOOK_MARK" "$hook"; then
    echo "$hook is your own: add \`$APP_DIR/bin/nightmail notify\` to it for notifications of new mail." >&2
    return 0
  fi
  mkdir -p "$(dirname "$hook")"
  printf '#!/bin/sh\n%s\nexec "%s" notify\n' "$HOOK_MARK" "$APP_DIR/bin/nightmail" > "$hook"
  chmod +x "$hook"
  # What is in the inbox now is not new: tag it, so the first sync after this announces nothing old.
  notmuch tag +notified -- 'folder:/INBOX$/ and tag:inbox and tag:unread and not tag:notified' 2>/dev/null
}

uninstall_app() {
  local hook
  hook=$(hook_path) && [[ -e $hook ]] && grep -qF "$HOOK_MARK" "$hook" && rm -f "$hook"
  local data=${XDG_DATA_HOME:-$HOME/.local/share}
  rm -f "$data/applications/nightmail.desktop" "$data/icons/hicolor/scalable/apps/nightmail.svg"
  echo "Removed Mail's desktop entry and notifications."
}

# The sync's units in the plugin's folder, enabled by their path: that links them again after a disable (systemctl
# disable removes a linked unit's link too).
enable() {
  install_app
  systemctl --user link "$APP_DIR/systemd/$SYNC_UNIT" >/dev/null
  systemctl --user enable --now "$APP_DIR/systemd/${SYNC_UNIT%.service}.timer"
  # Without an account yet its condition keeps it from starting: the setup's `nightmail enable` starts it, and restarts
  # it to read a changed isyncrc
  systemctl --user enable "$APP_DIR/systemd/$PUSH_UNIT"
  systemctl --user restart "$PUSH_UNIT"
}
disable() {
  systemctl --user disable --now "${SYNC_UNIT%.service}.timer" 2>/dev/null
  systemctl --user disable --now "$PUSH_UNIT" 2>/dev/null
  uninstall_app
}

# Setting up an account with Claude (Mail's first start offers it, and so does Welcome to Nightdrive): Claude Code in a
# terminal goes through README.md › Setting up an account with you, held to that by claude-setup. The password goes in by
# a command you run yourself (! secret-tool …), so it never passes through Claude.
setup() {
  local prompt="Set up my email account for Nightdrive Mail, by the steps in $APP_DIR/README.md, section \"Setting up an account\" \
(and \"More accounts\" for the ones after it). Read it first, then go through it with me one step at a time, saying in plain \
words what each step is for: I may not know mbsync or notmuch. Mail's plugin is installed, so step 1 is only the app password, \
if my provider needs one. Start by asking my email address and name, then work out the servers and folder names yourself \
(\`mbsync -l CHANNEL\` lists the server's folders). Never ask me to type a password into this chat: for step 2, give me the \
secret-tool command to run myself with ! in front of it, which asks for the password in the terminal. If ~/.config/isyncrc, \
notmuch's config or ~/.config/nightmail/account.conf is already there, add to it instead of replacing it. The first mbsync of a \
big mailbox can take long: run it in the background and tell me how it goes. Finish with \`nightmail enable\`, \
\`nightmail restart\` and step 8's check. Once that account works, ask whether I want to add another one: if so, set it up the \
same way by \"More accounts\", and ask again after each."
  "$HOME/.config/hypr/scripts/claude-setup" mail Mail <<<"$prompt"
}

# The timer's full round and push's inbox-only one wait here for each other: two mbsyncs on the same folders would
# fail on its locks, and notmuch on its database's. Mail's spinner watches the same lock (app/FetchWatch.qml): once it
# is taken, `nightmail fetching` tells an open Mail, in the background so the fetch doesn't wait for it. -o: only flock
# holds the lock, not the commands, so that call can't keep it after the fetch.
fetch() {
  mkdir -p "$(dirname "$FETCH_LOCK")"
  (($#)) || set -- -a
  flock -o "$FETCH_LOCK" sh -c '"$0" fetching >/dev/null 2>&1 & mbsync -q "$@" && notmuch new --quiet' \
    "$APP_DIR/bin/nightmail" "$@"
}

# Claude's reply shows in the desktop's Claude writes card (quickshell/ClaudeWrite.qml, `qs ipc call write ask`), which
# runs claude-draft for the text and, on Enter, claude-reply to hand it back to Mail. The request (request.json: gen,
# msgid, account, hint, thread, sent, accept) and the answer stay in a folder only you can read.
CLAUDE_DIR=${XDG_RUNTIME_DIR:-/run/user/$UID}/nightdrive/mail-claude

# ask-claude TITLE REQUEST: the card opens in the middle of the window titled TITLE (the writing window)
ask_claude() {
  local title=$1 win
  rm -rf "$CLAUDE_DIR"; mkdir -p -m 700 "$CLAUDE_DIR"
  printf '%s' "$2" >"$CLAUDE_DIR/request.json"
  # The window's place and size on the desktop, or the active window's while it isn't mapped yet
  local box='{ x: .at[0], y: .at[1], w: .size[0], h: .size[1] }'
  win=$(hyprctl -j clients 2>/dev/null | jq -c --argjson pid "$(pid)" --arg t "$title" \
          "[.[] | select(.pid == \$pid and .title == \$t)] | first | if . then $box else empty end")
  [[ -z $win ]] && win=$(hyprctl -j activewindow 2>/dev/null | jq -c "if .at then $box else {} end")
  [[ -z $win ]] && win='{}'
  local self=$APP_DIR/bin/nightmail
  # The card runs the draft in the desktop shell's environment, not Mail's: a Mail started with a notmuch database or
  # a config folder of its own (NOTMUCH_CONFIG, XDG_CONFIG_HOME) passes them on, or Claude would read the wrong thread
  jq -n --argjson win "$win" --slurpfile r "$CLAUDE_DIR/request.json" --arg self "$self" --arg dir "$CLAUDE_DIR" \
        --arg nm "${NOTMUCH_CONFIG:-}" --arg xc "${XDG_CONFIG_HOME:-}" \
     '([(if $nm != "" then "NOTMUCH_CONFIG=\($nm)" else empty end), (if $xc != "" then "XDG_CONFIG_HOME=\($xc)" else empty end)]
        | if length > 0 then ["env"] + . else [] end) as $env
      | { window: $win, sent: $r[0].sent, accept: $r[0].accept, chars: 0,
          draft: ($env + [$self, "claude-draft", $dir]), reply: [$self, "claude-reply", $dir], cancel: [$self, "claude-cancel", $dir] }' \
     >"$CLAUDE_DIR/meta.json"
  qs ipc call write ask "$CLAUDE_DIR" >/dev/null 2>&1 || echo '{"error": "The Claude card did not open (is the desktop shell running?)"}'
}

# The card's draft: compose.py's reply ({text, read}), with the line saying what Claude read
claude_draft() {
  local dir=$1 out
  local -a args
  if [[ $(jq -r .thread "$dir/request.json") == true ]]; then
    args=(suggest "$(jq -r .msgid "$dir/request.json")")
    [[ -n $(jq -r .hint "$dir/request.json") ]] && args+=("$(jq -r .hint "$dir/request.json")")
  else
    args=(write "$(jq -r .hint "$dir/request.json")" "$(jq -r '.account // ""' "$dir/request.json")")
  fi
  out=$(python3 "$APP_DIR/lib/compose.py" "${args[@]}")
  printf '%s' "$out" >"$dir/answer.json"
  jq -c --slurpfile r "$dir/request.json" '
    if .error then { error } else
      { text, sent: (if $r[0].thread then "the thread (\(.read) message\(if .read == 1 then "" else "s" end))"
                       + (if $r[0].hint != "" then " and your draft: \($r[0].hint)" else "" end) else $r[0].hint end) }
    end' <<<"$out" 2>/dev/null || jq -n --arg e "$out" '{ error: ($e | if . == "" then "No answer from compose.py" else . end) }'
}

# The card's Enter (dir/result is the text) and Esc, back to Mail
claude_reply() {
  local dir=$1 json
  json=$(jq -c --rawfile t "$dir/result" --slurpfile a "$dir/answer.json" '{ gen, text: $t, read: ($a[0].read // 0) }' "$dir/request.json")
  running && ipc claudeAnswer "$json"
}
claude_cancel() {
  running && ipc claudeCancel "$(jq -r .gen "$1/request.json")"
}

# Started for a new message (new, mailto:), Mail shows only the writing window (app/shell.qml, visible). The commands that
# open the main window show it over IPC then: the kit's focus() wouldn't find it, and would start Mail again.
compose_only() { NIGHTMAIL_COMPOSE_ONLY=1 start; }
reveal() { running && [[ $(qs ipc -p "$QS_DIR" call "$APP_IPC" reveal 2>/dev/null) == shown ]]; }

usage() {
  cat <<USAGE
Usage: nightmail [command]

  (none), open   open Mail, or bring it forward if it is open
  new            write a new message
  settings       open Mail's settings (launcher › Settings › Apps › Mail)
  mailto:…       write to a mailto: link's address (the desktop entry's handler for mailto links)
  setup          set up an email account with Claude, in a terminal
  sync           fetch new mail now and show it
  sync CHANNEL…  the same for only these mbsync channels (or channel:box, e.g. an inbox)
  fetch [CHANNEL…]  mbsync and notmuch new, one fetch at a time (the sync's service runs it)
  restart        close and open again (after a change to the app)
  quit           close Mail
  log            follow the app's log (QML errors show up here)
  show ID        open Mail on a message (notmuch message id)
  reply ID       open Mail on a message and reply to it
  claude ID      the same, with Claude writing the reply
  archive ID…    archive from the inbox, as Mail's a does (ID: a message id, or thread:… for a thread)
  unarchive ID…  back to the inbox
  delete ID…     move from the inbox to Trash, as Mail's d does
  empty Spam|Trash [--account ID|ADDRESS]  delete everything in Spam or Trash for good, as Mail's ⌘⇧⌫ does (no
                 undo; --card only shows what it would delete)
  search QUERY [LIMIT]  threads a notmuch query finds, as JSON (newest first, 20 by default)
  unread [LIMIT] the unread threads in the inboxes, as JSON
  thread ID      a thread's messages as JSON text (ID: thread:… or a message id)
  invitation ID  a message's calendar invitation, by Calendar, as JSON; --add CALENDAR puts its event in one (or
                 updates it there), --remove takes a cancelled one out
  accounts       the accounts, as JSON
  draft          save a draft from JSON on stdin ({to, cc, subject, body, account} or {reply_to, reply_all, body})
  draft-show ID  a draft as it would be sent, as JSON
  discard ID     throw a draft away
  send ID        send a draft, through the account's SMTP server
  notify         notify of new mail (notmuch's post-new hook runs it)
  blocked-notifications  which of Mail's notifications (JSON on stdin) are of mail Access › Mail keeps from Claude
  keyring-locked exit 0 if the login keyring is locked (the sync skips its round then)
  push           sync as soon as new mail comes to an inbox (IMAP IDLE; its service runs it)
  enable         Mail among the desktop's apps, its notifications and the sync every 5 minutes (the installer)
  disable        take them away again (your mail and settings stay)
  help           this text
USAGE
}

case ${1:-open} in
  new)     running || { compose_only; ready; }; ipc compose ;;
  mailto:*) running || { compose_only; ready; }; ipc mailto "$1" ;;
  open)     reveal || open_window ;;
  settings) reveal || open_ready; ipc openSettings ;;
  sync)
    if (($# > 1)); then
      fetch "${@:2}"
    elif systemctl --user cat "$SYNC_UNIT" >/dev/null 2>&1; then
      systemctl --user start "$SYNC_UNIT"
    else
      notmuch new --quiet
    fi
    status=$?
    running && ipc refresh
    exit $status
    ;;
  show|reply|claude)
    [[ -n ${2:-} ]] || { usage >&2; exit 2; }
    reveal || open_ready
    case $1 in show) fn=openMessage ;; reply) fn=replyTo ;; claude) fn=claudeReply ;; esac
    ipc "$fn" "$2"
    ;;
  archive|unarchive|delete)
    # The same moves as Mail's a and d: from the inbox to Archive or Trash (lib/inbox.py, move.py's)
    [[ -n ${2:-} ]] || { usage >&2; exit 2; }
    python3 "$APP_DIR/lib/inbox.py" "$@"; status=$?
    running && ipc refresh
    exit $status
    ;;
  empty)
    # Mail's ⌘⇧⌫ without the window (lib/empty.py): the list shows the folder emptied at once
    python3 "$APP_DIR/lib/empty.py" "${@:2}"; status=$?
    running && ipc refresh
    exit $status
    ;;
  search|unread|thread)
    python3 "$APP_DIR/lib/browse.py" "$@" ;;
  accounts)
    python3 "$APP_DIR/lib/compose.py" accounts ;;
  invitation) python3 "$APP_DIR/lib/invitation.py" "${@:2}" ;;
  draft|discard|send)
    # The window shows a new draft, and a draft gone, at once
    python3 "$APP_DIR/lib/drafts.py" "$@"; status=$?
    running && ipc refresh
    exit $status
    ;;
  draft-show)
    python3 "$APP_DIR/lib/drafts.py" show "${@:2}" ;;
  draft-card)   # mail_send's card: what goes out that Claude saw hidden
    python3 "$APP_DIR/lib/drafts.py" card "${@:2}" ;;
  notify)    python3 "$APP_DIR/lib/notify.py" ;;
  blocked-notifications) python3 "$APP_DIR/lib/blocked.py" notifications ;;   # `nightdrive notifications` for Claude
  fetch)     fetch "${@:2}" ;;
  fetching)  running && ipc fetching ;;     # fetch()'s, for Mail's spinner
  keyring-locked) python3 "$APP_DIR/lib/keyring.py" ;;
  push)      exec python3 "$APP_DIR/lib/push.py" ;;
  ask-claude)    ask_claude "$2" "$3" ;;   # Mail's ⌘⇧C (the commands below are the card's)
  claude-draft)  claude_draft "$2" ;;
  claude-reply)  claude_reply "$2" ;;
  claude-cancel) claude_cancel "$2" ;;
  setup)     setup ;;
  enable)    enable ;;
  disable)   disable ;;
  help|-h|--help) usage ;;
  *)
    app_command "$@"; status=$?        # open (the default), settings, restart, quit, log
    ((status == 2)) && { usage >&2; exit 2; }
    exit $status
    ;;
esac
