#!/bin/bash
# tasks: Nightdrive Tasks, the tasks kept as VTODO files on this computer (plugins/tasks, README.md): the window, the
# commands Claude's tools run (mcp.json), and the notifications of tasks that come due.
set -u

APP_DIR=$(dirname "$(dirname "$(readlink -f "$0")")")   # the plugin's folder
DUE_TIMER=nightdrive-tasks-due.timer                    # systemd/: due tasks' notifications, every minute
QS_DIR=$APP_DIR/app                                     # Tasks' own Quickshell config, apart from the desktop's shell

APP_TITLE=Tasks
APP_IPC=tasks
. "$QS_DIR/kit/app.sh"

cli() { python3 "$APP_DIR/lib/cli.py" "$@"; }

# A change shows in the open window at once (its own timer reads the files again each minute too)
change() {
  cli "$@"; local status=$?
  ((status == 0)) && running && ipc refresh
  return $status
}

# Puts Tasks among the desktop's apps (share/tasks.desktop); link.sh has put `tasks` in ~/.local/bin.
install_app() {
  local data=${XDG_DATA_HOME:-$HOME/.local/share}
  local apps=$data/applications icons=$data/icons/hicolor/scalable/apps
  mkdir -p "$apps" "$icons"
  cp "$APP_DIR/share/tasks.svg" "$icons/nightdrive-tasks.svg"
  sed "s|^Exec=tasks|Exec=$HOME/.local/bin/tasks|" "$APP_DIR/share/tasks.desktop" > "$apps/nightdrive-tasks.desktop"
  command -v update-desktop-database >/dev/null && update-desktop-database "$apps" 2>/dev/null
  echo "Installed: $apps/nightdrive-tasks.desktop"
}

enable() {
  install_app
  systemctl --user link "$APP_DIR/systemd/${DUE_TIMER%.timer}.service" >/dev/null
  systemctl --user enable --now "$APP_DIR/systemd/$DUE_TIMER"
}
disable() {
  systemctl --user disable --now "$DUE_TIMER" 2>/dev/null
  local data=${XDG_DATA_HOME:-$HOME/.local/share}
  rm -f "$data/applications/nightdrive-tasks.desktop" "$data/icons/hicolor/scalable/apps/nightdrive-tasks.svg"
  echo "Due tasks aren't notified any more. Your tasks stay in ${XDG_DATA_HOME:-$HOME/.local/share}/nightdrive/tasks."
}

usage() {
  cat <<USAGE
Usage: tasks [command]

  (none), open   open Tasks, or bring it forward if it is open
  new [LIST]     open Tasks with a new task in LIST (its name; the list it shows, or the one used last, without one)
  search [WORDS] open Tasks with the search over every list (WORDS in a task's title or note)
  lists          the lists and how many open tasks each has (--json)
  when WHEN      how a due reads ("fri 930": Fri 6 Nov 09:30)
  list           the open tasks (--json; --list NAME; --view today|upcoming|done|all; --query TEXT)
  add TITLE      a new task (--list NAME, a new list if there is none; --due WHEN; --note TEXT; --priority high|low)
  edit ID        change a task (--title T; --due WHEN or --no-due; --note TEXT; --list NAME, moves it; --priority P)
  done ID        mark a task done (ID: from list, or the start of one)
  undone ID      back among the open ones (a task done)
  snooze ID      move a task on: an hour, or a day without a time (--until WHEN for another time)
  trash ID       move a task to the trash
  restore UNDO   undo a change: UNDO is the id a change's --json gives
  list-new NAME          a new list
  list-rename LIST NAME  give a list another name (LIST: its name or id)
  list-remove LIST       remove a list (--with-tasks: its tasks go to the trash with it, else one with tasks stays)
  due            notify the tasks that have come due (the timer runs it every minute)
  enable         Tasks among the desktop's apps, and its notifications on (the installer)
  disable        take them away again (your tasks stay)
  restart, quit, log
  help           this text

WHEN: [DAY] [TIME]. DAY: today, tomorrow, mon … sun (the next one), 5.11., 5.11.2027, 2026-11-05, +3d.
TIME: 9:30, 930, 14 (alone: the next such time). Or +30m, +2h.
USAGE
}

case ${1:-open} in
  new)        open_ready; ipc newTask "${2:-}" ;;
  search)     open_ready; shift; ipc search "$*" ;;
  lists|list|when) cli "$@" ;;
  add|edit|done|undone|snooze|trash|restore|list-new|list-rename|list-remove) change "$@" ;;
  due)        python3 "$APP_DIR/lib/due.py" check ;;
  enable)     enable ;;
  disable)    disable ;;
  help|-h|--help) usage ;;
  *)
    app_command "$@"; status=$?        # open (the default), restart, quit, log
    ((status == 2)) && { usage >&2; exit 2; }
    exit $status
    ;;
esac
